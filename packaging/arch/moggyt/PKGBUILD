# Maintainer: kveld9 <https://github.com/kveld9/moggyt>
#
# moggyt builds the client from the tagged source archive.
# Bump policy: set pkgver, reset pkgrel to 1, refresh the hashes with `updpkgsums`.
#
# Last.fm scrobbling needs the build-time API credentials that upstream CI injects.
# Export MOGGYT_LASTFM_API_KEY and MOGGYT_LASTFM_SECRET before running makepkg to
# enable it; without them the build succeeds with Last.fm support disabled.
#
# No check() function: upstream CI runs the full test suite, and a second
# test-profile build roughly doubles the build time for this package.

pkgname=moggyt
pkgver=1.4.0
pkgrel=1
pkgdesc="Native YouTube Music client (Slint)"
arch=('x86_64')
url="https://github.com/kveld9/moggyt"
license=('MIT')
depends=('alsa-lib' 'libayatana-appindicator')
makedepends=('cargo' 'cmake' 'pkgconf' 'rust')
conflicts=('moggyt-bin')
# The global makepkg `lto` option compiles ring's C sources as LTO bitcode, which
# rust-lld cannot resolve at link time. The Rust release profile keeps its own
# thin LTO, so opt out of the makepkg-applied flags.
options=('!lto')
_icons=(16 32 48 64 128 256)
source=("$pkgname-$pkgver.tar.gz::https://github.com/kveld9/moggyt/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('5b6839317266463653a4464566f19134b1abab35f35c4b626d916369c4c21e68')

prepare() {
  cd "$pkgname-$pkgver"
  cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
  cd "$pkgname-$pkgver"
  cargo build --release --frozen
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/moggyt "$pkgdir/usr/bin/moggyt"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 THIRD_PARTY_NOTICES.md \
    "$pkgdir/usr/share/licenses/$pkgname/THIRD_PARTY_NOTICES.md"
  install -Dm644 packaging/linux/moggyt.desktop \
    "$pkgdir/usr/share/applications/moggyt.desktop"
  install -Dm644 packaging/matugen/moggyt-theme.json \
    "$pkgdir/usr/share/moggyt/matugen/moggyt-theme.json"

  local size
  for size in "${_icons[@]}"; do
    install -Dm644 "packaging/icons/hicolor/${size}x${size}/apps/moggyt.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/moggyt.png"
  done
}
