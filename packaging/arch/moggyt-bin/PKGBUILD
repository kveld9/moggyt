# Maintainer: kveld9 <https://github.com/kveld9/moggyt>
#
# moggyt-bin repackages the official release tarball for Arch Linux.
# Bump policy: set pkgver, reset pkgrel to 1, refresh the hashes with `updpkgsums`.
#
# The release tarball carries the binary and third-party notices only. The desktop
# entry, launcher icons, Matugen template, and license come from the matching source
# archive, so both URLs are derived from pkgver and no commit pin is needed.
# Once a release ships the full payload in the tarball, delete the source-archive
# entry, its hash, and the `_repo` prefix below.

pkgname=moggyt-bin
pkgver=1.4.0
pkgrel=1
pkgdesc="Native YouTube Music client (Slint)"
arch=('x86_64')
url="https://github.com/kveld9/moggyt"
license=('MIT')
depends=('alsa-lib' 'libayatana-appindicator')
provides=('moggyt')
conflicts=('moggyt')
_icons=(16 32 48 64 128 256)
_repo="$pkgname-$pkgver.tar.gz"
source=(
  "https://github.com/kveld9/moggyt/releases/download/v${pkgver}/moggyt-${pkgver}-linux.tar.gz"
  "$_repo::https://github.com/kveld9/moggyt/archive/refs/tags/v${pkgver}.tar.gz"
)
sha256sums=(
  '511214c890a079fac66fb31aab3b944886689e117fdf3229d71cefed431831bb'
  '5b6839317266463653a4464566f19134b1abab35f35c4b626d916369c4c21e68'
)

package() {
  local src="${srcdir}/moggyt-${pkgver}"
  install -Dm755 "${srcdir}/moggyt" "${pkgdir}/usr/bin/moggyt"
  install -Dm644 "${srcdir}/THIRD_PARTY_NOTICES.md" \
    "${pkgdir}/usr/share/licenses/${pkgname}/THIRD_PARTY_NOTICES.md"
  install -Dm644 "${src}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 "${src}/packaging/linux/moggyt.desktop" \
    "${pkgdir}/usr/share/applications/moggyt.desktop"
  install -Dm644 "${src}/packaging/matugen/moggyt-theme.json" \
    "${pkgdir}/usr/share/moggyt/matugen/moggyt-theme.json"

  local size
  for size in "${_icons[@]}"; do
    install -Dm644 "${src}/packaging/icons/hicolor/${size}x${size}/apps/moggyt.png" \
      "${pkgdir}/usr/share/icons/hicolor/${size}x${size}/apps/moggyt.png"
  done
}
