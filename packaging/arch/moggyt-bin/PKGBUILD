# Maintainer: kveld9 <https://github.com/kveld9/moggyt>
#
# moggyt-bin repackages the official release tarball for Arch Linux.
# Bump policy: update pkgver, run updpkgsums, regenerate .SRCINFO via:
#   makepkg --printsrcinfo > .SRCINFO
# AUR submission deferred until release stabilization.

pkgname=moggyt-bin
pkgver=1.3.0
pkgrel=1
pkgdesc="Native YouTube Music client (Slint)"
arch=('x86_64')
url="https://github.com/kveld9/moggyt"
license=('MIT')
depends=('alsa-lib' 'libayatana-appindicator')
provides=('moggyt')
conflicts=('moggyt')
source=(
  "https://github.com/kveld9/moggyt/releases/download/v${pkgver}/moggyt-${pkgver}-linux.tar.gz"
  "moggyt.desktop"
  "moggyt-theme.json::https://raw.githubusercontent.com/kveld9/moggyt/v${pkgver}/packaging/matugen/moggyt-theme.json"
)
sha256sums=(
  'e245274e5c5c2364248c94d4d61988df63d89a21472860fc528196b878a76611'
  '3bada013e5a76268ff9f1f60face3240dfa14e57de1509b0230cc71615de28db'
  '0e9ed656921ad7dccedd817b63c2458767806ddbe128bb61fa543ab0b1079336'
)

package() {
  install -Dm755 "${srcdir}/moggyt" "${pkgdir}/usr/bin/moggyt"
  install -Dm644 "${srcdir}/moggyt.desktop" "${pkgdir}/usr/share/applications/moggyt.desktop"
  install -Dm644 "${srcdir}/moggyt-theme.json" \
    "${pkgdir}/usr/share/moggyt/matugen/moggyt-theme.json"

  # Release tarballs from the next version onward include the third-party notices.
  if [ -f "${srcdir}/THIRD_PARTY_NOTICES.md" ]; then
    install -Dm644 "${srcdir}/THIRD_PARTY_NOTICES.md" \
      "${pkgdir}/usr/share/licenses/${pkgname}/THIRD_PARTY_NOTICES.md"
  fi
}
