#!/usr/bin/env bash
# Git pre-push hook: full CI-equivalent gate before any push.
# Blocks the push when any gate fails. Bypass only in emergencies with:
#   git push --no-verify
# Activate with:
#   git config core.hooksPath .githooks
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

echo "Pre-push gate: cargo fmt..."
cargo fmt --all -- --check

echo "Pre-push gate: clippy..."
cargo clippy --all-targets --all-features -- -D warnings

echo "Pre-push gate: tests..."
cargo test --all-features

echo "Pre-push gate: repository standards..."
if [ -x "./scripts/check-repo.sh" ]; then
  ./scripts/check-repo.sh
else
  bash ./scripts/check-repo.sh
fi

echo "Pre-push gate: markdown..."
if [ -x "./scripts/check-markdown.sh" ]; then
  ./scripts/check-markdown.sh
else
  bash ./scripts/check-markdown.sh
fi

echo "Pre-push gate: all green."
