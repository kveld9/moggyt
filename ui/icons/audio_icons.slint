import { Theme } from "../theme.slint";

export component IconSpeaker inherits Rectangle {
    in property <color> tint: Theme.text;
    in property <length> size: 20px;
    width: root.size;
    height: root.size;

    Path {
        width: root.size;
        height: root.size;
        viewbox-x: 0; viewbox-y: 0; viewbox-width: 24; viewbox-height: 24;
        stroke: root.tint;
        stroke-width: 1.8px;
        fill: root.tint;
        commands: "M 4 9.5 L 8 9.5 L 13 5.5 L 13 18.5 L 8 14.5 L 4 14.5 Z";
    }

    Path {
        width: root.size;
        height: root.size;
        viewbox-x: 0; viewbox-y: 0; viewbox-width: 24; viewbox-height: 24;
        stroke: root.tint;
        stroke-width: 1.8px;
        fill: transparent;
        commands: "M 16 9 A 4.5 4.5 0 0 1 16 15 M 19 6.5 A 8 8 0 0 1 19 17.5";
    }
}

