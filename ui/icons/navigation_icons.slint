import { Theme } from "../theme.slint";

export component IconSettings inherits Rectangle {
    in property <color> tint: Theme.text;
    in property <length> size: 20px;
    width: root.size;
    height: root.size;

    Path {
        width: root.size;
        height: root.size;
        viewbox-x: 0; viewbox-y: 0; viewbox-width: 24; viewbox-height: 24;
        stroke: root.tint;
        stroke-width: 1.8px;
        fill: transparent;
        commands: "M 9 12 A 3 3 0 1 0 15 12 A 3 3 0 1 0 9 12 M 5.5 12 A 6.5 6.5 0 1 0 18.5 12 A 6.5 6.5 0 1 0 5.5 12 M 12 2.5 L 12 5.5 M 12 18.5 L 12 21.5 M 2.5 12 L 5.5 12 M 18.5 12 L 21.5 12 M 5.3 5.3 L 7.4 7.4 M 16.6 16.6 L 18.7 18.7 M 18.7 5.3 L 16.6 7.4 M 7.4 16.6 L 5.3 18.7";
    }
}

