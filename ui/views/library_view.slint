import { Theme, LibraryItemData } from "../theme.slint";
import { StyledInputField } from "../components/controls.slint";
import { LibraryItemCard } from "../components/rows.slint";

export component LibraryView inherits VerticalLayout {
    in-out property <string> cookie-text: "";
    in property <bool> signed-in: false;
    in property <[LibraryItemData]> playlists: [];
    in property <[LibraryItemData]> albums: [];
    in property <[LibraryItemData]> artists: [];
    in property <string> session-anonymous-hint: "Anonymous session: paste cookies to unlock library";
    in property <string> session-cookie-placeholder: "Paste session cookies...";
    in property <string> sign-in-label: "Sign in";
    in property <string> session-signed-in-hint: "Signed in: library unlocked";
    in property <string> sign-out-label: "Sign out";
    in property <string> section-playlists-label: "Playlists";
    in property <string> empty-playlists-text: "No playlists found.";
    in property <string> section-albums-label: "Albums";
    in property <string> empty-albums-text: "No albums found.";
    in property <string> section-artists-label: "Artists";
    in property <string> empty-artists-text: "No artists found.";
    callback playlist-selected(int);
    callback album-selected(int);
    callback artist-selected(int);
    callback sign-in-submitted(string);
    callback sign-out();
    spacing: 16px;
    alignment: start;

    Rectangle {
        border-radius: 8px;
        background: Theme.panel;

        VerticalLayout {
            padding: 12px;
            spacing: 8px;

            if !root.signed-in : VerticalLayout {
                spacing: 8px;

                Text {
                    text: root.session-anonymous-hint;
                    color: Theme.secondary;
                    font-size: 13px;
                }

                HorizontalLayout {
                    spacing: 8px;
                    height: 32px;

                    StyledInputField {
                        text <=> root.cookie-text;
                        placeholder-text: root.session-cookie-placeholder;
                        input-type: InputType.password;
                        accepted(t) => { root.sign-in-submitted(t); }
                    }

                    Rectangle {
                        width: 90px;
                        border-radius: 8px;
                        background: sign-in-btn.pressed ? Theme.overlay : (sign-in-btn.has-hover ? Theme.hover : Theme.accent);
                        animate background { duration: 150ms; easing: ease-in-out; }

                        sign-in-btn := TouchArea {
                            clicked => { root.sign-in-submitted(root.cookie-text); }
                        }

                        Text {
                            text: root.sign-in-label;
                            color: sign-in-btn.has-hover ? Theme.text : Theme.window;
                            font-size: 12px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            if root.signed-in : HorizontalLayout {
                spacing: 12px;
                alignment: space-between;

                Text {
                    text: root.session-signed-in-hint;
                    color: Theme.accent;
                    font-size: 13px;
                    font-weight: 700;
                    vertical-alignment: center;
                }

                Rectangle {
                    width: 90px;
                    height: 32px;
                    border-radius: 8px;
                    background: sign-out-btn.pressed ? Theme.overlay : (sign-out-btn.has-hover ? Theme.hover : Theme.surface);
                    animate background { duration: 150ms; easing: ease-in-out; }

                    sign-out-btn := TouchArea {
                        clicked => { root.sign-out(); }
                    }

                    Text {
                        text: root.sign-out-label;
                        color: Theme.text;
                        font-size: 12px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    VerticalLayout {
        spacing: 6px;
        Text { text: root.section-playlists-label; color: Theme.text; font-size: 16px; font-weight: 700; }
        if root.playlists.length == 0 : Text { text: root.empty-playlists-text; color: Theme.secondary; font-size: 13px; }
        for item in root.playlists : LibraryItemCard { title: item.title; subtitle: item.subtitle; cover: item.cover; clicked => { root.playlist-selected(item.index); } }
    }

    VerticalLayout {
        spacing: 6px;
        Text { text: root.section-albums-label; color: Theme.text; font-size: 16px; font-weight: 700; }
        if root.albums.length == 0 : Text { text: root.empty-albums-text; color: Theme.secondary; font-size: 13px; }
        for item in root.albums : LibraryItemCard { title: item.title; subtitle: item.subtitle; cover: item.cover; clicked => { root.album-selected(item.index); } }
    }

    VerticalLayout {
        spacing: 6px;
        Text { text: root.section-artists-label; color: Theme.text; font-size: 16px; font-weight: 700; }
        if root.artists.length == 0 : Text { text: root.empty-artists-text; color: Theme.secondary; font-size: 13px; }
        for item in root.artists : LibraryItemCard { title: item.title; subtitle: item.subtitle; cover: item.cover; clicked => { root.artist-selected(item.index); } }
    }
}
