import { Labels } from "../labels.slint";
import { Theme, ExploreCardRow, TrackRowData } from "../theme.slint";
import { FilterChip } from "../components/controls.slint";
import { MediaCard } from "../components/cards.slint";
import { TrackRow } from "../components/rows.slint";
import { ContextSurface } from "../components/context_menu.slint";
import { IconLibrary, IconPlus } from "../icons.slint";
import { LibraryAddUi } from "../components/library_add.slint";

export component LibraryView inherits VerticalLayout {
    in property <bool> signed-in: false;
    in property <bool> session-expired: false;
    in property <int> active-filter: 0;
    in property <[ExploreCardRow]> playlist-rows: [];
    in property <[ExploreCardRow]> album-rows: [];
    in property <[ExploreCardRow]> artist-rows: [];
    in property <[TrackRowData]> song-rows: [];
    in property <[ExploreCardRow]> podcast-rows: [];
    in property <[ExploreCardRow]> profile-rows: [];
    callback playlist-selected(int);
    callback album-selected(int);
    callback artist-selected(int);
    callback song-selected(int);
    callback podcast-selected(int);
    callback profile-selected(int);
    callback chip-selected(int);
    callback open-settings();
    spacing: 16px;
    alignment: start;

    if !root.signed-in || root.session-expired : VerticalLayout {
        alignment: center;
        padding-top: 48px;
        padding-bottom: 48px;
        spacing: 16px;

        VerticalLayout {
            alignment: center;
            spacing: 12px;

            HorizontalLayout {
                alignment: center;

                IconLibrary {
                    size: 48px;
                    tint: Theme.secondary;
                }
            }

            Text {
                text: root.session-expired
                    ? Labels.library-session-expired-hint
                    : Labels.library-signed-out-hint;
                color: Theme.secondary;
                font-size: 14px;
                horizontal-alignment: center;
            }
        }

        HorizontalLayout {
            alignment: center;

            Rectangle {
                width: 140px;
                height: 36px;
                border-radius: 8px;
                background: settings-btn.pressed ? Theme.overlay : (settings-btn.has-hover ? Theme.hover : Theme.accent);
                animate background { duration: 150ms; easing: ease-in-out; }

                settings-btn := TouchArea {
                    clicked => { root.open-settings(); }
                }

                Text {
                    text: Labels.open-settings-label;
                    color: settings-btn.has-hover ? Theme.text : Theme.window;
                    font-size: 13px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }

    if root.signed-in && !root.session-expired : HorizontalLayout {
        spacing: 8px;
        alignment: start;

        add-pill := Rectangle {
            width: 28px;
            height: 28px;
            border-radius: 14px;
            background: add-touch.pressed ? Theme.overlay : (add-touch.has-hover ? Theme.hover : Theme.surface);
            animate background { duration: 150ms; easing: ease-in-out; }

            add-touch := TouchArea {
                accessible-role: button;
                accessible-label: Labels.new-playlist-label;
                mouse-cursor: pointer;
                clicked => {
                    LibraryAddUi.menu-x = add-pill.absolute-position.x;
                    LibraryAddUi.menu-y = add-pill.absolute-position.y;
                    LibraryAddUi.menu-open = true;
                }
            }

            IconPlus {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                size: 14px;
                tint: add-touch.has-hover ? Theme.accent : Theme.secondary;
            }
        }

        FilterChip {
            text: Labels.section-playlists-label;
            is-active: root.active-filter == 0;
            clicked => { root.chip-selected(0); }
        }

        FilterChip {
            text: Labels.filter-songs-label;
            is-active: root.active-filter == 1;
            clicked => { root.chip-selected(1); }
        }

        FilterChip {
            text: Labels.section-albums-label;
            is-active: root.active-filter == 2;
            clicked => { root.chip-selected(2); }
        }

        FilterChip {
            text: Labels.filter-artists-label;
            is-active: root.active-filter == 3;
            clicked => { root.chip-selected(3); }
        }

        FilterChip {
            text: Labels.filter-profiles-label;
            is-active: root.active-filter == 4;
            clicked => { root.chip-selected(4); }
        }

        FilterChip {
            text: Labels.filter-podcasts-label;
            is-active: root.active-filter == 5;
            clicked => { root.chip-selected(5); }
        }
    }

    if root.signed-in && !root.session-expired && root.active-filter == 0 : VerticalLayout {
        spacing: 6px;

        if root.playlist-rows.length == 0 : Text {
            text: Labels.empty-playlists-text;
            color: Theme.secondary;
            font-size: 13px;
        }

        for row in root.playlist-rows : HorizontalLayout {
            spacing: 12px;
            alignment: start;

            for card in row.cards : MediaCard {
                index: card.index;
                surface: ContextSurface.library-playlist;
                title: card.title;
                subtitle: card.subtitle;
                has-cover: card.has_cover;
                cover: card.cover;
                tile-color: card.tile_color;
                clicked => { root.playlist-selected(card.index); }
            }
        }
    }

    if root.signed-in && !root.session-expired && root.active-filter == 1 : VerticalLayout {
        spacing: 2px;

        if root.song-rows.length == 0 : Text {
            text: Labels.empty-liked-songs-text;
            color: Theme.secondary;
            font-size: 13px;
        }

        for row in root.song-rows : TrackRow {
            index: row.index;
            title: row.title;
            artist: row.artist;
            album: row.album;
            duration: row.duration;
            kind: row.kind;
            cover: row.cover;
            surface: ContextSurface.library-song;
            clicked => { root.song-selected(row.index); }
        }
    }

    if root.signed-in && !root.session-expired && root.active-filter == 2 : VerticalLayout {
        spacing: 6px;

        if root.album-rows.length == 0 : Text {
            text: Labels.empty-albums-text;
            color: Theme.secondary;
            font-size: 13px;
        }

        for row in root.album-rows : HorizontalLayout {
            spacing: 12px;
            alignment: start;

            for card in row.cards : MediaCard {
                index: card.index;
                surface: ContextSurface.library-album;
                title: card.title;
                subtitle: card.subtitle;
                has-cover: card.has_cover;
                cover: card.cover;
                tile-color: card.tile_color;
                clicked => { root.album-selected(card.index); }
            }
        }
    }
    if root.signed-in && !root.session-expired && root.active-filter == 3 : VerticalLayout {
        spacing: 6px;

        if root.artist-rows.length == 0 : Text {
            text: Labels.empty-artists-text;
            color: Theme.secondary;
            font-size: 13px;
        }

        for row in root.artist-rows : HorizontalLayout {
            spacing: 12px;
            alignment: start;

            for card in row.cards : MediaCard {
                index: card.index;
                surface: ContextSurface.library-artist;
                title: card.title;
                subtitle: card.subtitle;
                has-cover: card.has_cover;
                cover: card.cover;
                tile-color: card.tile_color;
                clicked => { root.artist-selected(card.index); }
            }
        }
    }

    if root.signed-in && !root.session-expired && root.active-filter == 5 : VerticalLayout {
        spacing: 6px;

        if root.podcast-rows.length == 0 : Text {
            text: Labels.empty-podcasts-text;
            color: Theme.secondary;
            font-size: 13px;
        }

        for row in root.podcast-rows : HorizontalLayout {
            spacing: 12px;
            alignment: start;

            for card in row.cards : MediaCard {
                index: card.index;
                surface: ContextSurface.library-podcast;
                title: card.title;
                subtitle: card.subtitle;
                has-cover: card.has_cover;
                cover: card.cover;
                tile-color: card.tile_color;
                clicked => { root.podcast-selected(card.index); }
            }
        }
    }

    if root.signed-in && !root.session-expired && root.active-filter == 4 : VerticalLayout {
        spacing: 6px;

        if root.profile-rows.length == 0 : Text {
            text: Labels.empty-profiles-text;
            color: Theme.secondary;
            font-size: 13px;
        }

        for row in root.profile-rows : HorizontalLayout {
            spacing: 12px;
            alignment: start;

            for card in row.cards : MediaCard {
                index: card.index;
                surface: ContextSurface.library-profile;
                title: card.title;
                subtitle: card.subtitle;
                has-cover: card.has_cover;
                cover: card.cover;
                tile-color: card.tile_color;
                clicked => { root.profile-selected(card.index); }
            }
        }
    }

}
