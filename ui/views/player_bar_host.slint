import { PlayerBar } from "../components/player_bar.slint";
import { PlayerBarUi } from "../theme.slint";

// Host that owns the classic/floating geometry of the bottom player bar.
//
// The host is a direct child of the Window and fills it, so the bar anchors itself to
// the host's bottom edge: a component root cannot read `parent`, but a child placed
// inside the host can. In classic mode the window layout reserves the bar height at the
// bottom; in floating mode the layout reserves nothing and the bar paints over the
// content column.
export component PlayerBarHost inherits Rectangle {
    in property <bool> show-artwork: true;
    in property <bool> show-like: true;
    in property <bool> show-shuffle: true;
    in property <bool> show-repeat: true;
    in property <bool> show-skip-seconds: false;
    in property <bool> show-queue: true;
    in property <bool> show-volume: true;
    in property <bool> show-timer: true;
    in property <bool> show-speed: true;
    in property <string> active-track-title: "";
    in property <string> active-track-artist: "";
    in property <image> cover;
    in property <int> queue-count: 0;
    in property <string> queue-button-text: "Queue";
    in property <bool> is-queue-open: false;
    callback toggle-queue-panel();

    background: transparent;

    PlayerBar {
        mode: PlayerBarUi.mode;
        show-artwork: root.show-artwork;
        show-like: root.show-like;
        show-shuffle: root.show-shuffle;
        show-repeat: root.show-repeat;
        show-skip-seconds: root.show-skip-seconds;
        show-queue: root.show-queue;
        show-volume: root.show-volume;
        show-timer: root.show-timer;
        show-speed: root.show-speed;
        width: PlayerBarUi.mode == 1 ? min(parent.width - 48px, PlayerBarUi.floating-width * 1px) : parent.width;
        height: 72px;
        x: (parent.width - self.width) / 2;
        // 20px gap under the floating bar; the classic bar stays flush with the edge.
        y: parent.height - self.height - (PlayerBarUi.mode == 1 ? 20px : 0px);
        active-track-title: root.active-track-title;
        active-track-artist: root.active-track-artist;
        cover: root.cover;
        queue-count: root.queue-count;
        queue-button-text: root.queue-button-text;
        is-queue-open: root.is-queue-open;
        toggle-queue-panel => { root.toggle-queue-panel(); }
    }
}
