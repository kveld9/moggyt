import { Labels } from "../labels.slint";
import { Theme, ShelfData } from "../theme.slint";
import { FilterChip } from "../components/controls.slint";
import { TrackRow } from "../components/rows.slint";
import { IconSearch, IconClose } from "../icons.slint";

export component SearchView inherits VerticalLayout {
    in-out property <string> query: "";
    in property <[ShelfData]> shelves: [];
    in property <int> active-filter: 0;
    in property <[string]> recent-searches: [];
    in property <bool> search-active: false;
    callback query-submitted(string);
    callback track-selected(int);
    callback filter-selected(int);
    callback recent-search-selected(string);
    callback recent-search-removed(string);
    callback recent-searches-cleared();
    forward-focus: input;

    spacing: 16px;
    alignment: start;

    HorizontalLayout {
        spacing: 8px;
        height: 36px;

        search-box := Rectangle {
            horizontal-stretch: 1;
            border-radius: 8px;
            border-width: 1px;
            border-color: input.has-focus ? Theme.accent : Theme.border;
            background: Theme.surface;
            animate border-color { duration: 150ms; easing: ease-in-out; }

            search-touch := TouchArea {
                clicked => { input.focus(); }
            }

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 8px;
                spacing: 8px;

                VerticalLayout {
                    alignment: center;
                    IconSearch {
                        size: 16px;
                        tint: input.has-focus ? Theme.accent : Theme.secondary;
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                    clip: true;

                    input := TextInput {
                        width: parent.width;
                        height: parent.height;
                        text <=> root.query;
                        color: Theme.text;
                        vertical-alignment: center;
                        accepted => {
                            root.query-submitted(self.text);
                        }
                    }

                    if root.query == "" && !input.has-focus : Text {
                        width: parent.width;
                        height: parent.height;
                        text: Labels.search-placeholder;
                        color: Theme.secondary;
                        vertical-alignment: center;

                        TouchArea {
                            clicked => { input.focus(); }
                        }
                    }
                }

                if root.query != "" : VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 20px;
                        height: 20px;
                        border-radius: 10px;
                        background: clear-touch.has-hover ? Theme.hover : transparent;

                        clear-touch := TouchArea {
                            clicked => {
                                root.query = "";
                                input.focus();
                            }
                        }

                        IconClose {
                            size: 10px;
                            tint: clear-touch.has-hover ? Theme.text : Theme.secondary;
                        }
                    }
                }
            }
        }

        Rectangle {
            width: 92px;
            border-radius: 8px;
            background: btn-touch.pressed ? Theme.overlay : (btn-touch.has-hover ? Theme.hover : Theme.accent);
            animate background { duration: 150ms; easing: ease-in-out; }

            btn-touch := TouchArea {
                clicked => { root.query-submitted(root.query); }
            }

            HorizontalLayout {
                alignment: center;
                spacing: 6px;

                VerticalLayout {
                    alignment: center;
                    IconSearch {
                        size: 16px;
                        tint: btn-touch.has-hover ? Theme.text : Theme.window;
                    }
                }

                Text {
                    text: Labels.search-button-label;
                    color: btn-touch.has-hover ? Theme.text : Theme.window;
                    font-size: 13px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
            }
        }
    }

    if root.search-active && root.query != "" : HorizontalLayout {
        spacing: 8px;
        alignment: start;

        FilterChip {
            text: Labels.filter-all-label;
            is-active: root.active-filter == 0;
            clicked => { root.filter-selected(0); }
        }
        FilterChip {
            text: Labels.filter-songs-label;
            is-active: root.active-filter == 1;
            clicked => { root.filter-selected(1); }
        }
        FilterChip {
            text: Labels.filter-albums-label;
            is-active: root.active-filter == 2;
            clicked => { root.filter-selected(2); }
        }
        FilterChip {
            text: Labels.filter-artists-label;
            is-active: root.active-filter == 3;
            clicked => { root.filter-selected(3); }
        }
        FilterChip {
            text: Labels.filter-playlists-label;
            is-active: root.active-filter == 4;
            clicked => { root.filter-selected(4); }
        }
    }

    if root.search-active && root.query != "" && root.shelves.length == 0 : VerticalLayout {
        padding-top: 24px;
        alignment: center;

        Text {
            text: Labels.search-empty-text;
            color: Theme.secondary;
            font-size: 14px;
            horizontal-alignment: center;
        }
    }

    if root.search-active && root.query != "" : VerticalLayout {
        spacing: 16px;
        alignment: start;

        for shelf in root.shelves : VerticalLayout {
            spacing: 8px;
            alignment: start;

            Text {
                text: shelf.title;
                color: Theme.text;
                font-size: 18px;
                font-weight: 700;
            }

            for track in shelf.tracks : TrackRow {
                title: track.title;
                artist: track.artist;
                album: track.album;
                duration: track.duration;
                kind: track.kind;
                cover: track.cover;
                clicked => {
                    root.track-selected(track.index);
                }
            }
        }
    }

    if !root.search-active || root.query == "" : VerticalLayout {
        spacing: 12px;
        alignment: start;

        Text {
            text: Labels.recent-title-label;
            color: Theme.text;
            font-size: 18px;
            font-weight: 700;
        }

        if root.recent-searches.length == 0 : VerticalLayout {
            padding-top: 12px;
            alignment: center;

            Text {
                text: Labels.recent-empty-label;
                color: Theme.secondary;
                font-size: 14px;
            }
        }

        for query-item in root.recent-searches : Rectangle {
            height: 36px;
            border-radius: 6px;
            background: row-touch.has-hover ? Theme.hover : transparent;
            animate background { duration: 150ms; easing: ease-in-out; }

            row-touch := TouchArea {
                clicked => { root.recent-search-selected(query-item); }
            }

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 8px;
                spacing: 8px;

                Text {
                    horizontal-stretch: 1;
                    text: query-item;
                    color: Theme.text;
                    font-size: 14px;
                    overflow: elide;
                    vertical-alignment: center;
                }

                VerticalLayout {
                    alignment: center;

                    Rectangle {
                        width: 24px;
                        height: 24px;
                        border-radius: 12px;
                        background: delete-touch.has-hover ? Theme.overlay : transparent;
                        animate background { duration: 150ms; easing: ease-in-out; }

                        delete-touch := TouchArea {
                            clicked => { root.recent-search-removed(query-item); }
                        }

                        IconClose {
                            size: 10px;
                            tint: delete-touch.has-hover ? Theme.text : Theme.secondary;
                        }
                    }
                }
            }
        }

        if root.recent-searches.length > 0 : HorizontalLayout {
            padding-top: 4px;

            Rectangle {
                border-radius: 6px;
                background: clear-btn-touch.has-hover ? Theme.hover : transparent;
                animate background { duration: 150ms; easing: ease-in-out; }

                clear-btn-touch := TouchArea {
                    clicked => { root.recent-searches-cleared(); }
                }

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    padding-top: 6px;
                    padding-bottom: 6px;

                    Text {
                        text: Labels.clear-history-label;
                        color: clear-btn-touch.has-hover ? Theme.accent : Theme.secondary;
                        font-size: 13px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
