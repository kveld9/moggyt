import { Theme, ShelfData } from "../theme.slint";
import { FilterChip } from "../components/controls.slint";
import { TrackRow } from "../components/rows.slint";
import { IconSearch, IconClose } from "../icons.slint";

export component SearchView inherits VerticalLayout {
    in-out property <string> query: "";
    in property <[ShelfData]> shelves: [];
    in property <int> active-filter: 0;
    in property <string> placeholder-text: "Search songs...";
    in property <string> search-button-label: "Search";
    in property <string> filter-all-label: "All";
    in property <string> filter-songs-label: "Songs";
    in property <string> filter-albums-label: "Albums";
    in property <string> filter-artists-label: "Artists";
    in property <string> filter-playlists-label: "Playlists";
    in property <string> empty-text: "No results found.";
    callback query-submitted(string);
    callback track-selected(int);
    callback filter-selected(int);
    forward-focus: input;

    spacing: 16px;
    alignment: start;

    HorizontalLayout {
        spacing: 8px;
        height: 36px;

        search-box := Rectangle {
            horizontal-stretch: 1;
            border-radius: 8px;
            border-width: 1px;
            border-color: input.has-focus ? Theme.accent : Theme.border;
            background: Theme.surface;
            animate border-color { duration: 150ms; easing: ease-in-out; }

            search-touch := TouchArea {
                clicked => { input.focus(); }
            }

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 8px;
                spacing: 8px;

                VerticalLayout {
                    alignment: center;
                    IconSearch {
                        size: 16px;
                        tint: input.has-focus ? Theme.accent : Theme.secondary;
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                    clip: true;

                    input := TextInput {
                        width: parent.width;
                        height: parent.height;
                        text <=> root.query;
                        color: Theme.text;
                        vertical-alignment: center;
                        accepted => {
                            root.query-submitted(self.text);
                        }
                    }

                    if root.query == "" && !input.has-focus : Text {
                        width: parent.width;
                        height: parent.height;
                        text: root.placeholder-text;
                        color: Theme.secondary;
                        vertical-alignment: center;

                        TouchArea {
                            clicked => { input.focus(); }
                        }
                    }
                }

                if root.query != "" : VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 20px;
                        height: 20px;
                        border-radius: 10px;
                        background: clear-touch.has-hover ? Theme.hover : transparent;

                        clear-touch := TouchArea {
                            clicked => {
                                root.query = "";
                                input.focus();
                            }
                        }

                        IconClose {
                            size: 10px;
                            tint: clear-touch.has-hover ? Theme.text : Theme.secondary;
                        }
                    }
                }
            }
        }

        Rectangle {
            width: 92px;
            border-radius: 8px;
            background: btn-touch.pressed ? Theme.overlay : (btn-touch.has-hover ? Theme.hover : Theme.accent);
            animate background { duration: 150ms; easing: ease-in-out; }

            btn-touch := TouchArea {
                clicked => { root.query-submitted(root.query); }
            }

            HorizontalLayout {
                alignment: center;
                spacing: 6px;

                VerticalLayout {
                    alignment: center;
                    IconSearch {
                        size: 16px;
                        tint: btn-touch.has-hover ? Theme.text : Theme.window;
                    }
                }

                Text {
                    text: root.search-button-label;
                    color: btn-touch.has-hover ? Theme.text : Theme.window;
                    font-size: 13px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
            }
        }
    }

    HorizontalLayout {
        spacing: 8px;
        alignment: start;

        FilterChip {
            text: root.filter-all-label;
            is-active: root.active-filter == 0;
            clicked => { root.filter-selected(0); }
        }
        FilterChip {
            text: root.filter-songs-label;
            is-active: root.active-filter == 1;
            clicked => { root.filter-selected(1); }
        }
        FilterChip {
            text: root.filter-albums-label;
            is-active: root.active-filter == 2;
            clicked => { root.filter-selected(2); }
        }
        FilterChip {
            text: root.filter-artists-label;
            is-active: root.active-filter == 3;
            clicked => { root.filter-selected(3); }
        }
        FilterChip {
            text: root.filter-playlists-label;
            is-active: root.active-filter == 4;
            clicked => { root.filter-selected(4); }
        }
    }

    if root.shelves.length == 0 : VerticalLayout {
        padding-top: 24px;
        alignment: center;

        Text {
            text: root.empty-text;
            color: Theme.secondary;
            font-size: 14px;
            horizontal-alignment: center;
        }
    }

    for shelf in root.shelves : VerticalLayout {
        spacing: 8px;
        alignment: start;

        Text {
            text: shelf.title;
            color: Theme.text;
            font-size: 18px;
            font-weight: 700;
        }

        for track in shelf.tracks : TrackRow {
            title: track.title;
            artist: track.artist;
            album: track.album;
            duration: track.duration;
            kind: track.kind;
            cover: track.cover;
            clicked => {
                root.track-selected(track.index);
            }
        }
    }
}
