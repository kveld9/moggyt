import { Theme, ExploreShelfData } from "../theme.slint";
import { MediaCard } from "../components/cards.slint";

export component ExploreView inherits VerticalLayout {
    in property <[ExploreShelfData]> shelves: [];
    in property <bool> is-loading: false;
    in property <string> loading-text: "Loading explore...";
    in property <string> empty-text: "No sections found in Explore.";
    callback track-selected(int);

    spacing: 16px;
    alignment: start;

    if root.is-loading : VerticalLayout {
        padding-top: 32px;
        alignment: center;

        Text {
            text: root.loading-text;
            color: Theme.secondary;
            font-size: 14px;
            horizontal-alignment: center;
        }
    }

    if !root.is-loading && root.shelves.length == 0 : VerticalLayout {
        padding-top: 32px;
        alignment: center;

        Text {
            text: root.empty-text;
            color: Theme.secondary;
            font-size: 14px;
            horizontal-alignment: center;
        }
    }

    for shelf in root.shelves : VerticalLayout {
        spacing: 10px;
        alignment: start;

        if shelf.title != "" : Text {
            text: shelf.title;
            color: Theme.text;
            font-size: 18px;
            font-weight: 700;
        }

        for row in shelf.rows : HorizontalLayout {
            spacing: 12px;
            alignment: start;

            for card in row.cards : MediaCard {
                index: card.index;
                title: card.title;
                subtitle: card.subtitle;
                has-cover: card.has_cover;
                cover: card.cover;
                tile-color: card.tile_color;
                clicked => { root.track-selected(card.index); }
            }
        }
    }
}
