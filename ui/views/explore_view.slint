import { Theme, ExploreCardData, ExploreShelfData } from "../theme.slint";
import { MediaCard } from "../components/cards.slint";

component ShelfCarousel inherits VerticalLayout {
    in property <string> shelf-title;
    in property <[ExploreCardData]> cards;
    callback card-clicked(int);

    spacing: 8px;
    alignment: start;

    if root.shelf-title != "" : Text {
        text: root.shelf-title;
        color: Theme.text;
        font-size: 18px;
        font-weight: 700;
    }

    Flickable {
        height: 202px;
        viewport-width: root.cards.length * 168px;
        viewport-height: 202px;

        HorizontalLayout {
            spacing: 12px;
            alignment: start;

            for card in root.cards : MediaCard {
                title: card.title;
                subtitle: card.subtitle;
                has-cover: card.has_cover;
                cover: card.cover;
                clicked => { root.card-clicked(card.index); }
            }
        }
    }
}

export component ExploreView inherits VerticalLayout {
    in property <[ExploreShelfData]> shelves: [];
    in property <bool> is-loading: false;
    in property <string> loading-text: "Loading explore...";
    in property <string> empty-text: "No sections found in Explore.";
    callback track-selected(int);

    spacing: 16px;
    alignment: start;

    if root.is-loading : VerticalLayout {
        padding-top: 32px;
        alignment: center;

        Text {
            text: root.loading-text;
            color: Theme.secondary;
            font-size: 14px;
            horizontal-alignment: center;
        }
    }

    if !root.is-loading && root.shelves.length == 0 : VerticalLayout {
        padding-top: 32px;
        alignment: center;

        Text {
            text: root.empty-text;
            color: Theme.secondary;
            font-size: 14px;
            horizontal-alignment: center;
        }
    }

    for shelf in root.shelves : ShelfCarousel {
        shelf-title: shelf.title;
        cards: shelf.cards;
        card-clicked(idx) => { root.track-selected(idx); }
    }
}
