import { ContextMenuLayer } from "../components/context_menu.slint";
import { PresetMenuLayer } from "../components/preset_menu.slint";
import { LibraryAddOverlay } from "../components/library_add.slint";
import { ToastsLayer } from "../components/toasts.slint";

export component AppOverlays inherits Rectangle {
    width: 100%;
    height: 100%;
