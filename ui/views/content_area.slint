import {
    Theme,
    ShelfData,
    TrackRowData,
    LyricLineData,
    LibraryItemData,
    ExploreShelfData,
} from "../theme.slint";
import { IconBack, IconSettings } from "../icons.slint";
import { SearchView } from "./search_view.slint";
import { ExploreView } from "./explore_view.slint";
import { NowPlayingView } from "./now_playing_view.slint";
import { LibraryView } from "./library_view.slint";
import { DetailView } from "./detail_view.slint";
import { SettingsView } from "./settings_view.slint";

export component ContentArea inherits Rectangle {
    in property <int> active-page: 0;
    in property <string> header-title: "Search";
    in property <bool> has-update: false;
    in-out property <string> query: "";
    in-out property <string> cookie-text: "";
    in property <bool> signed-in: false;
    in property <[ShelfData]> shelves: [];
    in property <int> search-filter: 0;
    in property <string> active-track-title: "No track playing";
    in property <string> active-track-artist: "";
    in property <string> position-text: "0:00";
    in property <string> duration-text: "0:00";
    in property <float> playback-progress: 0.0;
    in property <image> cover-image;
    in property <bool> has-cover: false;
    in property <[LyricLineData]> lyrics-lines: [];
    in property <int> active-lyric-index: -1;
    in property <[LibraryItemData]> library-playlists: [];
    in property <[LibraryItemData]> library-albums: [];
    in property <bool> detail-has-detail: false;
    in property <bool> detail-has-artwork: false;
    in property <string> detail-title: "";
    in property <string> detail-subtitle: "";
    in property <string> detail-description: "";
    in property <string> detail-kind-label: "";
    in property <[TrackRowData]> detail-tracks: [];
    in property <image> detail-cover;
    in property <int> active-theme-index: 0;
    in property <string> playback-speed-text: "1.00x";
    in property <string> sleep-timer-status-text: "Timer: Off";
    in property <int> active-sleep-timer-index: 0;
    in-out property <string> settings-cookie-text: "";
    in property <string> app-version: "0.1.0";
    in property <string> update-status-text: "Up to date";
    in property <[ExploreShelfData]> explore-shelves: [];
    in property <bool> explore-loading: false;
    in property <[string]> recent-searches: [];
    in property <bool> search-active: false;
    in property <int> player-bar-mode: 0;
    in property <bool> player-bar-show-artwork: true;
    in property <bool> player-bar-show-like: true;
    in property <bool> player-bar-show-shuffle: true;
    in property <bool> player-bar-show-repeat: true;
    in property <bool> player-bar-show-skip-seconds: false;
    in property <bool> player-bar-show-queue: true;
    in property <bool> player-bar-show-volume: true;

    callback query-submitted(string);
    callback track-selected(int);
    callback filter-selected(int);
    callback recent-search-selected(string);
    callback recent-search-removed(string);
    callback recent-searches-cleared();
    callback explore-track-selected(int);
    callback playlist-selected(int);
    callback album-selected(int);
    callback detail-track-selected(int);
    callback detail-play();
    callback detail-shuffle();
    callback sign-in-submitted(string);
    callback sign-out();
    callback open-settings();
    callback theme-selected(int);
    callback cycle-playback-speed();
    callback sleep-timer-preset-selected(int);
    callback back-pressed();
    callback player-bar-mode-selected(int);
    callback player-bar-option-toggled(int);

    background: Theme.window;
    clip: true;

    flick := Flickable {
        TouchArea {
            x: 0;
            y: -flick.viewport-y;
            width: flick.width;
            height: flick.height;

            scroll-event(event) => {
                let min-y = min(0px, flick.height - flick.viewport-height);
                flick.viewport-y = min(0px, max(min-y, flick.viewport-y + event.delta-y * 3.5));
                return EventResult.accept;
            }
        }

        VerticalLayout {
            padding: 24px;
            spacing: 16px;
            alignment: start;

            HorizontalLayout {
                alignment: space-between;

                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;

                    if root.active-page == 3 : VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 32px;
                            height: 32px;
                            border-radius: 8px;
                            background: back-btn.pressed ? Theme.overlay : (back-btn.has-hover ? Theme.hover : Theme.surface);
                            animate background { duration: 150ms; easing: ease-in-out; }

                            back-btn := TouchArea {
                                clicked => { root.back-pressed(); }
                            }

                            IconBack {
                                size: 16px;
                                tint: back-btn.has-hover ? Theme.accent : Theme.text;
                            }
                        }
                    }

                    Text {
                        text: root.header-title;
                        color: Theme.text;
                        font-size: 24px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }

                if root.active-page != 4 : VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 32px;
                        height: 32px;
                        border-radius: 8px;
                        background: settings-btn.pressed ? Theme.overlay : (settings-btn.has-hover ? Theme.hover : Theme.surface);
                        animate background { duration: 150ms; easing: ease-in-out; }

                        settings-btn := TouchArea {
                            clicked => { root.open-settings(); }
                        }

                        IconSettings {
                            size: 16px;
                            tint: settings-btn.has-hover ? Theme.accent : Theme.text;
                        }

                        if root.has-update : Rectangle {
                            x: parent.width - 6px;
                            y: 2px;
                            width: 6px;
                            height: 6px;
                            border-radius: 3px;
                            background: Theme.accent;
                        }
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: Theme.border;
            }

            if root.active-page == 0 : SearchView {
                query <=> root.query;
                shelves: root.shelves;
                active-filter: root.search-filter;
                recent-searches: root.recent-searches;
                search-active: root.search-active;
                query-submitted(q) => { root.query-submitted(q); }
                track-selected(idx) => { root.track-selected(idx); }
                filter-selected(idx) => { root.filter-selected(idx); }
                recent-search-selected(q) => { root.recent-search-selected(q); }
                recent-search-removed(q) => { root.recent-search-removed(q); }
                recent-searches-cleared => { root.recent-searches-cleared(); }
            }

            if root.active-page == 1 : NowPlayingView {
                track-title: root.active-track-title;
                track-artist: root.active-track-artist;
                position-text: root.position-text;
                duration-text: root.duration-text;
                progress: root.playback-progress;
                cover-image: root.cover-image;
                has-cover: root.has-cover;
                lyrics-lines: root.lyrics-lines;
                active-lyric-index: root.active-lyric-index;
            }

            if root.active-page == 2 : LibraryView {
                cookie-text <=> root.cookie-text;
                signed-in: root.signed-in;
                playlists: root.library-playlists;
                albums: root.library-albums;
                playlist-selected(idx) => { root.playlist-selected(idx); }
                album-selected(idx) => { root.album-selected(idx); }
                sign-in-submitted(t) => { root.sign-in-submitted(t); }
                sign-out() => { root.sign-out(); }
            }

            if root.active-page == 3 : DetailView {
                has-detail: root.detail-has-detail;
                detail-has-artwork: root.detail-has-artwork;
                title: root.detail-title;
                subtitle: root.detail-subtitle;
                description: root.detail-description;
                kind-label: root.detail-kind-label;
                cover: root.detail-cover;
                tracks: root.detail-tracks;
                track-selected(idx) => { root.detail-track-selected(idx); }
                play => { root.detail-play(); }
                shuffle => { root.detail-shuffle(); }
            }

            if root.active-page == 4 : SettingsView {
                active-theme-index: root.active-theme-index;
                playback-speed-text: root.playback-speed-text;
                signed-in: root.signed-in;
                cookie-text <=> root.settings-cookie-text;
                app-version: root.app-version;
                update-status-text: root.update-status-text;
                has-update: root.has-update;
                sleep-timer-status-text: root.sleep-timer-status-text;
                active-sleep-timer-index: root.active-sleep-timer-index;
                player-bar-mode: root.player-bar-mode;
                player-bar-show-artwork: root.player-bar-show-artwork;
                player-bar-show-like: root.player-bar-show-like;
                player-bar-show-shuffle: root.player-bar-show-shuffle;
                player-bar-show-repeat: root.player-bar-show-repeat;
                player-bar-show-skip-seconds: root.player-bar-show-skip-seconds;
                player-bar-show-queue: root.player-bar-show-queue;
                player-bar-show-volume: root.player-bar-show-volume;
                theme-selected(idx) => { root.theme-selected(idx); }
                cycle-playback-speed => { root.cycle-playback-speed(); }
                sleep-timer-preset-selected(idx) => { root.sleep-timer-preset-selected(idx); }
                sign-in-submitted(t) => { root.sign-in-submitted(t); }
                sign-out => { root.sign-out(); }
                player-bar-mode-selected(idx) => { root.player-bar-mode-selected(idx); }
                player-bar-option-toggled(idx) => { root.player-bar-option-toggled(idx); }
            }

            if root.active-page == 5 : ExploreView {
                shelves: root.explore-shelves;
                is-loading: root.explore-loading;
                track-selected(idx) => { root.explore-track-selected(idx); }
            }
        }
    }
}
