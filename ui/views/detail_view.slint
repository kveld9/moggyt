import { Labels } from "../labels.slint";
import { Theme, TrackRowData, DetailSectionData } from "../theme.slint";
import { TrackRow } from "../components/rows.slint";
import { ViewModeToggle } from "../components/view_mode_toggle.slint";
import { ContextSurface } from "../components/context_menu.slint";
import { DetailTile } from "../components/cards.slint";
import { StyledInputField } from "../components/controls.slint";
import { IconPlay, IconShuffle } from "../icons.slint";

export global LocalEditUi {
    in-out property <bool> is-local: false;
    in-out property <string> rename-text: "";
    callback rename-submitted(string);
    callback delete-requested();
    callback remove-track-requested(int);
    callback move-track-requested(int, int);
}

export global DetailUi {
    in-out property <bool> compact-tracks: false;
    callback compact-toggled();
}

export component DetailView inherits VerticalLayout {
    in property <bool> has-detail: false;
    in property <bool> detail-has-artwork: false;
    in property <string> title: "";
    in property <string> subtitle: "";
    in property <string> description: "";
    in property <string> kind-label: "";
    in property <image> cover;
    in property <[TrackRowData]> tracks: [];
    in property <bool> is-artist: false;
    in property <string> songs-title: "";
    in property <bool> has-songs-more: false;
    in property <[DetailSectionData]> sections: [];
    callback track-selected(int);
    callback play();
    callback shuffle();
    callback card-selected(int);
    callback show-all-songs();
    spacing: 16px;
    alignment: start;

    if !root.has-detail : VerticalLayout {
        padding-top: 24px;
        alignment: center;
        Text {
            text: Labels.empty-detail-text;
            color: Theme.secondary;
            font-size: 14px;
            horizontal-alignment: center;
        }
    }

    if root.has-detail : VerticalLayout {
        spacing: 16px;

        HorizontalLayout {
            spacing: 20px;
            alignment: start;

            Rectangle {
                width: 140px;
                height: 140px;
                border-radius: 12px;
                background: Theme.surface;
                clip: true;

                if root.cover.width > 0 : Image {
                    width: parent.width;
                    height: parent.height;
                    source: root.cover;
                    image-fit: ImageFit.cover;
                }
                if root.cover.width == 0 && !root.detail-has-artwork && root.tracks.length > 0 && root.tracks[0].cover.width > 0 : Image {
                    width: parent.width;
                    height: parent.height;
                    source: root.tracks[0].cover;
                    image-fit: ImageFit.cover;
                }
                if root.cover.width == 0 && (root.detail-has-artwork || root.tracks.length == 0 || root.tracks[0].cover.width == 0) : Text {
                    text: root.kind-label != "" ? root.kind-label : Labels.no-cover-text;
                    color: Theme.secondary;
                    font-size: 12px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            VerticalLayout {
                spacing: 6px;
                alignment: center;
                horizontal-stretch: 1;

                Text {
                    text: root.kind-label;
                    color: Theme.accent;
                    font-size: 11px;
                    font-weight: 700;
                }

                Text {
                    text: root.title;
                    color: Theme.text;
                    font-size: 24px;
                    font-weight: 800;
                    overflow: elide;
                }

                if root.subtitle != "" : Text {
                    text: root.subtitle;
                    color: Theme.secondary;
                    font-size: 13px;
                    overflow: elide;
                }

                if root.description != "" : Text {
                    text: root.description;
                    color: Theme.secondary;
                    font-size: 12px;
                    wrap: word-wrap;
                }

                Rectangle { height: 4px; }

                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;

                    Rectangle {
                        height: 36px;
                        border-radius: 18px;
                        background: play-touch.pressed ? Theme.overlay : (play-touch.has-hover ? Theme.hover : Theme.accent);
                        animate background { duration: 150ms; easing: ease-in-out; }

                        play-touch := TouchArea {
                            clicked => { root.play(); }
                        }

                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 20px;
                            spacing: 8px;
                            alignment: center;

                            VerticalLayout {
                                alignment: center;
                                IconPlay {
                                    size: 16px;
                                    tint: play-touch.has-hover ? Theme.text : Theme.window;
                                }
                            }

                            Text {
                                text: Labels.play-button-label;
                                color: play-touch.has-hover ? Theme.text : Theme.window;
                                font-size: 13px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }
                    }

                    Rectangle {
                        height: 36px;
                        border-radius: 18px;
                        background: shuf-touch.pressed ? Theme.overlay : (shuf-touch.has-hover ? Theme.hover : Theme.surface);
                        animate background { duration: 150ms; easing: ease-in-out; }

                        shuf-touch := TouchArea {
                            clicked => { root.shuffle(); }
                        }

                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 20px;
                            spacing: 8px;
                            alignment: center;

                            VerticalLayout {
                                alignment: center;
                                IconShuffle {
                                    size: 16px;
                                    tint: shuf-touch.has-hover ? Theme.accent : Theme.text;
                                }
                            }

                            Text {
                                text: Labels.shuffle-button-label;
                                color: shuf-touch.has-hover ? Theme.accent : Theme.text;
                                font-size: 13px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }
                    }

                    if root.tracks.length > 0 : ViewModeToggle {
                        compact: DetailUi.compact-tracks;
                        toggled => { DetailUi.compact-toggled(); }
                    }
                }

                if LocalEditUi.is-local : HorizontalLayout {
                    spacing: 8px;
                    height: 32px;
                    alignment: start;

                    StyledInputField {
                        width: 220px;
                        text <=> LocalEditUi.rename-text;
                        placeholder-text: Labels.local-rename-placeholder;
                        accepted(t) => { LocalEditUi.rename-submitted(t); }
                    }

                    Rectangle {
                        border-radius: 6px;
                        background: rename-touch.pressed ? Theme.overlay : (rename-touch.has-hover ? Theme.hover : Theme.surface);
                        animate background { duration: 150ms; easing: ease-in-out; }

                        rename-touch := TouchArea {
                            clicked => { LocalEditUi.rename-submitted(LocalEditUi.rename-text); }
                        }

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            alignment: center;

                            Text {
                                text: Labels.local-rename-label;
                                color: rename-touch.has-hover ? Theme.accent : Theme.text;
                                font-size: 12px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                    }

                    Rectangle {
                        border-radius: 6px;
                        background: delete-touch.pressed ? Theme.overlay : (delete-touch.has-hover ? Theme.hover : Theme.surface);
                        animate background { duration: 150ms; easing: ease-in-out; }

                        delete-touch := TouchArea {
                            clicked => { LocalEditUi.delete-requested(); }
                        }

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            alignment: center;

                            Text {
                                text: Labels.local-delete-label;
                                color: delete-touch.has-hover ? Theme.text : Theme.secondary;
                                font-size: 12px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.border;
        }

        if root.is-artist && root.songs-title != "" : Text {
            text: root.songs-title;
            color: Theme.text;
            font-size: 20px;
            font-weight: 700;
        }

        if root.tracks.length == 0 : VerticalLayout {
            padding-top: 16px;
            alignment: center;
            Text {
                text: Labels.empty-songs-text;
                color: Theme.secondary;
                font-size: 13px;
                horizontal-alignment: center;
            }
        }

        for track in root.tracks : TrackRow {
            title: track.title;
            artist: track.artist;
            album: track.album;
            duration: track.duration;
            kind: track.kind;
            index: track.index;
            surface: ContextSurface.detail;
            cover: track.cover;
            show-remove: LocalEditUi.is-local;
            compact: DetailUi.compact-tracks;
            clicked => { root.track-selected(track.index); }
            remove-requested => { LocalEditUi.remove-track-requested(track.index); }
            move-up-requested => { LocalEditUi.move-track-requested(track.index, track.index - 1); }
            move-down-requested => { LocalEditUi.move-track-requested(track.index, track.index + 1); }
        }

        if root.is-artist && root.has-songs-more : HorizontalLayout {
            alignment: start;

            Rectangle {
                width: 132px;
                height: 34px;
                border-radius: 17px;
                background: more-touch.pressed ? Theme.overlay : (more-touch.has-hover ? Theme.hover : Theme.surface);
                animate background { duration: 150ms; easing: ease-in-out; }

                more-touch := TouchArea {
                    clicked => { root.show-all-songs(); }
                }

                Text {
                    text: Labels.show-all-label;
                    color: more-touch.has-hover ? Theme.accent : Theme.text;
                    font-size: 12px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        for section in root.sections : VerticalLayout {
            spacing: 10px;
            alignment: start;

            if section.title != "" : Text {
                text: section.title;
                color: Theme.text;
                font-size: 20px;
                font-weight: 700;
            }

            for row in section.rows : HorizontalLayout {
                spacing: 12px;
                alignment: start;

                for card in row.cards : DetailTile {
                    index: card.index;
                    circular: card.circular;
                    title: card.title;
                    subtitle: card.subtitle;
                    has-cover: card.has_cover;
                    cover: card.cover;
                    clicked => { root.card-selected(card.index); }
                }
            }
        }
    }
}
