import { Labels } from "../labels.slint";
import { LyricsHighlight, Theme, LyricLineData } from "../theme.slint";
import { SettingsModeButton } from "../components/settings_rows.slint";
import { VinylDeck } from "../components/vinyl_deck.slint";
import { VersionFixUi } from "version_fix.slint";

export component NowPlayingView inherits VerticalLayout {
    in property <string> track-title: "No track playing";
    in property <string> track-artist: "";
    in property <string> position-text: "0:00";
    in property <string> duration-text: "0:00";
    in property <float> progress: 0.0;
    in property <image> cover-image;
    in property <bool> has-cover: false;
    in property <[LyricLineData]> lyrics-lines: [];
    in property <int> active-lyric-index: -1;
    in property <bool> is-playing: false;
    property <bool> vinyl-mode: false;

    spacing: 16px; alignment: start;

    HorizontalLayout {
        spacing: 20px; alignment: start;
        if !root.vinyl-mode : Rectangle {
            width: 140px; height: 140px; border-radius: 8px; background: Theme.surface; clip: true;
            if root.has-cover : Image {
                width: parent.width; height: parent.height;
                source: root.cover-image;
                image-fit: cover;
            }
            if !root.has-cover : Text {
                text: Labels.no-cover-text; color: Theme.secondary; font-size: 12px;
                horizontal-alignment: center; vertical-alignment: center;
            }
        }
        if root.vinyl-mode : VinylDeck {
            cover: root.cover-image;
            has-cover: root.has-cover;
            is-playing: root.is-playing;
        }
        VerticalLayout {
            spacing: 6px; alignment: center;
            HorizontalLayout {
                spacing: 6px;
                SettingsModeButton {
                    label: Labels.now-playing-cover-label;
                    is-active: !root.vinyl-mode;
                    clicked => { root.vinyl-mode = false; }
                }
                SettingsModeButton {
                    label: Labels.now-playing-vinyl-label;
                    is-active: root.vinyl-mode;
                    clicked => { root.vinyl-mode = true; }
                }
                SettingsModeButton {
                    label: Labels.version-fix-open-label;
                    is-active: false;
                    clicked => { VersionFixUi.active = true; }
                }
            }
            Text { text: root.track-title; color: Theme.text; font-size: 20px; font-weight: 700; }
            Text { text: root.track-artist; color: Theme.secondary; font-size: 14px; }
            Rectangle { height: 6px; }
            // Progress bar
            Rectangle {
                height: 6px; border-radius: 3px; background: Theme.surface; clip: true;
                Rectangle { x: 0; width: parent.width * root.progress; height: parent.height; background: Theme.accent; border-radius: 3px; }
            }
            HorizontalLayout {
                Text { text: root.position-text; color: Theme.secondary; font-size: 11px; }
                Rectangle {}
                Text { text: root.duration-text != "" ? root.duration-text : "--:--"; color: Theme.secondary; font-size: 11px; }
            }
        }
    }

    if root.lyrics-lines.length == 0 : Rectangle {
        height: 140px; border-radius: 8px; background: Theme.panel;
        VerticalLayout {
            alignment: center; spacing: 4px;
            Text { text: Labels.lyrics-unavailable-text; color: Theme.secondary; font-size: 13px; font-weight: 700; horizontal-alignment: center; }
            Text { text: Labels.lyrics-hint-text; color: Theme.secondary; font-size: 11px; horizontal-alignment: center; }
        }
    }

    if root.lyrics-lines.length > 0 : Rectangle {
        border-radius: 8px; background: Theme.panel; clip: true;
        VerticalLayout {
            padding: 12px; spacing: 8px; alignment: start;
            // Slint 1.18: Text does not wrap unless `wrap` is set, and a no-wrap Text
            // keeps its full single-line preferred width. The sung/rest split therefore
            // renders as one continuous line that clips instead of wrapping.
            // https://docs.slint.dev/docs/slint/reference/elements/text/
            for line in root.lyrics-lines : HorizontalLayout {
                if line.index != root.active-lyric-index : Text {
                    text: line.text;
                    color: Theme.secondary;
                    font-size: 13px;
                    font-weight: 400;
                }
                if line.index == root.active-lyric-index && LyricsHighlight.sung-text != "" : Text {
                    text: LyricsHighlight.sung-text;
                    color: Theme.accent;
                    font-size: 15px;
                    font-weight: 700;
                }
                if line.index == root.active-lyric-index : Text {
                    text: LyricsHighlight.rest-text;
                    color: LyricsHighlight.sung-text == "" ? Theme.accent : Theme.secondary;
                    font-size: 15px;
                    font-weight: 700;
                }
            }
        }
    }
}
