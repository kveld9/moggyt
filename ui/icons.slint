import { Theme } from "./theme.slint";

export component IconPlay inherits Rectangle {
    in property <color> tint: Theme.text;
    in property <length> size: 20px;
    width: root.size;
    height: root.size;

    Path {
        width: root.size;
        height: root.size;
        viewbox-x: 0; viewbox-y: 0; viewbox-width: 24; viewbox-height: 24;
        fill: root.tint;
        stroke: root.tint;
        stroke-width: 1.8px;
        commands: "M 7 6.5 C 7 5.2 8.3 4.5 9.4 5.1 L 18.4 10.6 C 19.5 11.2 19.5 12.8 18.4 13.4 L 9.4 18.9 C 8.3 19.5 7 18.8 7 17.5 Z";
    }
}

