}

export struct LyricLineData {
    index: int,
    text: string,
}

export global PlaybackUi {
    in-out property <bool> autoplay-enabled: false;
    callback autoplay-toggled();
    callback queue-cleared();
}

export global PlayerUi {
    in-out property <bool> is-playing: false;
    // True while the player is loading the next stream or stalled without progress.
    in-out property <bool> is-buffering: false;

    // Id of the track the player currently holds. Rows compare their own id against it to
    // render the now-playing marker; `sync_window` in the Rust shell owns this property.
    in-out property <string> track-id: "";
    in-out property <bool> is-shuffle: false;
    in-out property <int> repeat-mode: 0;
    in-out property <bool> is-liked: false;
    in-out property <int> position-secs: 0;
    in-out property <int> duration-secs: 0;
    in-out property <string> position-text: "0:00";
    in-out property <string> duration-text: "0:00";
    in-out property <string> remaining-text: "";
    in-out property <bool> show-remaining-time: false;
    in-out property <float> progress: 0.0;
    // Localized reason of the last failed play attempt; empty when there is no error.
    in-out property <string> playback-error: "";
    in-out property <int> volume: 100;

    callback toggle-play();
    callback prev-track();
    callback next-track();
    callback seek-by(int);
    callback seek-to(int);
    callback set-volume(int);
    callback toggle-like();
    callback retry-playback();
    callback open-artist();
    callback toggle-shuffle();
    callback cycle-repeat();
}

// Player bar presentation geometry. `mode` mirrors the `player-bar-mode` window
// property (0 = classic docked bar, 1 = floating overlay); the derived lengths keep
// every consumer in sync without repeating the pixel values.
export global PlayerBarUi {
    in-out property <int> mode: 0;
    // Width cap in pixels of the floating bar; mirrors the persisted player-bar width
    // setting and the Rust clamp range (800..=1600), so slider, geometry and store agree.
    in-out property <int> floating-width: 960;
    // Emitted on every slider step with the requested width cap in pixels.
    callback floating-width-changed(int);
    // Bottom strip the window layout reserves for the docked classic bar.
    out property <length> reserved-height: mode == 0 ? 72px : 0px;
    // Bottom strip the floating bar covers; content scrolls underneath it.
    out property <length> content-inset: mode == 1 ? 92px : 0px;
    // Horizontal margin the floating bar keeps from the window edges (24px per side).
    out property <length> floating-margin: 48px;
    // Logical window width published by the Rust shell. The window size is only observable
    // from the OS side; deriving it in Slint would feed the layout pass back into itself.
    in-out property <length> window-width: 1024px;
}

export struct ImportRowData {
    index: int,
    source: string,
    matched: string,
    state: string,
    confidence: string,
    has-match: bool,
    channel: string,
    delta: string,
    excluded: bool,
}

export struct ImportAlternativeData {
    index: int,
    title: string,
    artist: string,
    detail: string,
}

export global Theme {
    in-out property <color> window;
    in-out property <color> panel;
    in-out property <color> surface;
    in-out property <color> text;
    in-out property <color> secondary;
    in-out property <color> accent;
    in-out property <color> border;
    in-out property <color> hover;
    in-out property <color> overlay;
    // Modal backdrop scrim: translucent so the app stays readable behind dialogs.
    // Intrinsic to the design system (one owner for every overlay), never themed.
    in-out property <color> scrim: #00000099;
    in-out property <bool> dark;
}

export global LyricsHighlight {
    in-out property <string> sung-text: "";
    in-out property <string> rest-text: "";
}
