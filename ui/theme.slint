export struct TrackRowData {
    index: int,
    id: string,
    title: string,
    artist: string,
    album: string,
    added: string,
    duration: string,
    kind: string,
    cover: image,
}

export struct ShelfData {
    title: string,
    tracks: [TrackRowData],
}

export struct TopResultData {
    has-result: bool,
    heading: string,
    title: string,
    subtitle: string,
    has-cover: bool,
    cover: image,
    circular: bool,
}

export struct ExploreCardData {
    index: int,
    title: string,
    subtitle: string,
    has_cover: bool,
    cover: image,
    tile_color: color,
}

export struct ExploreCardRow {
    cards: [ExploreCardData],
}

export struct ExploreShelfData {
    title: string,
    rows: [ExploreCardRow],
}

export struct DetailCardData {
    index: int,
    title: string,
    subtitle: string,
    has-cover: bool,
    cover: image,
    circular: bool,
}

export struct DetailCardRow {
