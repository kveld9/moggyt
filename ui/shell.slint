import { LineEdit } from "std-widgets.slint";

export struct TrackRowData {
    index: int,
    title: string,
    artist: string,
    duration: string,
}

export struct ShelfData {
    title: string,
    tracks: [TrackRowData],
}

component NavItem inherits Rectangle {
    in property <string> text;
    in property <bool> is-active: false;
    callback clicked();

    height: 40px;
    border-radius: 6px;
    background: root.is-active ? #282828 : (touch.has-hover ? #1a1a1a : #00000000);

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        alignment: start;

        Text {
            text: root.text;
            color: root.is-active ? #ffffff : #b3b3b3;
            font-size: 14px;
            font-weight: 700;
            vertical-alignment: center;
        }
    }
}

component Sidebar inherits Rectangle {
    in property <int> active-page: 0;
    callback page-selected(int);

    width: 200px;
    background: #000000;

    VerticalLayout {
        padding: 16px;
        spacing: 8px;
        alignment: start;

        Text {
            text: "Moggyt";
            color: #1db954;
            font-size: 20px;
            font-weight: 800;
        }

        Rectangle { height: 12px; }

        NavItem {
            text: "Search";
            is-active: root.active-page == 0;
            clicked => { root.page-selected(0); }
        }

        NavItem {
            text: "Queue";
            is-active: root.active-page == 1;
            clicked => { root.page-selected(1); }
        }

        NavItem {
            text: "Now Playing";
            is-active: root.active-page == 2;
            clicked => { root.page-selected(2); }
        }

        NavItem {
            text: "Library";
            is-active: root.active-page == 3;
            clicked => { root.page-selected(3); }
        }

        NavItem {
            text: "Detail";
            is-active: root.active-page == 4;
            clicked => { root.page-selected(4); }
        }
    }
}

component TrackRow inherits Rectangle {
    in property <string> title;
    in property <string> artist;
    in property <string> duration;
    callback clicked();

    height: 36px;
    border-radius: 4px;
    background: touch.has-hover ? #282828 : #00000000;

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;

        Text {
            text: root.title;
            color: #ffffff;
            font-size: 14px;
            font-weight: 500;
            vertical-alignment: center;
        }

        Text {
            text: root.artist;
            color: #b3b3b3;
            font-size: 13px;
            vertical-alignment: center;
        }

        Rectangle {}

        Text {
            text: root.duration;
            color: #b3b3b3;
            font-size: 13px;
            vertical-alignment: center;
            horizontal-alignment: right;
        }
    }
}

component SearchView inherits VerticalLayout {
    in-out property <string> query: "";
    in property <[ShelfData]> shelves: [];
    callback query-submitted(string);
    callback track-selected(int);

    spacing: 16px;
    alignment: start;

    HorizontalLayout {
        spacing: 8px;
        height: 36px;

        input := LineEdit {
            text <=> root.query;
            placeholder-text: "Search tracks...";
            accepted(text) => {
                root.query-submitted(text);
            }
        }

        Rectangle {
            width: 80px;
            border-radius: 6px;
            background: btn-touch.has-hover ? #1ed760 : #1db954;

            btn-touch := TouchArea {
                clicked => { root.query-submitted(root.query); }
            }

            Text {
                text: "Search";
                color: #000000;
                font-size: 13px;
                font-weight: 700;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }
    }

    if root.shelves.length == 0 : VerticalLayout {
        padding-top: 24px;
        alignment: center;

        Text {
            text: "No results found.";
            color: #b3b3b3;
            font-size: 14px;
            horizontal-alignment: center;
        }
    }

    for shelf in root.shelves : VerticalLayout {
        spacing: 8px;

        Text {
            text: shelf.title;
            color: #ffffff;
            font-size: 18px;
            font-weight: 700;
        }

        for track in shelf.tracks : TrackRow {
            title: track.title;
            artist: track.artist;
            duration: track.duration;
            clicked => {
                root.track-selected(track.index);
            }
        }
    }
}

component ContentArea inherits Rectangle {
    in property <int> active-page: 0;
    in property <string> header-title: "Search";
    in-out property <string> query: "";
    in property <[ShelfData]> shelves: [];

    callback query-submitted(string);
    callback track-selected(int);

    background: #121212;

    VerticalLayout {
        padding: 24px;
        spacing: 16px;
        alignment: start;

        Text {
            text: root.header-title;
            color: #ffffff;
            font-size: 24px;
            font-weight: 700;
        }

        Rectangle {
            height: 1px;
            background: #282828;
        }

        if root.active-page == 0 : SearchView {
            query <=> root.query;
            shelves: root.shelves;
            query-submitted(q) => {
                root.query-submitted(q);
            }
            track-selected(idx) => {
                root.track-selected(idx);
            }
        }

        if root.active-page != 0 : VerticalLayout {
            alignment: center;
            spacing: 12px;

            if root.active-page == 1 : Text {
                text: "Queue Page Placeholder";
                color: #b3b3b3;
                font-size: 16px;
                horizontal-alignment: center;
            }
            if root.active-page == 2 : Text {
                text: "Now Playing Page Placeholder";
                color: #b3b3b3;
                font-size: 16px;
                horizontal-alignment: center;
            }
            if root.active-page == 3 : Text {
                text: "Library Page Placeholder";
                color: #b3b3b3;
                font-size: 16px;
                horizontal-alignment: center;
            }
            if root.active-page == 4 : Text {
                text: "Detail Page Placeholder";
                color: #b3b3b3;
                font-size: 16px;
                horizontal-alignment: center;
            }
        }
    }
}

export component MoggytWindow inherits Window {
    title: "Moggyt";
    min-width: 800px;
    min-height: 500px;
    preferred-width: 1024px;
    preferred-height: 640px;
    background: #121212;

    in-out property <int> active-page: 0;
    in-out property <string> header-title: "Search";
    in-out property <string> query: "";
    in-out property <[ShelfData]> shelves: [];

    callback page-selected(int);
    callback query-submitted(string);
    callback track-selected(int);

    HorizontalLayout {
        padding: 0;
        spacing: 0;

        Sidebar {
            active-page: root.active-page;
            page-selected(idx) => {
                root.page-selected(idx);
            }
        }

        ContentArea {
            active-page: root.active-page;
            header-title: root.header-title;
            query <=> root.query;
            shelves: root.shelves;
            query-submitted(q) => {
                root.query-submitted(q);
            }
            track-selected(idx) => {
                root.track-selected(idx);
            }
        }
    }
}
