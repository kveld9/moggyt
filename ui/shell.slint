import { LineEdit, Slider } from "std-widgets.slint";

export struct TrackRowData {
    index: int,
    title: string,
    artist: string,
    album: string,
    duration: string,
    kind: string,
    cover: image,
}

export struct ShelfData {
    title: string,
    tracks: [TrackRowData],
}

export struct LibraryItemData {
    index: int,
    title: string,
    subtitle: string,
}

export struct LyricLineData {
    index: int,
    text: string,
}

global Theme {
    in-out property <color> window;
    in-out property <color> panel;
    in-out property <color> surface;
    in-out property <color> text;
    in-out property <color> secondary;
    in-out property <color> accent;
    in-out property <color> border;
    in-out property <color> hover;
    in-out property <color> overlay;
    in-out property <bool> dark;
}

component NavItem inherits Rectangle {
    in property <string> text;
    in property <bool> is-active: false;
    callback clicked();

    height: 40px;
    border-radius: 6px;
    background: root.is-active ? Theme.surface : (touch.has-hover ? Theme.hover : transparent);

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        alignment: start;

        Text {
            text: root.text;
            color: root.is-active ? Theme.text : Theme.secondary;
            font-size: 14px;
            font-weight: 700;
            vertical-alignment: center;
        }
    }
}

component Sidebar inherits Rectangle {
    in property <int> active-page: 0;
    callback page-selected(int);

    width: 200px;
    background: Theme.panel;

    VerticalLayout {
        padding: 16px;
        spacing: 8px;
        alignment: start;

        Text {
            text: "Moggyt";
            color: Theme.accent;
            font-size: 20px;
            font-weight: 800;
        }

        Rectangle { height: 12px; }

        NavItem {
            text: "Search";
            is-active: root.active-page == 0;
            clicked => { root.page-selected(0); }
        }

        NavItem {
            text: "Queue";
            is-active: root.active-page == 1;
            clicked => { root.page-selected(1); }
        }

        NavItem {
            text: "Now Playing";
            is-active: root.active-page == 2;
            clicked => { root.page-selected(2); }
        }

        NavItem {
            text: "Library";
            is-active: root.active-page == 3;
            clicked => { root.page-selected(3); }
        }

        NavItem {
            text: "Detail";
            is-active: root.active-page == 4;
            clicked => { root.page-selected(4); }
        }
    }
}

component FilterChip inherits Rectangle {
    in property <string> text;
    in property <bool> is-active: false;
    callback clicked();

    height: 28px;
    border-radius: 14px;
    background: root.is-active ? Theme.accent : (touch.has-hover ? Theme.hover : Theme.surface);

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        alignment: center;

        Text {
            text: root.text;
            color: root.is-active ? Theme.window : (touch.has-hover ? Theme.text : Theme.secondary);
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
}

component TrackRow inherits Rectangle {
    in property <string> title;
    in property <string> artist;
    in property <string> album;
    in property <string> duration;
    in property <string> kind;
    in property <image> cover;
    in property <bool> is-active: false;
    callback clicked();

    property <string> subtitle-text: root.album != "" && root.artist != "" ? root.artist + " - " + root.album : (
        root.artist != "" ? root.artist : root.album
    );

    height: 56px;
    border-radius: 6px;
    background: root.is-active ? Theme.surface : (touch.has-hover ? Theme.hover : transparent);

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;

        Rectangle {
            width: 40px;
            height: 40px;
            border-radius: 4px;
            background: Theme.surface;
            clip: true;

            Image {
                width: parent.width;
                height: parent.height;
                source: root.cover;
                image-fit: contain;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;

            Text {
                text: root.title;
                color: root.is-active ? Theme.accent : Theme.text;
                font-size: 14px;
                font-weight: 600;
                overflow: elide;
            }

            if root.subtitle-text != "" : Text {
                text: root.subtitle-text;
                color: Theme.secondary;
                font-size: 12px;
                overflow: elide;
            }
        }

        if root.duration != "" : Text {
            text: root.duration;
            color: Theme.secondary;
            font-size: 13px;
            vertical-alignment: center;
            horizontal-alignment: right;
        }
    }
}

component SearchView inherits VerticalLayout {
    in-out property <string> query: "";
    in property <[ShelfData]> shelves: [];
    in property <int> active-filter: 0;
    callback query-submitted(string);
    callback track-selected(int);
    callback filter-selected(int);

    spacing: 16px;
    alignment: start;

    HorizontalLayout {
        spacing: 8px;
        height: 36px;

        input := LineEdit {
            text <=> root.query;
            placeholder-text: "Search tracks...";
            accepted(text) => {
                root.query-submitted(text);
            }
        }

        Rectangle {
            width: 80px;
            border-radius: 6px;
            background: btn-touch.has-hover ? Theme.hover : Theme.accent;

            btn-touch := TouchArea {
                clicked => { root.query-submitted(root.query); }
            }

            Text {
                text: "Search";
                color: btn-touch.has-hover ? Theme.text : Theme.window;
                font-size: 13px;
                font-weight: 700;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }
    }

    HorizontalLayout {
        spacing: 8px;
        alignment: start;

        FilterChip {
            text: "All";
            is-active: root.active-filter == 0;
            clicked => { root.filter-selected(0); }
        }
        FilterChip {
            text: "Songs";
            is-active: root.active-filter == 1;
            clicked => { root.filter-selected(1); }
        }
        FilterChip {
            text: "Albums";
            is-active: root.active-filter == 2;
            clicked => { root.filter-selected(2); }
        }
        FilterChip {
            text: "Artists";
            is-active: root.active-filter == 3;
            clicked => { root.filter-selected(3); }
        }
        FilterChip {
            text: "Playlists";
            is-active: root.active-filter == 4;
            clicked => { root.filter-selected(4); }
        }
    }

    if root.shelves.length == 0 : VerticalLayout {
        padding-top: 24px;
        alignment: center;

        Text {
            text: "No results found.";
            color: Theme.secondary;
            font-size: 14px;
            horizontal-alignment: center;
        }
    }

    for shelf in root.shelves : VerticalLayout {
        spacing: 8px;
        alignment: start;

        Text {
            text: shelf.title;
            color: Theme.text;
            font-size: 18px;
            font-weight: 700;
        }

        for track in shelf.tracks : TrackRow {
            title: track.title;
            artist: track.artist;
            album: track.album;
            duration: track.duration;
            kind: track.kind;
            cover: track.cover;
            clicked => {
                root.track-selected(track.index);
            }
        }
    }
}

export component PlayerBar inherits Rectangle {
    in property <string> active-track-title: "No track playing";
    in property <string> active-track-artist: "";
    in property <bool> is-playing: false;
    in property <int> volume: 100;
    in property <string> position-text: "0:00";
    in property <string> duration-text: "0:00";
    in property <image> cover;
    in property <bool> is-liked: false;
    in property <bool> is-shuffle: false;
    in property <int> repeat-mode: 0;
    in property <float> progress: 0.0;
    in property <int> position-secs: 0;
    in property <int> duration-secs: 0;
    in property <int> queue-count: 0;

    callback toggle-play();
    callback prev-track();
    callback next-track();
    callback seek-by(int);
    callback seek-to(int);
    callback set-volume(int);
    callback toggle-like();
    callback toggle-shuffle();
    callback cycle-repeat();
    callback open-queue();

    height: 72px;
    background: Theme.panel;

    Rectangle {
        y: 0;
        height: 1px;
        background: Theme.border;
    }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 16px;
        alignment: space-between;

        // LEFT ZONE: Artwork, Title + Artist, Like toggle
        HorizontalLayout {
            width: 240px;
            spacing: 12px;
            alignment: start;

            Rectangle {
                width: 44px;
                height: 44px;
                border-radius: 4px;
                background: Theme.surface;
                clip: true;

                Image {
                    width: parent.width;
                    height: parent.height;
                    source: root.cover;
                    image-fit: contain;
                }
            }

            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 2px;

                Text {
                    text: root.active-track-title;
                    color: Theme.text;
                    font-size: 13px;
                    font-weight: 700;
                    overflow: elide;
                }

                if root.active-track-artist != "" : Text {
                    text: root.active-track-artist;
                    color: Theme.secondary;
                    font-size: 11px;
                    overflow: elide;
                }
            }

            Rectangle {
                width: 32px;
                height: 32px;
                border-radius: 16px;
                background: root.is-liked ? Theme.surface : (like-touch.has-hover ? Theme.hover : transparent);

                like-touch := TouchArea {
                    clicked => { root.toggle-like(); }
                }

                Text {
                    text: "<3";
                    color: root.is-liked ? Theme.accent : (like-touch.has-hover ? Theme.text : Theme.secondary);
                    font-size: 12px;
                    font-weight: 700;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }
        }

        // CENTER ZONE: Shuffle, Prev, Play/Pause, Next, Repeat + Progress row
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 4px;

            HorizontalLayout {
                spacing: 12px;
                alignment: center;

                Rectangle {
                    width: 44px;
                    height: 26px;
                    border-radius: 4px;
                    background: root.is-shuffle ? Theme.surface : (shuf-touch.has-hover ? Theme.hover : transparent);

                    shuf-touch := TouchArea {
                        clicked => { root.toggle-shuffle(); }
                    }

                    Text {
                        text: "Shuf";
                        color: root.is-shuffle ? Theme.accent : (shuf-touch.has-hover ? Theme.text : Theme.secondary);
                        font-size: 11px;
                        font-weight: 700;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                }

                Rectangle {
                    width: 36px;
                    height: 26px;
                    border-radius: 4px;
                    background: pt.has-hover ? Theme.hover : transparent;

                    pt := TouchArea {
                        clicked => { root.prev-track(); }
                    }

                    Text {
                        text: "Prev";
                        color: pt.has-hover ? Theme.text : Theme.secondary;
                        font-size: 12px;
                        font-weight: 700;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                }

                Rectangle {
                    width: 60px;
                    height: 26px;
                    border-radius: 13px;
                    background: pp.has-hover ? Theme.hover : Theme.accent;

                    pp := TouchArea {
                        clicked => { root.toggle-play(); }
                    }

                    Text {
                        text: root.is-playing ? "Pause" : "Play";
                        color: pp.has-hover ? Theme.text : Theme.window;
                        font-size: 12px;
                        font-weight: 700;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                }

                Rectangle {
                    width: 36px;
                    height: 26px;
                    border-radius: 4px;
                    background: nt.has-hover ? Theme.hover : transparent;

                    nt := TouchArea {
                        clicked => { root.next-track(); }
                    }

                    Text {
                        text: "Next";
                        color: nt.has-hover ? Theme.text : Theme.secondary;
                        font-size: 12px;
                        font-weight: 700;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                }

                Rectangle {
                    width: 56px;
                    height: 26px;
                    border-radius: 4px;
                    background: root.repeat-mode != 0 ? Theme.surface : (rep-touch.has-hover ? Theme.hover : transparent);

                    rep-touch := TouchArea {
                        clicked => { root.cycle-repeat(); }
                    }

                    Text {
                        text: root.repeat-mode == 2 ? "Rep 1" : (root.repeat-mode == 1 ? "Rep All" : "Rep");
                        color: root.repeat-mode != 0 ? Theme.accent : (rep-touch.has-hover ? Theme.text : Theme.secondary);
                        font-size: 11px;
                        font-weight: 700;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: center;

                Text {
                    text: root.position-text;
                    color: Theme.secondary;
                    font-size: 11px;
                    vertical-alignment: center;
                }

                Slider {
                    horizontal-stretch: 1;
                    minimum: 0;
                    maximum: max(1, root.duration-secs);
                    value: min(root.position-secs, max(1, root.duration-secs));
                    enabled: root.duration-secs > 0;
                    changed(val) => {
                        root.seek-to(round(val));
                    }
                }

                Text {
                    text: root.duration-text;
                    color: Theme.secondary;
                    font-size: 11px;
                    vertical-alignment: center;
                }
            }
        }

        // RIGHT ZONE: Queue button, Volume Slider + percentage
        HorizontalLayout {
            width: 240px;
            alignment: end;
            spacing: 8px;

            Rectangle {
                height: 26px;
                border-radius: 4px;
                background: q-touch.has-hover ? Theme.hover : Theme.surface;

                q-touch := TouchArea {
                    clicked => { root.open-queue(); }
                }

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    alignment: center;

                    Text {
                        text: root.queue-count > 0 ? "Queue (" + root.queue-count + ")" : "Queue";
                        color: q-touch.has-hover ? Theme.accent : Theme.text;
                        font-size: 11px;
                        font-weight: 700;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                }
            }

            Slider {
                width: 90px;
                minimum: 0;
                maximum: 100;
                value: root.volume;
                changed(val) => {
                    root.set-volume(round(val));
                }
            }

            Text {
                text: "\{root.volume}%";
                color: Theme.secondary;
                font-size: 11px;
                width: 34px;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }
    }
}

export component QueueView inherits VerticalLayout {
    in property <[TrackRowData]> tracks: [];
    in property <int> selected-index: -1;
    callback track-selected(int);

    spacing: 8px; alignment: start;
    if root.tracks.length == 0 : VerticalLayout {
        padding-top: 24px; alignment: center;
        Text { text: "Queue is empty."; color: Theme.secondary; font-size: 14px; horizontal-alignment: center; }
    }
    for track in root.tracks : TrackRow {
        title: track.title;
        artist: track.artist;
        album: track.album;
        duration: track.duration;
        kind: track.kind;
        cover: track.cover;
        is-active: track.index == root.selected-index;
        clicked => { root.track-selected(track.index); }
    }
}

export component NowPlayingView inherits VerticalLayout {
    in property <string> track-title: "No track playing";
    in property <string> track-artist: "";
    in property <string> position-text: "0:00";
    in property <string> duration-text: "0:00";
    in property <float> progress: 0.0;
    in property <image> cover-image;
    in property <bool> has-cover: false;
    in property <[LyricLineData]> lyrics-lines: [];
    in property <int> active-lyric-index: -1;

    spacing: 16px; alignment: start;

    HorizontalLayout {
        spacing: 20px; alignment: start;
        Rectangle {
            width: 140px; height: 140px; border-radius: 8px; background: Theme.surface; clip: true;
            if root.has-cover : Image {
                width: parent.width; height: parent.height;
                source: root.cover-image;
                image-fit: contain;
            }
            if !root.has-cover : Text {
                text: "No Cover"; color: Theme.secondary; font-size: 12px;
                horizontal-alignment: center; vertical-alignment: center;
            }
        }
        VerticalLayout {
            spacing: 6px; alignment: center;
            Text { text: root.track-title; color: Theme.text; font-size: 20px; font-weight: 700; }
            Text { text: root.track-artist; color: Theme.secondary; font-size: 14px; }
            Rectangle { height: 6px; }
            // Progress bar
            Rectangle {
                height: 6px; border-radius: 3px; background: Theme.surface; clip: true;
                Rectangle { x: 0; width: parent.width * root.progress; height: parent.height; background: Theme.accent; border-radius: 3px; }
            }
            HorizontalLayout {
                Text { text: root.position-text; color: Theme.secondary; font-size: 11px; }
                Rectangle {}
                Text { text: root.duration-text; color: Theme.secondary; font-size: 11px; }
            }
        }
    }

    if root.lyrics-lines.length == 0 : Rectangle {
        height: 140px; border-radius: 8px; background: Theme.panel;
        VerticalLayout {
            alignment: center; spacing: 4px;
            Text { text: "No Lyrics Available"; color: Theme.secondary; font-size: 13px; font-weight: 700; horizontal-alignment: center; }
            Text { text: "Synced lyrics will appear here during playback"; color: Theme.secondary; font-size: 11px; horizontal-alignment: center; }
        }
    }

    if root.lyrics-lines.length > 0 : Rectangle {
        border-radius: 8px; background: Theme.panel; clip: true;
        VerticalLayout {
            padding: 12px; spacing: 8px; alignment: start;
            for line in root.lyrics-lines : Text {
                text: line.text;
                color: line.index == root.active-lyric-index ? Theme.accent : Theme.secondary;
                font-size: line.index == root.active-lyric-index ? 15px : 13px;
                font-weight: line.index == root.active-lyric-index ? 700 : 400;
            }
        }
    }
}

component LibraryItemCard inherits Rectangle {
    in property <string> title; in property <string> subtitle; callback clicked();
    height: 40px; border-radius: 4px; background: touch.has-hover ? Theme.hover : transparent;
    touch := TouchArea { clicked => { root.clicked(); } }
    HorizontalLayout {
        padding-left: 8px; padding-right: 8px; spacing: 12px;
        // Cover-art placeholder (owned by a later tranche)
        Rectangle { width: 32px; height: 32px; border-radius: 4px; background: Theme.surface; Text { text: "Art"; color: Theme.secondary; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; } }
        VerticalLayout {
            alignment: center; spacing: 2px;
            Text { text: root.title; color: Theme.text; font-size: 13px; font-weight: 600; vertical-alignment: center; }
            Text { text: root.subtitle; color: Theme.secondary; font-size: 11px; vertical-alignment: center; }
        }
    }
}

export component LibraryView inherits VerticalLayout {
    in-out property <string> cookie-text: "";
    in property <bool> signed-in: false;
    in property <[LibraryItemData]> playlists: [];
    in property <[LibraryItemData]> albums: [];
    in property <[LibraryItemData]> artists: [];
    callback playlist-selected(int);
    callback album-selected(int);
    callback artist-selected(int);
    callback sign-in-submitted(string);
    callback sign-out();
    spacing: 16px;
    alignment: start;

    Rectangle {
        border-radius: 8px;
        background: Theme.panel;

        VerticalLayout {
            padding: 12px;
            spacing: 8px;

            if !root.signed-in : VerticalLayout {
                spacing: 8px;

                Text {
                    text: "Anonymous — paste cookies to unlock library";
                    color: Theme.secondary;
                    font-size: 13px;
                }

                HorizontalLayout {
                    spacing: 8px;
                    height: 32px;

                    LineEdit {
                        text <=> root.cookie-text;
                        placeholder-text: "Paste session cookies...";
                        input-type: password;
                        accepted(t) => { root.sign-in-submitted(t); }
                    }

                    Rectangle {
                        width: 90px;
                        border-radius: 4px;
                        background: sign-in-btn.has-hover ? Theme.hover : Theme.accent;

                        sign-in-btn := TouchArea {
                            clicked => { root.sign-in-submitted(root.cookie-text); }
                        }

                        Text {
                            text: "Sign in";
                            color: sign-in-btn.has-hover ? Theme.text : Theme.window;
                            font-size: 12px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            if root.signed-in : HorizontalLayout {
                spacing: 12px;
                alignment: space-between;

                Text {
                    text: "Signed in — library unlocked";
                    color: Theme.accent;
                    font-size: 13px;
                    font-weight: 700;
                    vertical-alignment: center;
                }

                Rectangle {
                    width: 90px;
                    height: 28px;
                    border-radius: 4px;
                    background: sign-out-btn.has-hover ? Theme.hover : Theme.surface;

                    sign-out-btn := TouchArea {
                        clicked => { root.sign-out(); }
                    }

                    Text {
                        text: "Sign out";
                        color: Theme.text;
                        font-size: 12px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    VerticalLayout {
        spacing: 6px;
        Text { text: "Playlists"; color: Theme.text; font-size: 16px; font-weight: 700; }
        if root.playlists.length == 0 : Text { text: "No playlists."; color: Theme.secondary; font-size: 13px; }
        for item in root.playlists : LibraryItemCard { title: item.title; subtitle: item.subtitle; clicked => { root.playlist-selected(item.index); } }
    }

    VerticalLayout {
        spacing: 6px;
        Text { text: "Albums"; color: Theme.text; font-size: 16px; font-weight: 700; }
        if root.albums.length == 0 : Text { text: "No albums."; color: Theme.secondary; font-size: 13px; }
        for item in root.albums : LibraryItemCard { title: item.title; subtitle: item.subtitle; clicked => { root.album-selected(item.index); } }
    }

    VerticalLayout {
        spacing: 6px;
        Text { text: "Artists"; color: Theme.text; font-size: 16px; font-weight: 700; }
        if root.artists.length == 0 : Text { text: "No artists."; color: Theme.secondary; font-size: 13px; }
        for item in root.artists : LibraryItemCard { title: item.title; subtitle: item.subtitle; clicked => { root.artist-selected(item.index); } }
    }
}

export component DetailView inherits VerticalLayout {
    in property <bool> has-detail: false; in property <string> title: ""; in property <string> subtitle: "";
    in property <string> kind-label: ""; in property <[TrackRowData]> tracks: [];
    callback track-selected(int);
    spacing: 12px; alignment: start;

    if !root.has-detail : VerticalLayout {
        padding-top: 24px; alignment: center;
        Text { text: "No detail available."; color: Theme.secondary; font-size: 14px; horizontal-alignment: center; }
    }

    if root.has-detail : VerticalLayout {
        spacing: 12px;
        HorizontalLayout {
            spacing: 16px; alignment: start;
            // Cover-art placeholder (owned by a later tranche)
            Rectangle { width: 80px; height: 80px; border-radius: 6px; background: Theme.surface; Text { text: "Cover Art\n(Later Tranche)"; color: Theme.secondary; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; } }
            VerticalLayout {
                spacing: 4px; alignment: center;
                Text { text: root.kind-label; color: Theme.accent; font-size: 12px; font-weight: 700; }
                Text { text: root.title; color: Theme.text; font-size: 20px; font-weight: 700; }
                if root.subtitle != "" : Text { text: root.subtitle; color: Theme.secondary; font-size: 13px; }
            }
        }
        Rectangle { height: 1px; background: Theme.border; }
        if root.tracks.length == 0 : VerticalLayout {
            padding-top: 16px; alignment: center;
            Text { text: "No tracks in detail."; color: Theme.secondary; font-size: 13px; horizontal-alignment: center; }
        }
        for track in root.tracks : TrackRow {
            title: track.title;
            artist: track.artist;
            album: track.album;
            duration: track.duration;
            kind: track.kind;
            cover: track.cover;
            clicked => { root.track-selected(track.index); }
        }
    }
}

component ContentArea inherits Rectangle {
    in property <int> active-page: 0;
    in property <string> header-title: "Search";
    in-out property <string> query: "";
    in-out property <string> cookie-text: "";
    in property <bool> signed-in: false;
    in property <[ShelfData]> shelves: [];
    in property <int> search-filter: 0;
    in property <[TrackRowData]> queue-tracks: [];
    in property <int> queue-selected-index: -1;
    in property <string> active-track-title: "No track playing";
    in property <string> active-track-artist: "";
    in property <string> position-text: "0:00";
    in property <string> duration-text: "0:00";
    in property <float> playback-progress: 0.0;
    in property <image> cover-image;
    in property <bool> has-cover: false;
    in property <[LyricLineData]> lyrics-lines: [];
    in property <int> active-lyric-index: -1;
    in property <[LibraryItemData]> library-playlists: []; in property <[LibraryItemData]> library-albums: []; in property <[LibraryItemData]> library-artists: [];
    in property <bool> detail-has-detail: false; in property <string> detail-title: ""; in property <string> detail-subtitle: "";
    in property <string> detail-kind-label: ""; in property <[TrackRowData]> detail-tracks: [];

    callback query-submitted(string);
    callback track-selected(int);
    callback filter-selected(int);
    callback queue-track-selected(int);
    callback playlist-selected(int); callback album-selected(int); callback artist-selected(int); callback detail-track-selected(int);
    callback sign-in-submitted(string);
    callback sign-out();

    background: Theme.window;

    VerticalLayout {
        padding: 24px;
        spacing: 16px;
        alignment: start;

        Text {
            text: root.header-title;
            color: Theme.text;
            font-size: 24px;
            font-weight: 700;
        }

        Rectangle {
            height: 1px;
            background: Theme.border;
        }

        if root.active-page == 0 : SearchView {
            query <=> root.query;
            shelves: root.shelves;
            active-filter: root.search-filter;
            query-submitted(q) => { root.query-submitted(q); }
            track-selected(idx) => { root.track-selected(idx); }
            filter-selected(idx) => { root.filter-selected(idx); }
        }

        if root.active-page == 1 : QueueView {
            tracks: root.queue-tracks;
            selected-index: root.queue-selected-index;
            track-selected(idx) => { root.queue-track-selected(idx); }
        }

        if root.active-page == 2 : NowPlayingView {
            track-title: root.active-track-title;
            track-artist: root.active-track-artist;
            position-text: root.position-text;
            duration-text: root.duration-text;
            progress: root.playback-progress;
            cover-image: root.cover-image;
            has-cover: root.has-cover;
            lyrics-lines: root.lyrics-lines;
            active-lyric-index: root.active-lyric-index;
        }

        if root.active-page == 3 : LibraryView {
            cookie-text <=> root.cookie-text;
            signed-in: root.signed-in;
            playlists: root.library-playlists; albums: root.library-albums; artists: root.library-artists;
            playlist-selected(idx) => { root.playlist-selected(idx); }
            album-selected(idx) => { root.album-selected(idx); }
            artist-selected(idx) => { root.artist-selected(idx); }
            sign-in-submitted(t) => { root.sign-in-submitted(t); }
            sign-out() => { root.sign-out(); }
        }

        if root.active-page == 4 : DetailView {
            has-detail: root.detail-has-detail; title: root.detail-title; subtitle: root.detail-subtitle;
            kind-label: root.detail-kind-label; tracks: root.detail-tracks;
            track-selected(idx) => { root.detail-track-selected(idx); }
        }
    }
}

export component MoggytWindow inherits Window {
    title: "Moggyt";
    min-width: 800px;
    min-height: 500px;
    preferred-width: 1024px;
    preferred-height: 640px;
    background: Theme.window;

    in-out property <color> theme-window <=> Theme.window;
    in-out property <color> theme-panel <=> Theme.panel;
    in-out property <color> theme-surface <=> Theme.surface;
    in-out property <color> theme-text <=> Theme.text;
    in-out property <color> theme-secondary <=> Theme.secondary;
    in-out property <color> theme-accent <=> Theme.accent;
    in-out property <color> theme-border <=> Theme.border;
    in-out property <color> theme-hover <=> Theme.hover;
    in-out property <color> theme-overlay <=> Theme.overlay;
    in-out property <bool> theme-dark <=> Theme.dark;

    in-out property <int> active-page: 0;
    in-out property <string> header-title: "Search";
    in-out property <string> query: "";
    in-out property <string> cookie-text: "";
    in-out property <bool> signed-in: false;
    in-out property <[ShelfData]> shelves: [];
    in-out property <int> search-filter: 0;
    in-out property <[TrackRowData]> queue-tracks: [];
    in-out property <int> queue-selected-index: -1;
    in-out property <string> active-track-title: "No track playing";
    in-out property <string> active-track-artist: "";
    in-out property <bool> is-playing: false;
    in-out property <int> volume: 100;
    in-out property <string> position-text: "0:00";
    in-out property <string> duration-text: "0:00";
    in-out property <float> playback-progress: 0.0;
    in-out property <image> cover-image;
    in-out property <image> now-playing-cover;
    in-out property <bool> has-cover: false;
    in-out property <bool> is-liked: false;
    in-out property <bool> is-shuffle: false;
    in-out property <int> repeat-mode: 0;
    in-out property <int> position-secs: 0;
    in-out property <int> duration-secs: 0;
    in-out property <int> queue-count: 0;
    in-out property <[LyricLineData]> lyrics-lines: [];
    in-out property <int> active-lyric-index: -1;
    in-out property <[LibraryItemData]> library-playlists: []; in-out property <[LibraryItemData]> library-albums: []; in-out property <[LibraryItemData]> library-artists: [];
    in-out property <bool> detail-has-detail: false; in-out property <string> detail-title: ""; in-out property <string> detail-subtitle: "";
    in-out property <string> detail-kind-label: ""; in-out property <[TrackRowData]> detail-tracks: [];

    callback page-selected(int);
    callback query-submitted(string);
    callback track-selected(int);
    callback filter-selected(int);
    callback queue-track-selected(int);
    callback playlist-selected(int); callback album-selected(int); callback artist-selected(int); callback detail-track-selected(int);
    callback sign-in-submitted(string);
    callback sign-out();
    callback toggle-play();
    callback prev-track();
    callback next-track();
    callback seek-by(int);
    callback seek-to(int);
    callback set-volume(int);
    callback toggle-like();
    callback toggle-shuffle();
    callback cycle-repeat();
    callback open-queue();

    VerticalLayout {
        padding: 0;
        spacing: 0;

        HorizontalLayout {
            padding: 0;
            spacing: 0;

            Sidebar {
                active-page: root.active-page;
                page-selected(idx) => { root.page-selected(idx); }
            }

            ContentArea {
                active-page: root.active-page; header-title: root.header-title; query <=> root.query; shelves: root.shelves;
                search-filter: root.search-filter;
                cookie-text <=> root.cookie-text; signed-in: root.signed-in;
                queue-tracks: root.queue-tracks; queue-selected-index: root.queue-selected-index;
                active-track-title: root.active-track-title; active-track-artist: root.active-track-artist;
                position-text: root.position-text; duration-text: root.duration-text; playback-progress: root.playback-progress;
                cover-image: root.cover-image; has-cover: root.has-cover;
                lyrics-lines: root.lyrics-lines; active-lyric-index: root.active-lyric-index;
                library-playlists: root.library-playlists; library-albums: root.library-albums; library-artists: root.library-artists;
                detail-has-detail: root.detail-has-detail; detail-title: root.detail-title; detail-subtitle: root.detail-subtitle;
                detail-kind-label: root.detail-kind-label; detail-tracks: root.detail-tracks;
                query-submitted(q) => { root.query-submitted(q); } track-selected(idx) => { root.track-selected(idx); }
                filter-selected(idx) => { root.filter-selected(idx); }
                queue-track-selected(idx) => { root.queue-track-selected(idx); }
                playlist-selected(idx) => { root.playlist-selected(idx); } album-selected(idx) => { root.album-selected(idx); }
                artist-selected(idx) => { root.artist-selected(idx); } detail-track-selected(idx) => { root.detail-track-selected(idx); }
                sign-in-submitted(t) => { root.sign-in-submitted(t); } sign-out() => { root.sign-out(); }
            }
        }

        PlayerBar {
            active-track-title: root.active-track-title;
            active-track-artist: root.active-track-artist;
            is-playing: root.is-playing;
            volume: root.volume;
            position-text: root.position-text;
            duration-text: root.duration-text;
            cover: root.now-playing-cover;
            is-liked: root.is-liked;
            is-shuffle: root.is-shuffle;
            repeat-mode: root.repeat-mode;
            progress: root.playback-progress;
            position-secs: root.position-secs;
            duration-secs: root.duration-secs;
            queue-count: root.queue-count;

            toggle-play => { root.toggle-play(); }
            prev-track => { root.prev-track(); }
            next-track => { root.next-track(); }
            seek-by(delta) => { root.seek-by(delta); }
            seek-to(secs) => { root.seek-to(secs); }
            set-volume(vol) => { root.set-volume(vol); }
            toggle-like => { root.toggle-like(); }
            toggle-shuffle => { root.toggle-shuffle(); }
            cycle-repeat => { root.cycle-repeat(); }
            open-queue => { root.open-queue(); }
        }
    }
}
