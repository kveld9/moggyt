component NavItem inherits Rectangle {
    in property <string> text;
    in property <string> icon-name: "";
    in property <bool> is-active: false;
    callback clicked();

    height: 40px;
    border-radius: 8px;
    background: root.is-active ? Theme.surface : (touch.pressed ? Theme.overlay : (touch.has-hover ? Theme.hover : transparent));
    animate background { duration: 150ms; easing: ease-in-out; }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 20px;
        padding-right: 16px;
        spacing: 12px;
        alignment: start;

        VerticalLayout {
            alignment: center;
            if root.icon-name == "search" : IconSearch {
                size: 18px;
                tint: root.is-active ? Theme.accent : (touch.has-hover ? Theme.text : Theme.secondary);
            }
            if root.icon-name == "library" : IconLibrary {
                size: 18px;
                tint: root.is-active ? Theme.accent : (touch.has-hover ? Theme.text : Theme.secondary);
            }
            if root.icon-name == "music" : IconMusic {
                size: 18px;
                tint: root.is-active ? Theme.accent : (touch.has-hover ? Theme.text : Theme.secondary);
            }
            if root.icon-name == "settings" : IconSettings {
                size: 18px;
                tint: root.is-active ? Theme.accent : (touch.has-hover ? Theme.text : Theme.secondary);
            }
        }

        Text {
            text: root.text;
            color: root.is-active ? Theme.text : (touch.has-hover ? Theme.text : Theme.secondary);
            font-size: 14px;
            font-weight: root.is-active ? 700 : 500;
            vertical-alignment: center;
        }
    }
}

component Sidebar inherits Rectangle {
    in property <int> active-page: 0;
    in property <string> nav-search-label: "Search";
    in property <string> nav-library-label: "Library";
    in property <string> nav-now-playing-label: "Now Playing";
    callback page-selected(int);

    width: 200px;
    background: Theme.panel;

    VerticalLayout {
        padding: 16px;
        spacing: 8px;
        alignment: start;

        Text {
            text: "Moggyt";
            color: Theme.accent;
            font-size: 20px;
            font-weight: 800;
        }

        Rectangle { height: 12px; }

        NavItem {
            text: root.nav-search-label;
            icon-name: "search";
            is-active: root.active-page == 0;
            clicked => { root.page-selected(0); }
        }

        NavItem {
            text: root.nav-library-label;
            icon-name: "library";
            is-active: root.active-page == 3;
            clicked => { root.page-selected(3); }
        }

        NavItem {
            text: root.nav-now-playing-label;
            icon-name: "music";
            is-active: root.active-page == 2;
            clicked => { root.page-selected(2); }
        }
    }
}

component StyledInputField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder-text: "";
    in property <InputType> input-type: InputType.text;
    out property <bool> has-focus: input.has-focus;
    callback accepted(string);

    border-radius: 8px;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.border;
    background: Theme.surface;
    animate border-color { duration: 150ms; easing: ease-in-out; }
    forward-focus: input;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        alignment: start;

        input := TextInput {
            horizontal-stretch: 1;
            text <=> root.text;
            input-type: root.input-type;
            color: Theme.text;
            vertical-alignment: center;
            accepted => { root.accepted(self.text); }
        }
    }

    if root.text == "" && !input.has-focus : Text {
        x: 10px;
        y: 0;
        width: parent.width - 20px;
        height: parent.height;
        text: root.placeholder-text;
        color: Theme.secondary;
        vertical-alignment: center;
    }
}

component FilterChip inherits Rectangle {
    in property <string> text;
    in property <bool> is-active: false;
    callback clicked();

    height: 28px;
    border-radius: 14px;
    background: root.is-active ? (touch.pressed ? Theme.overlay : Theme.accent) : (touch.pressed ? Theme.overlay : (touch.has-hover ? Theme.hover : Theme.surface));
    animate background { duration: 150ms; easing: ease-in-out; }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        alignment: center;

        Text {
            text: root.text;
            color: root.is-active ? Theme.window : (touch.has-hover ? Theme.text : Theme.secondary);
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
}

component TrackRow inherits Rectangle {
    in property <string> title;
    in property <string> artist;
    in property <string> album;
    in property <string> duration;
    in property <string> kind;
    in property <image> cover;
    in property <bool> is-active: false;
    callback clicked();

    property <string> subtitle-text: root.album != "" && root.artist != "" ? root.artist + " - " + root.album : (
        root.artist != "" ? root.artist : root.album
    );

    height: 56px;
    border-radius: 8px;
    background: root.is-active ? (touch.pressed ? Theme.overlay : Theme.surface) : (touch.pressed ? Theme.overlay : (touch.has-hover ? Theme.hover : transparent));
    animate background { duration: 150ms; easing: ease-in-out; }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 40px;
                height: 40px;
                border-radius: 6px;
                background: Theme.surface;
                clip: true;

                Image {
                    width: parent.width;
                    height: parent.height;
                    source: root.cover;
                    image-fit: ImageFit.cover;
                }
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;

            Text {
                text: root.title;
                color: root.is-active ? Theme.accent : Theme.text;
                font-size: 14px;
                font-weight: 600;
                overflow: elide;
                vertical-alignment: center;
            }

            if root.subtitle-text != "" : Text {
                text: root.subtitle-text;
                color: Theme.secondary;
                font-size: 12px;
                overflow: elide;
                vertical-alignment: center;
            }
        }

        if root.duration != "" : Text {
            text: root.duration;
            color: Theme.secondary;
            font-size: 12px;
            font-weight: 500;
            vertical-alignment: center;
            horizontal-alignment: right;
        }
    }
}

component SearchView inherits VerticalLayout {
    in-out property <string> query: "";
    in property <[ShelfData]> shelves: [];
    in property <int> active-filter: 0;
    in property <string> placeholder-text: "Search songs...";
    in property <string> search-button-label: "Search";
    in property <string> filter-all-label: "All";
    in property <string> filter-songs-label: "Songs";
    in property <string> filter-albums-label: "Albums";
    in property <string> filter-artists-label: "Artists";
    in property <string> filter-playlists-label: "Playlists";
    in property <string> empty-text: "No results found.";
    callback query-submitted(string);
    callback track-selected(int);
    callback filter-selected(int);
    forward-focus: input;

    spacing: 16px;
    alignment: start;

    HorizontalLayout {
        spacing: 8px;
        height: 36px;

        search-box := Rectangle {
            horizontal-stretch: 1;
            border-radius: 8px;
            border-width: 1px;
            border-color: input.has-focus ? Theme.accent : Theme.border;
            background: Theme.surface;
            animate border-color { duration: 150ms; easing: ease-in-out; }

            search-touch := TouchArea {
                clicked => { input.focus(); }
            }

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 8px;
                spacing: 8px;

                VerticalLayout {
                    alignment: center;
                    IconSearch {
                        size: 16px;
                        tint: input.has-focus ? Theme.accent : Theme.secondary;
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                    clip: true;

                    input := TextInput {
                        width: parent.width;
                        height: parent.height;
                        text <=> root.query;
                        color: Theme.text;
                        vertical-alignment: center;
                        accepted => {
                            root.query-submitted(self.text);
                        }
                    }

                    if root.query == "" && !input.has-focus : Text {
                        width: parent.width;
                        height: parent.height;
                        text: root.placeholder-text;
                        color: Theme.secondary;
                        vertical-alignment: center;

                        TouchArea {
                            clicked => { input.focus(); }
                        }
                    }
                }

                if root.query != "" : VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 20px;
                        height: 20px;
                        border-radius: 10px;
                        background: clear-touch.has-hover ? Theme.hover : transparent;

                        clear-touch := TouchArea {
                            clicked => {
                                root.query = "";
                                input.focus();
                            }
                        }

                        IconClose {
                            size: 10px;
                            tint: clear-touch.has-hover ? Theme.text : Theme.secondary;
                        }
                    }
                }
            }
        }

        Rectangle {
            width: 92px;
            border-radius: 8px;
            background: btn-touch.pressed ? Theme.overlay : (btn-touch.has-hover ? Theme.hover : Theme.accent);
            animate background { duration: 150ms; easing: ease-in-out; }

            btn-touch := TouchArea {
                clicked => { root.query-submitted(root.query); }
            }

            HorizontalLayout {
                alignment: center;
                spacing: 6px;

                VerticalLayout {
                    alignment: center;
                    IconSearch {
                        size: 16px;
                        tint: btn-touch.has-hover ? Theme.text : Theme.window;
                    }
                }

                Text {
                    text: root.search-button-label;
                    color: btn-touch.has-hover ? Theme.text : Theme.window;
                    font-size: 13px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
            }
        }
    }

    HorizontalLayout {
        spacing: 8px;
        alignment: start;

        FilterChip {
            text: root.filter-all-label;
            is-active: root.active-filter == 0;
            clicked => { root.filter-selected(0); }
        }
        FilterChip {
            text: root.filter-songs-label;
            is-active: root.active-filter == 1;
            clicked => { root.filter-selected(1); }
        }
        FilterChip {
            text: root.filter-albums-label;
            is-active: root.active-filter == 2;
            clicked => { root.filter-selected(2); }
        }
        FilterChip {
            text: root.filter-artists-label;
            is-active: root.active-filter == 3;
            clicked => { root.filter-selected(3); }
        }
        FilterChip {
            text: root.filter-playlists-label;
            is-active: root.active-filter == 4;
            clicked => { root.filter-selected(4); }
        }
    }

    if root.shelves.length == 0 : VerticalLayout {
        padding-top: 24px;
        alignment: center;

        Text {
            text: root.empty-text;
            color: Theme.secondary;
            font-size: 14px;
            horizontal-alignment: center;
        }
    }

    for shelf in root.shelves : VerticalLayout {
        spacing: 8px;
        alignment: start;

        Text {
            text: shelf.title;
            color: Theme.text;
            font-size: 18px;
            font-weight: 700;
        }

        for track in shelf.tracks : TrackRow {
            title: track.title;
            artist: track.artist;
            album: track.album;
            duration: track.duration;
            kind: track.kind;
            cover: track.cover;
            clicked => {
                root.track-selected(track.index);
            }
        }
    }
}

component PlayerBar inherits Rectangle {
    in property <string> active-track-title: "No track playing";
    in property <string> active-track-artist: "";
    in property <bool> is-playing: false;
    in property <int> volume: 100;
    in property <string> position-text: "0:00";
    in property <string> duration-text: "0:00";
    in property <image> cover;
    in property <bool> is-liked: false;
    in property <bool> is-shuffle: false;
    in property <int> repeat-mode: 0;
    in property <float> progress: 0.0;
    in property <int> position-secs: 0;
    in property <int> duration-secs: 0;
    in property <int> queue-count: 0;
    in property <string> queue-button-text: "Queue";

    callback toggle-play();
    callback prev-track();
    callback next-track();
    callback seek-by(int);
    callback seek-to(int);
    callback set-volume(int);
    callback toggle-like();
    callback toggle-shuffle();
    callback cycle-repeat();
    callback open-queue();

    height: 72px;
    background: Theme.panel;

    Rectangle {
        y: 0;
        height: 1px;
        background: Theme.border;
    }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 16px;
        alignment: space-between;

        // LEFT ZONE: Artwork, Title + Artist, Like toggle
        HorizontalLayout {
            width: 240px;
            spacing: 12px;
            alignment: start;

            Rectangle {
                width: 44px;
                height: 44px;
                border-radius: 6px;
                background: Theme.surface;
                clip: true;

                Image {
                    width: parent.width;
                    height: parent.height;
                    source: root.cover;
                    image-fit: ImageFit.cover;
                }
            }

            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 2px;

                Text {
                    text: root.active-track-title;
                    color: Theme.text;
                    font-size: 13px;
                    font-weight: 700;
                    overflow: elide;
                }

                if root.active-track-artist != "" : Text {
                    text: root.active-track-artist;
                    color: Theme.secondary;
                    font-size: 11px;
                    overflow: elide;
                }
            }

            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 36px;
                    height: 36px;
                    border-radius: 18px;
                    background: like-touch.pressed ? Theme.overlay : (like-touch.has-hover ? Theme.hover : (root.is-liked ? Theme.surface : transparent));
                    animate background { duration: 150ms; easing: ease-in-out; }

                    like-touch := TouchArea {
                        clicked => { root.toggle-like(); }
                    }

                    IconHeart {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        tint: root.is-liked ? Theme.accent : (like-touch.has-hover ? Theme.text : Theme.secondary);
                        size: 18px;
                        is-filled: root.is-liked;
                    }
                }
            }
        }

        // CENTER ZONE: Shuffle, Prev, -10s, Play/Pause, +10s, Next, Repeat + Progress row
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 4px;

            HorizontalLayout {
                spacing: 8px;
                alignment: center;

                Rectangle {
                    width: 36px;
                    height: 36px;
                    border-radius: 18px;
                    background: shuf-touch.pressed ? Theme.overlay : (root.is-shuffle ? Theme.surface : (shuf-touch.has-hover ? Theme.hover : transparent));
                    animate background { duration: 150ms; easing: ease-in-out; }

                    shuf-touch := TouchArea {
                        clicked => { root.toggle-shuffle(); }
                    }

                    IconShuffle {
                        tint: root.is-shuffle ? Theme.accent : (shuf-touch.has-hover ? Theme.text : Theme.secondary);
                        size: 18px;
                    }
                }

                Rectangle {
                    width: 36px;
                    height: 36px;
                    border-radius: 18px;
                    background: pt.pressed ? Theme.overlay : (pt.has-hover ? Theme.hover : transparent);
                    animate background { duration: 150ms; easing: ease-in-out; }

                    pt := TouchArea {
                        clicked => { root.prev-track(); }
                    }

                    IconPrev {
                        tint: pt.has-hover ? Theme.text : Theme.secondary;
                        size: 18px;
                    }
                }

                Rectangle {
                    height: 28px;
                    border-radius: 14px;
                    background: s10m-touch.pressed ? Theme.overlay : (s10m-touch.has-hover ? Theme.hover : transparent);
                    animate background { duration: 150ms; easing: ease-in-out; }

                    s10m-touch := TouchArea {
                        clicked => { root.seek-by(-10); }
                    }

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        alignment: center;

                        Text {
                            text: "-10s";
                            color: s10m-touch.has-hover ? Theme.text : Theme.secondary;
                            font-size: 11px;
                            font-weight: 600;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                    }
                }

                Rectangle {
                    width: 40px;
                    height: 40px;
                    border-radius: 20px;
                    background: pp.pressed ? Theme.overlay : (pp.has-hover ? Theme.hover : Theme.accent);
                    animate background { duration: 150ms; easing: ease-in-out; }

                    pp := TouchArea {
                        clicked => { root.toggle-play(); }
                    }

                    if root.is-playing : IconPause {
                        tint: pp.has-hover ? Theme.text : Theme.window;
                        size: 20px;
                    }
                    if !root.is-playing : IconPlay {
                        tint: pp.has-hover ? Theme.text : Theme.window;
                        size: 20px;
                    }
                }

                Rectangle {
                    height: 28px;
                    border-radius: 14px;
                    background: s10p-touch.pressed ? Theme.overlay : (s10p-touch.has-hover ? Theme.hover : transparent);
                    animate background { duration: 150ms; easing: ease-in-out; }

                    s10p-touch := TouchArea {
                        clicked => { root.seek-by(10); }
                    }

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        alignment: center;

                        Text {
                            text: "+10s";
                            color: s10p-touch.has-hover ? Theme.text : Theme.secondary;
                            font-size: 11px;
                            font-weight: 600;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                    }
                }

                Rectangle {
                    width: 36px;
                    height: 36px;
                    border-radius: 18px;
                    background: nt.pressed ? Theme.overlay : (nt.has-hover ? Theme.hover : transparent);
                    animate background { duration: 150ms; easing: ease-in-out; }

                    nt := TouchArea {
                        clicked => { root.next-track(); }
                    }

                    IconNext {
                        tint: nt.has-hover ? Theme.text : Theme.secondary;
                        size: 18px;
                    }
                }

                Rectangle {
                    width: 36px;
                    height: 36px;
                    border-radius: 18px;
                    background: rep-touch.pressed ? Theme.overlay : (root.repeat-mode != 0 ? Theme.surface : (rep-touch.has-hover ? Theme.hover : transparent));
                    animate background { duration: 150ms; easing: ease-in-out; }

                    rep-touch := TouchArea {
                        clicked => { root.cycle-repeat(); }
                    }

                    if root.repeat-mode == 2 : IconRepeatOne {
                        tint: Theme.accent;
                        size: 18px;
                    }
                    if root.repeat-mode != 2 : IconRepeat {
                        tint: root.repeat-mode != 0 ? Theme.accent : (rep-touch.has-hover ? Theme.text : Theme.secondary);
                        size: 18px;
                    }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: center;

                Text {
                    text: root.position-text;
                    color: Theme.secondary;
                    font-size: 11px;
                    vertical-alignment: center;
                }

                ThemedSlider {
                    horizontal-stretch: 1;
                    minimum: 0;
                    maximum: max(1, root.duration-secs);
                    value: min(root.position-secs, max(1, root.duration-secs));
                    enabled: root.duration-secs > 0;
                    changed(val) => {
                        root.seek-to(round(val));
                    }
                }

                Text {
                    text: root.duration-text;
                    color: Theme.secondary;
                    font-size: 11px;
                    vertical-alignment: center;
                }
            }
        }

        // RIGHT ZONE: Queue button, Volume Slider + percentage
        HorizontalLayout {
            width: 240px;
            alignment: end;
            spacing: 10px;

            Rectangle {
                height: 32px;
                border-radius: 16px;
                background: q-touch.pressed ? Theme.overlay : (q-touch.has-hover ? Theme.hover : Theme.surface);
                animate background { duration: 150ms; easing: ease-in-out; }

                q-touch := TouchArea {
                    clicked => { root.open-queue(); }
                }

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 12px;
                    spacing: 6px;
                    alignment: center;

                    VerticalLayout {
                        alignment: center;
                        IconQueue {
                            size: 16px;
                            tint: q-touch.has-hover ? Theme.accent : Theme.text;
                        }
                    }

                    Text {
                        text: root.queue-button-text;
                        color: q-touch.has-hover ? Theme.accent : Theme.text;
                        font-size: 11px;
                        font-weight: 700;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                IconSpeaker {
                    size: 16px;
                    tint: Theme.secondary;
                }
            }

            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 24px;
                    height: 24px;
                    border-radius: 12px;
                    background: vm-touch.pressed ? Theme.overlay : (vm-touch.has-hover ? Theme.hover : transparent);
                    animate background { duration: 150ms; easing: ease-in-out; }

                    vm-touch := TouchArea {
                        clicked => { root.set-volume(max(0, root.volume - 5)); }
                    }

                    IconMinus {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        size: 14px;
                        tint: vm-touch.has-hover ? Theme.text : Theme.secondary;
                    }
                }
            }

            ThemedSlider {
                width: 80px;
                minimum: 0;
                maximum: 100;
                value: root.volume;
                changed(val) => {
                    root.set-volume(round(val));
                }
            }

            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 24px;
                    height: 24px;
                    border-radius: 12px;
                    background: vp-touch.pressed ? Theme.overlay : (vp-touch.has-hover ? Theme.hover : transparent);
                    animate background { duration: 150ms; easing: ease-in-out; }

                    vp-touch := TouchArea {
                        clicked => { root.set-volume(min(100, root.volume + 5)); }
                    }

                    IconPlus {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        size: 14px;
                        tint: vp-touch.has-hover ? Theme.text : Theme.secondary;
                    }
                }
            }

            Text {
                text: "\{root.volume}%";
                color: Theme.secondary;
                font-size: 11px;
                width: 34px;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }
    }
}

component QueueView inherits VerticalLayout {
    in property <[TrackRowData]> tracks: [];
    in property <int> selected-index: -1;
    in property <string> empty-text: "The queue is empty.";
    callback track-selected(int);

    spacing: 8px; alignment: start;
    if root.tracks.length == 0 : VerticalLayout {
        padding-top: 24px; alignment: center;
        Text { text: root.empty-text; color: Theme.secondary; font-size: 14px; horizontal-alignment: center; }
    }
    for track in root.tracks : TrackRow {
        title: track.title;
        artist: track.artist;
        album: track.album;
        duration: track.duration;
        kind: track.kind;
        cover: track.cover;
        is-active: track.index == root.selected-index;
        clicked => { root.track-selected(track.index); }
    }
}

component NowPlayingView inherits VerticalLayout {
    in property <string> track-title: "No track playing";
    in property <string> track-artist: "";
    in property <string> position-text: "0:00";
    in property <string> duration-text: "0:00";
    in property <float> progress: 0.0;
    in property <image> cover-image;
    in property <bool> has-cover: false;
    in property <[LyricLineData]> lyrics-lines: [];
    in property <int> active-lyric-index: -1;
    in property <string> no-cover-text: "No cover";
    in property <string> lyrics-unavailable-text: "Lyrics unavailable";
    in property <string> lyrics-hint-text: "Synchronized lyrics will appear during playback";

    spacing: 16px; alignment: start;

    HorizontalLayout {
        spacing: 20px; alignment: start;
        Rectangle {
            width: 140px; height: 140px; border-radius: 8px; background: Theme.surface; clip: true;
            if root.has-cover : Image {
                width: parent.width; height: parent.height;
                source: root.cover-image;
                image-fit: cover;
            }
            if !root.has-cover : Text {
                text: root.no-cover-text; color: Theme.secondary; font-size: 12px;
                horizontal-alignment: center; vertical-alignment: center;
            }
        }
        VerticalLayout {
            spacing: 6px; alignment: center;
            Text { text: root.track-title; color: Theme.text; font-size: 20px; font-weight: 700; }
            Text { text: root.track-artist; color: Theme.secondary; font-size: 14px; }
            Rectangle { height: 6px; }
            // Progress bar
            Rectangle {
                height: 6px; border-radius: 3px; background: Theme.surface; clip: true;
                Rectangle { x: 0; width: parent.width * root.progress; height: parent.height; background: Theme.accent; border-radius: 3px; }
            }
            HorizontalLayout {
                Text { text: root.position-text; color: Theme.secondary; font-size: 11px; }
                Rectangle {}
                Text { text: root.duration-text; color: Theme.secondary; font-size: 11px; }
            }
        }
    }

    if root.lyrics-lines.length == 0 : Rectangle {
        height: 140px; border-radius: 8px; background: Theme.panel;
        VerticalLayout {
            alignment: center; spacing: 4px;
            Text { text: root.lyrics-unavailable-text; color: Theme.secondary; font-size: 13px; font-weight: 700; horizontal-alignment: center; }
            Text { text: root.lyrics-hint-text; color: Theme.secondary; font-size: 11px; horizontal-alignment: center; }
        }
    }

    if root.lyrics-lines.length > 0 : Rectangle {
        border-radius: 8px; background: Theme.panel; clip: true;
        VerticalLayout {
            padding: 12px; spacing: 8px; alignment: start;
            for line in root.lyrics-lines : Text {
                text: line.text;
                color: line.index == root.active-lyric-index ? Theme.accent : Theme.secondary;
                font-size: line.index == root.active-lyric-index ? 15px : 13px;
                font-weight: line.index == root.active-lyric-index ? 700 : 400;
            }
        }
    }
}

component LibraryItemCard inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <image> cover;
    callback clicked();

    height: 48px;
    border-radius: 8px;
    background: touch.pressed ? Theme.overlay : (touch.has-hover ? Theme.hover : transparent);
    animate background { duration: 150ms; easing: ease-in-out; }

    touch := TouchArea { clicked => { root.clicked(); } }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 12px;

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 36px;
                height: 36px;
                border-radius: 6px;
                background: Theme.surface;
                clip: true;

                Image {
                    width: parent.width;
                    height: parent.height;
                    source: root.cover;
                    image-fit: ImageFit.cover;
                }
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 2px;

            Text {
                text: root.title;
                color: Theme.text;
                font-size: 13px;
                font-weight: 600;
                vertical-alignment: center;
            }

            Text {
                text: root.subtitle;
                color: Theme.secondary;
                font-size: 11px;
                vertical-alignment: center;
            }
        }
    }
}

component LibraryView inherits VerticalLayout {
    in-out property <string> cookie-text: "";
    in property <bool> signed-in: false;
    in property <[LibraryItemData]> playlists: [];
    in property <[LibraryItemData]> albums: [];
    in property <[LibraryItemData]> artists: [];
    in property <string> session-anonymous-hint: "Anonymous session: paste cookies to unlock library";
    in property <string> session-cookie-placeholder: "Paste session cookies...";
    in property <string> sign-in-label: "Sign in";
    in property <string> session-signed-in-hint: "Signed in: library unlocked";
    in property <string> sign-out-label: "Sign out";
    in property <string> section-playlists-label: "Playlists";
    in property <string> empty-playlists-text: "No playlists found.";
    in property <string> section-albums-label: "Albums";
    in property <string> empty-albums-text: "No albums found.";
    in property <string> section-artists-label: "Artists";
    in property <string> empty-artists-text: "No artists found.";
    callback playlist-selected(int);
    callback album-selected(int);
    callback artist-selected(int);
    callback sign-in-submitted(string);
    callback sign-out();
    spacing: 16px;
    alignment: start;

    Rectangle {
        border-radius: 8px;
        background: Theme.panel;

        VerticalLayout {
            padding: 12px;
            spacing: 8px;

            if !root.signed-in : VerticalLayout {
                spacing: 8px;

                Text {
                    text: root.session-anonymous-hint;
                    color: Theme.secondary;
                    font-size: 13px;
                }

                HorizontalLayout {
                    spacing: 8px;
                    height: 32px;

                    StyledInputField {
                        text <=> root.cookie-text;
                        placeholder-text: root.session-cookie-placeholder;
                        input-type: InputType.password;
                        accepted(t) => { root.sign-in-submitted(t); }
                    }

                    Rectangle {
                        width: 90px;
                        border-radius: 8px;
                        background: sign-in-btn.pressed ? Theme.overlay : (sign-in-btn.has-hover ? Theme.hover : Theme.accent);
                        animate background { duration: 150ms; easing: ease-in-out; }

                        sign-in-btn := TouchArea {
                            clicked => { root.sign-in-submitted(root.cookie-text); }
                        }

                        Text {
                            text: root.sign-in-label;
                            color: sign-in-btn.has-hover ? Theme.text : Theme.window;
                            font-size: 12px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            if root.signed-in : HorizontalLayout {
                spacing: 12px;
                alignment: space-between;

                Text {
                    text: root.session-signed-in-hint;
                    color: Theme.accent;
                    font-size: 13px;
                    font-weight: 700;
                    vertical-alignment: center;
                }

                Rectangle {
                    width: 90px;
                    height: 32px;
                    border-radius: 8px;
                    background: sign-out-btn.pressed ? Theme.overlay : (sign-out-btn.has-hover ? Theme.hover : Theme.surface);
                    animate background { duration: 150ms; easing: ease-in-out; }

                    sign-out-btn := TouchArea {
                        clicked => { root.sign-out(); }
                    }

                    Text {
                        text: root.sign-out-label;
                        color: Theme.text;
                        font-size: 12px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    VerticalLayout {
        spacing: 6px;
        Text { text: root.section-playlists-label; color: Theme.text; font-size: 16px; font-weight: 700; }
        if root.playlists.length == 0 : Text { text: root.empty-playlists-text; color: Theme.secondary; font-size: 13px; }
        for item in root.playlists : LibraryItemCard { title: item.title; subtitle: item.subtitle; cover: item.cover; clicked => { root.playlist-selected(item.index); } }
    }

    VerticalLayout {
        spacing: 6px;
        Text { text: root.section-albums-label; color: Theme.text; font-size: 16px; font-weight: 700; }
        if root.albums.length == 0 : Text { text: root.empty-albums-text; color: Theme.secondary; font-size: 13px; }
        for item in root.albums : LibraryItemCard { title: item.title; subtitle: item.subtitle; cover: item.cover; clicked => { root.album-selected(item.index); } }
    }

    VerticalLayout {
        spacing: 6px;
        Text { text: root.section-artists-label; color: Theme.text; font-size: 16px; font-weight: 700; }
        if root.artists.length == 0 : Text { text: root.empty-artists-text; color: Theme.secondary; font-size: 13px; }
        for item in root.artists : LibraryItemCard { title: item.title; subtitle: item.subtitle; cover: item.cover; clicked => { root.artist-selected(item.index); } }
    }
}

component DetailView inherits VerticalLayout {
    in property <bool> has-detail: false;
    in property <string> title: "";
    in property <string> subtitle: "";
    in property <string> kind-label: "";
    in property <image> cover;
    in property <[TrackRowData]> tracks: [];
    in property <string> empty-text: "No details available.";
    in property <string> no-cover-text: "No cover";
    in property <string> play-button-label: "Play";
    in property <string> shuffle-button-label: "Shuffle";
    in property <string> empty-songs-text: "No songs available.";
    callback track-selected(int);
    callback play();
    callback shuffle();
    spacing: 16px;
    alignment: start;

    if !root.has-detail : VerticalLayout {
        padding-top: 24px;
        alignment: center;
        Text {
            text: root.empty-text;
            color: Theme.secondary;
            font-size: 14px;
            horizontal-alignment: center;
        }
    }

    if root.has-detail : VerticalLayout {
        spacing: 16px;

        HorizontalLayout {
            spacing: 20px;
            alignment: start;

            Rectangle {
                width: 140px;
                height: 140px;
                border-radius: 12px;
                background: Theme.surface;
                clip: true;

                if root.cover.width > 0 : Image {
                    width: parent.width;
                    height: parent.height;
                    source: root.cover;
                    image-fit: ImageFit.cover;
                }
                if root.cover.width == 0 && root.tracks.length > 0 && root.tracks[0].cover.width > 0 : Image {
                    width: parent.width;
                    height: parent.height;
                    source: root.tracks[0].cover;
                    image-fit: ImageFit.cover;
                }
                if root.cover.width == 0 && (root.tracks.length == 0 || root.tracks[0].cover.width == 0) : Text {
                    text: root.kind-label != "" ? root.kind-label : root.no-cover-text;
                    color: Theme.secondary;
                    font-size: 12px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            VerticalLayout {
                spacing: 6px;
                alignment: center;
                horizontal-stretch: 1;

                Text {
                    text: root.kind-label;
                    color: Theme.accent;
                    font-size: 11px;
                    font-weight: 700;
                }

                Text {
                    text: root.title;
                    color: Theme.text;
                    font-size: 24px;
                    font-weight: 800;
                    overflow: elide;
                }

                if root.subtitle != "" : Text {
                    text: root.subtitle;
                    color: Theme.secondary;
                    font-size: 13px;
                    overflow: elide;
                }

                Rectangle { height: 4px; }

                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;

                    Rectangle {
                        height: 36px;
                        border-radius: 18px;
                        background: play-touch.pressed ? Theme.overlay : (play-touch.has-hover ? Theme.hover : Theme.accent);
                        animate background { duration: 150ms; easing: ease-in-out; }

                        play-touch := TouchArea {
                            clicked => { root.play(); }
                        }

                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 20px;
                            spacing: 8px;
                            alignment: center;

                            VerticalLayout {
                                alignment: center;
                                IconPlay {
                                    size: 16px;
                                    tint: play-touch.has-hover ? Theme.text : Theme.window;
                                }
                            }

                            Text {
                                text: root.play-button-label;
                                color: play-touch.has-hover ? Theme.text : Theme.window;
                                font-size: 13px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }
                    }

                    Rectangle {
                        height: 36px;
                        border-radius: 18px;
                        background: shuf-touch.pressed ? Theme.overlay : (shuf-touch.has-hover ? Theme.hover : Theme.surface);
                        animate background { duration: 150ms; easing: ease-in-out; }

                        shuf-touch := TouchArea {
                            clicked => { root.shuffle(); }
                        }

                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 20px;
                            spacing: 8px;
                            alignment: center;

                            VerticalLayout {
                                alignment: center;
                                IconShuffle {
                                    size: 16px;
                                    tint: shuf-touch.has-hover ? Theme.accent : Theme.text;
                                }
                            }

                            Text {
                                text: root.shuffle-button-label;
                                color: shuf-touch.has-hover ? Theme.accent : Theme.text;
                                font-size: 13px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.border;
        }

        if root.tracks.length == 0 : VerticalLayout {
            padding-top: 16px;
            alignment: center;
            Text {
                text: root.empty-songs-text;
                color: Theme.secondary;
                font-size: 13px;
                horizontal-alignment: center;
            }
        }

        for track in root.tracks : TrackRow {
            title: track.title;
            artist: track.artist;
            album: track.album;
            duration: track.duration;
            kind: track.kind;
            cover: track.cover;
            clicked => { root.track-selected(track.index); }
        }
    }
}

component SettingsView inherits VerticalLayout {
    in property <int> active-theme-index: 0;
    in property <string> playback-speed-text: "1.00x";
    in property <bool> signed-in: false;
    in-out property <string> cookie-text: "";
    in property <string> app-version: "0.1.0";
    in property <string> update-status-text: "Up to date";
    in property <bool> has-update: false;
    in property <string> section-theme-label: "Theme";
    in property <string> theme-white-label: "White";
    in property <string> theme-black-oled-label: "Black OLED";
    in property <string> theme-mono-label: "Mono";
    in property <string> section-playback-label: "Playback";
    in property <string> playback-speed-label: "Playback speed";
    in property <string> section-session-label: "Session";
    in property <string> status-signed-in-label: "Status: Signed in";
    in property <string> sign-out-label: "Sign out";
    in property <string> status-anonymous-label: "Status: Anonymous";
    in property <string> session-cookie-placeholder: "Paste session cookies...";
    in property <string> sign-in-label: "Sign in";
    in property <string> section-about-label: "About";
    in property <string> app-version-label: "App version";
    in property <string> update-status-label: "Update status";

    callback theme-selected(int);
    callback cycle-playback-speed();
    callback sign-in-submitted(string);
    callback sign-out();

    spacing: 20px;
    alignment: start;

    // Section (a): Theme
    VerticalLayout {
        spacing: 10px;

        Text {
            text: root.section-theme-label;
            color: Theme.text;
            font-size: 16px;
            font-weight: 700;
        }

        HorizontalLayout {
            spacing: 12px;

            Rectangle {
                height: 40px;
                horizontal-stretch: 1;
                border-radius: 8px;
                background: root.active-theme-index == 0 ? Theme.accent : (th0-touch.pressed ? Theme.overlay : (th0-touch.has-hover ? Theme.hover : Theme.surface));
                animate background { duration: 150ms; easing: ease-in-out; }

                th0-touch := TouchArea {
                    clicked => { root.theme-selected(0); }
                }

                HorizontalLayout {
                    alignment: center;

                    Text {
                        text: root.theme-white-label;
                        color: root.active-theme-index == 0 ? Theme.window : Theme.text;
                        font-size: 13px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            Rectangle {
                height: 40px;
                horizontal-stretch: 1;
                border-radius: 8px;
                background: root.active-theme-index == 1 ? Theme.accent : (th1-touch.pressed ? Theme.overlay : (th1-touch.has-hover ? Theme.hover : Theme.surface));
                animate background { duration: 150ms; easing: ease-in-out; }

                th1-touch := TouchArea {
                    clicked => { root.theme-selected(1); }
                }

                HorizontalLayout {
                    alignment: center;

                    Text {
                        text: root.theme-black-oled-label;
                        color: root.active-theme-index == 1 ? Theme.window : Theme.text;
                        font-size: 13px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            Rectangle {
                height: 40px;
                horizontal-stretch: 1;
                border-radius: 8px;
                background: root.active-theme-index == 2 ? Theme.accent : (th2-touch.pressed ? Theme.overlay : (th2-touch.has-hover ? Theme.hover : Theme.surface));
                animate background { duration: 150ms; easing: ease-in-out; }

                th2-touch := TouchArea {
                    clicked => { root.theme-selected(2); }
                }

                HorizontalLayout {
                    alignment: center;

                    Text {
                        text: root.theme-mono-label;
                        color: root.active-theme-index == 2 ? Theme.window : Theme.text;
                        font-size: 13px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    // Section (b): Playback
    VerticalLayout {
        spacing: 10px;

        Text {
            text: root.section-playback-label;
            color: Theme.text;
            font-size: 16px;
            font-weight: 700;
        }

        Rectangle {
            border-radius: 8px;
            background: Theme.panel;

            HorizontalLayout {
                padding: 16px;
                alignment: space-between;

                Text {
                    text: root.playback-speed-label;
                    color: Theme.text;
                    font-size: 14px;
                    vertical-alignment: center;
                }

                Rectangle {
                    width: 90px;
                    height: 32px;
                    border-radius: 8px;
                    background: speed-touch.pressed ? Theme.overlay : (speed-touch.has-hover ? Theme.hover : Theme.surface);
                    animate background { duration: 150ms; easing: ease-in-out; }

                    speed-touch := TouchArea {
                        clicked => { root.cycle-playback-speed(); }
                    }

                    Text {
                        text: root.playback-speed-text;
                        color: Theme.accent;
                        font-size: 12px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    // Section (c): Session
    VerticalLayout {
        spacing: 10px;

        Text {
            text: root.section-session-label;
            color: Theme.text;
            font-size: 16px;
            font-weight: 700;
        }

        Rectangle {
            border-radius: 8px;
            background: Theme.panel;

            VerticalLayout {
                padding: 16px;
                spacing: 12px;

                if root.signed-in : HorizontalLayout {
                    alignment: space-between;

                    Text {
                        text: root.status-signed-in-label;
                        color: Theme.accent;
                        font-size: 14px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        width: 90px;
                        height: 32px;
                        border-radius: 8px;
                        background: sign-out-touch.pressed ? Theme.overlay : (sign-out-touch.has-hover ? Theme.hover : Theme.surface);
                        animate background { duration: 150ms; easing: ease-in-out; }

                        sign-out-touch := TouchArea {
                            clicked => { root.sign-out(); }
                        }

                        Text {
                            text: root.sign-out-label;
                            color: Theme.text;
                            font-size: 12px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                if !root.signed-in : VerticalLayout {
                    spacing: 10px;

                    Text {
                        text: root.status-anonymous-label;
                        color: Theme.secondary;
                        font-size: 14px;
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        height: 32px;

                        StyledInputField {
                            text <=> root.cookie-text;
                            placeholder-text: root.session-cookie-placeholder;
                            input-type: InputType.password;
                            accepted(t) => { root.sign-in-submitted(t); }
                        }

                        Rectangle {
                            width: 90px;
                            border-radius: 8px;
                            background: sign-in-touch.pressed ? Theme.overlay : (sign-in-touch.has-hover ? Theme.hover : Theme.accent);
                            animate background { duration: 150ms; easing: ease-in-out; }

                            sign-in-touch := TouchArea {
                                clicked => { root.sign-in-submitted(root.cookie-text); }
                            }

                            Text {
                                text: root.sign-in-label;
                                color: sign-in-touch.has-hover ? Theme.text : Theme.window;
                                font-size: 12px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }

    // Section (d): About
    VerticalLayout {
        spacing: 10px;

        Text {
            text: root.section-about-label;
            color: Theme.text;
            font-size: 16px;
            font-weight: 700;
        }

        Rectangle {
            border-radius: 8px;
            background: Theme.panel;

            VerticalLayout {
                padding: 16px;
                spacing: 12px;

                HorizontalLayout {
                    alignment: space-between;

                    Text {
                        text: root.app-version-label;
                        color: Theme.secondary;
                        font-size: 13px;
                    }

                    Text {
                        text: root.app-version;
                        color: Theme.text;
                        font-size: 13px;
                        font-weight: 600;
                    }
                }

                HorizontalLayout {
                    alignment: space-between;

                    Text {
                        text: root.update-status-label;
                        color: Theme.secondary;
                        font-size: 13px;
                    }

                    Text {
                        text: root.update-status-text;
                        color: root.has-update ? Theme.accent : Theme.secondary;
                        font-size: 13px;
                        font-weight: 600;
                    }
                }
            }
        }
    }
}

component ContentArea inherits Rectangle {
    in property <int> active-page: 0;
    in property <string> header-title: "Search";
    in property <bool> has-update: false;
    in-out property <string> query: "";
    in-out property <string> cookie-text: "";
    in property <bool> signed-in: false;
    in property <[ShelfData]> shelves: [];
    in property <int> search-filter: 0;
    in property <[TrackRowData]> queue-tracks: [];
    in property <int> queue-selected-index: -1;
    in property <string> active-track-title: "No track playing";
    in property <string> active-track-artist: "";
    in property <string> position-text: "0:00";
    in property <string> duration-text: "0:00";
    in property <float> playback-progress: 0.0;
    in property <image> cover-image;
    in property <bool> has-cover: false;
    in property <[LyricLineData]> lyrics-lines: [];
    in property <int> active-lyric-index: -1;
    in property <[LibraryItemData]> library-playlists: []; in property <[LibraryItemData]> library-albums: []; in property <[LibraryItemData]> library-artists: [];
    in property <bool> detail-has-detail: false; in property <string> detail-title: ""; in property <string> detail-subtitle: "";
    in property <string> detail-kind-label: ""; in property <[TrackRowData]> detail-tracks: [];
    in property <image> detail-cover;
    in property <int> active-theme-index: 0;
    in property <string> playback-speed-text: "1.00x";
    in-out property <string> settings-cookie-text: "";
    in property <string> app-version: "0.1.0";
    in property <string> update-status-text: "Up to date";
    in property <string> search-placeholder: "Search songs...";
    in property <string> search-button-label: "Search";
    in property <string> filter-all-label: "All";
    in property <string> filter-songs-label: "Songs";
    in property <string> filter-albums-label: "Albums";
    in property <string> filter-artists-label: "Artists";
    in property <string> filter-playlists-label: "Playlists";
    in property <string> search-empty-text: "No results found.";
    in property <string> queue-empty-text: "The queue is empty.";
    in property <string> no-cover-text: "No cover";
    in property <string> lyrics-unavailable-text: "Lyrics unavailable";
    in property <string> lyrics-hint-text: "Synchronized lyrics will appear during playback";
    in property <string> session-anonymous-hint: "Anonymous session: paste cookies to unlock library";
    in property <string> session-cookie-placeholder: "Paste session cookies...";
    in property <string> sign-in-label: "Sign in";
    in property <string> session-signed-in-hint: "Signed in: library unlocked";
    in property <string> sign-out-label: "Sign out";
    in property <string> section-playlists-label: "Playlists";
    in property <string> empty-playlists-text: "No playlists found.";
    in property <string> section-albums-label: "Albums";
    in property <string> empty-albums-text: "No albums found.";
    in property <string> section-artists-label: "Artists";
    in property <string> empty-artists-text: "No artists found.";
    in property <string> empty-detail-text: "No details available.";
    in property <string> play-button-label: "Play";
    in property <string> shuffle-button-label: "Shuffle";
    in property <string> empty-songs-text: "No songs available.";
    in property <string> section-theme-label: "Theme";
    in property <string> theme-white-label: "White";
    in property <string> theme-black-oled-label: "Black OLED";
    in property <string> theme-mono-label: "Mono";
    in property <string> section-playback-label: "Playback";
    in property <string> playback-speed-label: "Playback speed";
    in property <string> section-session-label: "Session";
    in property <string> status-signed-in-label: "Status: Signed in";
    in property <string> status-anonymous-label: "Status: Anonymous";
    in property <string> section-about-label: "About";
    in property <string> app-version-label: "App version";
    in property <string> update-status-label: "Update status";

    callback query-submitted(string);
    callback track-selected(int);
    callback filter-selected(int);
    callback queue-track-selected(int);
    callback playlist-selected(int); callback album-selected(int); callback artist-selected(int); callback detail-track-selected(int);
    callback detail-play();
    callback detail-shuffle();
    callback sign-in-submitted(string);
    callback sign-out();
    callback open-settings();
    callback theme-selected(int);
    callback cycle-playback-speed();
    callback back-pressed();

    background: Theme.window;
    clip: true;

    flick := Flickable {
        TouchArea {
            x: 0;
            y: -flick.viewport-y;
            width: flick.width;
            height: flick.height;

            scroll-event(event) => {
                let min-y = min(0px, flick.height - flick.viewport-height);
                flick.viewport-y = min(0px, max(min-y, flick.viewport-y + event.delta-y * 3.5));
                return EventResult.accept;
            }
        }

        VerticalLayout {
            padding: 24px;
            spacing: 16px;
            alignment: start;

            HorizontalLayout {
                alignment: space-between;

                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;

                    if root.active-page == 4 : VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 32px;
                            height: 32px;
                            border-radius: 8px;
                            background: back-btn.pressed ? Theme.overlay : (back-btn.has-hover ? Theme.hover : Theme.surface);
                            animate background { duration: 150ms; easing: ease-in-out; }

                            back-btn := TouchArea {
                                clicked => { root.back-pressed(); }
                            }

                            IconBack {
                                size: 16px;
                                tint: back-btn.has-hover ? Theme.accent : Theme.text;
                            }
                        }
                    }

                    Text {
                        text: root.header-title;
                        color: Theme.text;
                        font-size: 24px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }

                if root.active-page != 5 : VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 32px;
                        height: 32px;
                        border-radius: 8px;
                        background: settings-btn.pressed ? Theme.overlay : (settings-btn.has-hover ? Theme.hover : Theme.surface);
                        animate background { duration: 150ms; easing: ease-in-out; }

                        settings-btn := TouchArea {
                            clicked => { root.open-settings(); }
                        }

                        IconSettings {
                            size: 16px;
                            tint: settings-btn.has-hover ? Theme.accent : Theme.text;
                        }

                        if root.has-update : Rectangle {
                            x: parent.width - 6px;
                            y: 2px;
                            width: 6px;
                            height: 6px;
                            border-radius: 3px;
                            background: Theme.accent;
                        }
                    }
                }
            }

        Rectangle {
            height: 1px;
            background: Theme.border;
        }

        if root.active-page == 0 : SearchView {
            query <=> root.query;
            shelves: root.shelves;
            active-filter: root.search-filter;
            placeholder-text: root.search-placeholder;
            search-button-label: root.search-button-label;
            filter-all-label: root.filter-all-label;
            filter-songs-label: root.filter-songs-label;
            filter-albums-label: root.filter-albums-label;
            filter-artists-label: root.filter-artists-label;
            filter-playlists-label: root.filter-playlists-label;
            empty-text: root.search-empty-text;
            query-submitted(q) => { root.query-submitted(q); }
            track-selected(idx) => { root.track-selected(idx); }
            filter-selected(idx) => { root.filter-selected(idx); }
        }

        if root.active-page == 1 : QueueView {
            tracks: root.queue-tracks;
            selected-index: root.queue-selected-index;
            empty-text: root.queue-empty-text;
            track-selected(idx) => { root.queue-track-selected(idx); }
        }

        if root.active-page == 2 : NowPlayingView {
            track-title: root.active-track-title;
            track-artist: root.active-track-artist;
            position-text: root.position-text;
            duration-text: root.duration-text;
            progress: root.playback-progress;
            cover-image: root.cover-image;
            has-cover: root.has-cover;
            lyrics-lines: root.lyrics-lines;
            active-lyric-index: root.active-lyric-index;
            no-cover-text: root.no-cover-text;
            lyrics-unavailable-text: root.lyrics-unavailable-text;
            lyrics-hint-text: root.lyrics-hint-text;
        }

        if root.active-page == 3 : LibraryView {
            cookie-text <=> root.cookie-text;
            signed-in: root.signed-in;
            session-anonymous-hint: root.session-anonymous-hint;
            session-cookie-placeholder: root.session-cookie-placeholder;
            sign-in-label: root.sign-in-label;
            session-signed-in-hint: root.session-signed-in-hint;
            sign-out-label: root.sign-out-label;
            section-playlists-label: root.section-playlists-label;
            empty-playlists-text: root.empty-playlists-text;
            section-albums-label: root.section-albums-label;
            empty-albums-text: root.empty-albums-text;
            section-artists-label: root.section-artists-label;
            empty-artists-text: root.empty-artists-text;
            playlists: root.library-playlists; albums: root.library-albums; artists: root.library-artists;
            playlist-selected(idx) => { root.playlist-selected(idx); }
            album-selected(idx) => { root.album-selected(idx); }
            artist-selected(idx) => { root.artist-selected(idx); }
            sign-in-submitted(t) => { root.sign-in-submitted(t); }
            sign-out() => { root.sign-out(); }
        }

        if root.active-page == 4 : DetailView {
            has-detail: root.detail-has-detail;
            title: root.detail-title;
            subtitle: root.detail-subtitle;
            kind-label: root.detail-kind-label;
            cover: root.detail-cover;
            tracks: root.detail-tracks;
            empty-text: root.empty-detail-text;
            no-cover-text: root.no-cover-text;
            play-button-label: root.play-button-label;
            shuffle-button-label: root.shuffle-button-label;
            empty-songs-text: root.empty-songs-text;
            track-selected(idx) => { root.detail-track-selected(idx); }
            play => { root.detail-play(); }
            shuffle => { root.detail-shuffle(); }
        }

        if root.active-page == 5 : SettingsView {
            active-theme-index: root.active-theme-index;
            playback-speed-text: root.playback-speed-text;
            signed-in: root.signed-in;
            cookie-text <=> root.settings-cookie-text;
            app-version: root.app-version;
            update-status-text: root.update-status-text;
            has-update: root.has-update;
            section-theme-label: root.section-theme-label;
