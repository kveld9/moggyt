import { Theme } from "../theme.slint";

export component MediaCard inherits Rectangle {
    in property <int> index: 0;
    in property <string> title;
    in property <string> subtitle;
    in property <bool> has-cover: false;
    in property <image> cover;
    in property <color> tile-color: Theme.surface;
    callback clicked();

    height: 202px;
    width: 150px;
    border-radius: 10px;
    opacity: root.index < 0 ? 0 : 1;
    background: touch.pressed ? Theme.overlay : (touch.has-hover ? Theme.hover : transparent);
    animate background { duration: 150ms; easing: ease-in-out; }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    VerticalLayout {
        padding: 8px;
        spacing: 6px;
        alignment: start;

        Rectangle {
            height: 140px;
            border-radius: 8px;
            background: root.has-cover ? Theme.surface : root.tile-color;
            clip: true;

            if root.has-cover : Image {
                width: parent.width;
                height: parent.height;
                source: root.cover;
                image-fit: ImageFit.cover;
            }

            if !root.has-cover : VerticalLayout {
                padding: 10px;
                alignment: center;

                Text {
                    text: root.title;
                    color: Theme.text;
                    font-size: 14px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    overflow: elide;
                }
            }
        }

        if root.has-cover : VerticalLayout {
            spacing: 2px;
            alignment: start;

            Text {
                text: root.title;
                color: Theme.text;
                font-size: 13px;
                font-weight: 600;
                overflow: elide;
            }

            if root.subtitle != "" : Text {
                text: root.subtitle;
                color: Theme.secondary;
                font-size: 11px;
                overflow: elide;
            }
        }
    }
}
