import { Theme } from "../theme.slint";
import { ContextSurface, ContextUi } from "./context_menu.slint";

export component MediaCard inherits Rectangle {
    in property <int> index: 0;
    in property <ContextSurface> surface: ContextSurface.explore;
    in property <string> title;
    in property <string> subtitle;
    in property <bool> has-cover: false;
    in property <image> cover;
    in property <color> tile-color: Theme.surface;
    callback clicked();

    height: 202px;
    width: 150px;
    border-radius: 10px;
    opacity: root.index < 0 ? 0 : 1;
    background: touch.pressed ? Theme.overlay : (touch.has-hover ? Theme.hover : transparent);
    animate background { duration: 150ms; easing: ease-in-out; }

    touch := TouchArea {
        clicked => { root.clicked(); }
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                ContextUi.opened(
                    root.surface,
                    root.index,
                    self.absolute-position.x + self.mouse-x,
                    self.absolute-position.y + self.mouse-y,
                );
            }
        }
    }

    VerticalLayout {
        padding: 8px;
        spacing: 6px;
        alignment: start;

        Rectangle {
            height: 140px;
            border-radius: 8px;
            background: root.has-cover ? Theme.surface : root.tile-color;
            clip: true;

            if root.has-cover : Image {
                width: parent.width;
                height: parent.height;
                source: root.cover;
                image-fit: ImageFit.cover;
            }

            if !root.has-cover : VerticalLayout {
                padding: 10px;
                alignment: center;

                Text {
                    text: root.title;
                    color: Theme.text;
                    font-size: 14px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    overflow: elide;
                }
            }
        }

        if root.has-cover : VerticalLayout {
            spacing: 2px;
            alignment: start;

            Text {
                text: root.title;
                color: Theme.text;
                font-size: 13px;
                font-weight: 600;
                overflow: elide;
            }

            if root.subtitle != "" : Text {
                text: root.subtitle;
                color: Theme.secondary;
                font-size: 11px;
                overflow: elide;
            }
        }
    }
}

export component DetailTile inherits Rectangle {
    in property <int> index: -1;
    in property <bool> circular: false;
    in property <string> title;
    in property <string> subtitle;
    in property <bool> has-cover: false;
    in property <image> cover;
    callback clicked();

    width: 150px;
    height: root.circular ? 226px : 204px;
    opacity: root.index < 0 ? 0 : 1;
    border-radius: 10px;
    background: touch.pressed ? Theme.overlay : (touch.has-hover ? Theme.hover : transparent);
    animate background { duration: 150ms; easing: ease-in-out; }

    touch := TouchArea {
        clicked => { root.clicked(); }
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                ContextUi.opened(
                    ContextSurface.detail-card,
                    root.index,
                    self.absolute-position.x + self.mouse-x,
                    self.absolute-position.y + self.mouse-y,
                );
            }
        }
    }

    VerticalLayout {
        padding: 8px;
        spacing: 6px;
        alignment: start;

        Rectangle {
            height: root.circular ? 134px : 140px;
            border-radius: root.circular ? 67px : 8px;
            background: Theme.surface;
            clip: true;

            if root.has-cover : Image {
                width: parent.width;
                height: parent.height;
                source: root.cover;
                image-fit: ImageFit.cover;
            }
        }

        Text {
            text: root.title;
            color: Theme.text;
            font-size: 13px;
            font-weight: 600;
            overflow: elide;
        }

        if root.subtitle != "" : Text {
            text: root.subtitle;
            color: Theme.secondary;
            font-size: 11px;
            wrap: word-wrap;
        }
    }
}
