import { Theme } from "../theme.slint";
import { IconMusic } from "../icons.slint";

export component MediaCard inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <bool> has-cover: false;
    in property <image> cover;
    callback clicked();

    width: 156px;
    height: 202px;
    border-radius: 10px;
    background: touch.pressed ? Theme.overlay : (touch.has-hover ? Theme.hover : transparent);
    animate background { duration: 150ms; easing: ease-in-out; }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    VerticalLayout {
        padding: 8px;
        spacing: 6px;
        alignment: start;

        Rectangle {
            height: 140px;
            border-radius: 8px;
            background: Theme.surface;
            clip: true;

            if root.has-cover : Image {
                width: parent.width;
                height: parent.height;
                source: root.cover;
                image-fit: ImageFit.cover;
            }

            if !root.has-cover : VerticalLayout {
                alignment: center;

                IconMusic {
                    size: 36px;
                    tint: Theme.secondary;
                }
            }
        }

        Text {
            text: root.title;
            color: Theme.text;
            font-size: 13px;
            font-weight: 600;
            overflow: elide;
            vertical-alignment: center;
        }

        if root.subtitle != "" : Text {
            text: root.subtitle;
            color: Theme.secondary;
            font-size: 11px;
            overflow: elide;
            vertical-alignment: center;
        }
    }
}
