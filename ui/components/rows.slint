import { Labels } from "../labels.slint";
import { Theme } from "../theme.slint";
import { ContextSurface, ContextUi } from "./context_menu.slint";

export component TrackRow inherits Rectangle {
    in property <string> title;
    in property <string> artist;
    in property <string> album;
    in property <string> duration;
    in property <string> kind;
    in property <int> index: -1;
    in property <ContextSurface> surface: ContextSurface.search;
    in property <image> cover;
    in property <bool> is-active: false;
    in property <bool> show-remove: false;
    callback clicked();
    callback remove-requested();
    callback move-up-requested();
    callback move-down-requested();

    property <string> subtitle-text: root.album != "" && root.artist != "" ? root.artist + " - " + root.album : (
        root.artist != "" ? root.artist : root.album
    );

    height: 56px;
    border-radius: 8px;
    background: root.is-active ? (touch.pressed ? Theme.overlay : Theme.surface) : (touch.pressed ? Theme.overlay : (touch.has-hover ? Theme.hover : transparent));
    animate background { duration: 150ms; easing: ease-in-out; }

    touch := TouchArea {
        clicked => { root.clicked(); }
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                ContextUi.opened(
                    root.surface,
                    root.index,
                    self.absolute-position.x + self.mouse-x,
                    self.absolute-position.y + self.mouse-y,
                );
            }
        }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 40px;
                height: 40px;
                border-radius: 6px;
                background: Theme.surface;
                clip: true;

                Image {
                    width: parent.width;
                    height: parent.height;
                    source: root.cover;
                    image-fit: ImageFit.cover;
                }
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;

            Text {
                text: root.title;
                color: root.is-active ? Theme.accent : Theme.text;
                font-size: 14px;
                font-weight: 600;
                overflow: elide;
                vertical-alignment: center;
            }

            if root.subtitle-text != "" : Text {
                text: root.subtitle-text;
                color: Theme.secondary;
                font-size: 12px;
                overflow: elide;
                vertical-alignment: center;
            }
        }

        if root.duration != "" : Text {
            text: root.duration;
            color: Theme.secondary;
            font-size: 12px;
            font-weight: 500;
            vertical-alignment: center;
            horizontal-alignment: right;
        }

        if root.show-remove : VerticalLayout {
            alignment: center;

            HorizontalLayout {
                spacing: 6px;

                Rectangle {
                    height: 28px;
                    border-radius: 6px;
                    background: up-touch.pressed ? Theme.overlay : (up-touch.has-hover ? Theme.hover : Theme.surface);
                    animate background { duration: 150ms; easing: ease-in-out; }

                    up-touch := TouchArea {
                        clicked => { root.move-up-requested(); }
                    }

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        alignment: center;

                        Text {
                            text: Labels.local-move-up-label;
                            color: up-touch.has-hover ? Theme.text : Theme.secondary;
                            font-size: 12px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                }

                Rectangle {
                    height: 28px;
                    border-radius: 6px;
                    background: down-touch.pressed ? Theme.overlay : (down-touch.has-hover ? Theme.hover : Theme.surface);
                    animate background { duration: 150ms; easing: ease-in-out; }

                    down-touch := TouchArea {
                        clicked => { root.move-down-requested(); }
                    }

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        alignment: center;

                        Text {
                            text: Labels.local-move-down-label;
                            color: down-touch.has-hover ? Theme.text : Theme.secondary;
                            font-size: 12px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                }

                Rectangle {
                    height: 28px;
                    border-radius: 6px;
                    background: remove-touch.pressed ? Theme.overlay : (remove-touch.has-hover ? Theme.hover : Theme.surface);
                    animate background { duration: 150ms; easing: ease-in-out; }

                    remove-touch := TouchArea {
                        clicked => { root.remove-requested(); }
                    }

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        alignment: center;

                        Text {
                            text: Labels.local-remove-track-label;
                            color: remove-touch.has-hover ? Theme.text : Theme.secondary;
                            font-size: 12px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}

export component LibraryItemCard inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <image> cover;
    in property <int> index: -1;
    in property <ContextSurface> surface: ContextSurface.library-playlist;
    callback clicked();

    height: 48px;
    border-radius: 8px;
    background: touch.pressed ? Theme.overlay : (touch.has-hover ? Theme.hover : transparent);
    animate background { duration: 150ms; easing: ease-in-out; }

    touch := TouchArea {
        clicked => { root.clicked(); }
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                ContextUi.opened(
                    root.surface,
                    root.index,
                    self.absolute-position.x + self.mouse-x,
                    self.absolute-position.y + self.mouse-y,
                );
            }
        }
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 12px;

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 36px;
                height: 36px;
                border-radius: 6px;
                background: Theme.surface;
                clip: true;

                Image {
                    width: parent.width;
                    height: parent.height;
                    source: root.cover;
                    image-fit: ImageFit.cover;
                }
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;

            Text {
                text: root.title;
                color: Theme.text;
                font-size: 13px;
                font-weight: 600;
                vertical-alignment: center;
            }

            Text {
                text: root.subtitle;
                color: Theme.secondary;
                font-size: 11px;
                vertical-alignment: center;
            }
        }
    }
}
