import { Labels } from "../../labels.slint";
import { PlaybackUi, Theme } from "../../theme.slint";
import { ThemedSlider } from "../controls.slint";
import { SettingsModeButton, SettingsToggleRow } from "../settings_rows.slint";

export component PlaybackSettings inherits VerticalLayout {
    in property <string> playback-speed-text: "1.00x";
    in property <string> sleep-timer-status-text: "Timer: Off";
    in property <int> active-sleep-timer-index: 0;
    in property <int> active-audio-quality-index: 1;
    in property <int> crossfade-seconds: 0;
    in property <int> stream-cache-limit-mb: 512;
    in property <bool> songs-only: false;

    callback cycle-playback-speed();
    callback sleep-timer-preset-selected(int);
    callback audio-quality-selected(int);
    callback crossfade-changed(int);
    callback stream-cache-limit-selected(int);
    callback songs-only-toggled();

    spacing: 10px;

    Text {
        text: Labels.section-playback-label;
        color: Theme.text;
        font-size: 16px;
        font-weight: 700;
    }

    Rectangle {
        border-radius: 8px;
        background: Theme.panel;

        VerticalLayout {
            padding: 16px;
            spacing: 16px;

            HorizontalLayout {
                alignment: space-between;

                Text {
                    text: Labels.playback-speed-label;
                    color: Theme.text;
                    font-size: 14px;
                    vertical-alignment: center;
                }

                Rectangle {
                    width: 90px;
                    height: 32px;
                    border-radius: 8px;
                    background: speed-touch.pressed ? Theme.overlay : (speed-touch.has-hover ? Theme.hover : Theme.surface);
                    animate background { duration: 150ms; easing: ease-in-out; }

                    speed-touch := TouchArea {
                        clicked => { root.cycle-playback-speed(); }
                    }

                    Text {
                        text: root.playback-speed-text;
                        color: Theme.accent;
                        font-size: 12px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: Theme.border;
            }

            VerticalLayout {
                spacing: 12px;

                HorizontalLayout {
                    alignment: space-between;

                    Text {
                        text: Labels.audio-quality-label;
                        color: Theme.text;
                        font-size: 14px;
                        vertical-alignment: center;
                    }

                    Text {
                        text: Labels.audio-quality-hint-label;
                        color: Theme.secondary;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }

                HorizontalLayout {
                    spacing: 8px;

                    SettingsModeButton {
                        label: Labels.audio-quality-low-label;
                        is-active: root.active-audio-quality-index == 0;
                        clicked => { root.audio-quality-selected(0); }
                    }

                    SettingsModeButton {
                        label: Labels.audio-quality-standard-label;
                        is-active: root.active-audio-quality-index == 1;
                        clicked => { root.audio-quality-selected(1); }
                    }

                    SettingsModeButton {
                        label: Labels.audio-quality-high-label;
                        is-active: root.active-audio-quality-index == 2;
                        clicked => { root.audio-quality-selected(2); }
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: Theme.border;
            }

            VerticalLayout {
                spacing: 12px;

                HorizontalLayout {
                    alignment: space-between;

                    Text {
                        text: Labels.sleep-timer-label;
                        color: Theme.text;
                        font-size: 14px;
                        vertical-alignment: center;
                    }

                    Text {
                        text: root.sleep-timer-status-text;
                        color: root.active-sleep-timer-index != 0 ? Theme.accent : Theme.secondary;
                        font-size: 13px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }

                HorizontalLayout {
                    spacing: 8px;

                    SettingsModeButton {
                        label: Labels.sleep-timer-off-label;
                        is-active: root.active-sleep-timer-index == 0;
                        clicked => { root.sleep-timer-preset-selected(0); }
                    }

                    SettingsModeButton {
                        label: Labels.sleep-timer-15m-label;
                        is-active: root.active-sleep-timer-index == 1;
                        clicked => { root.sleep-timer-preset-selected(1); }
                    }

                    SettingsModeButton {
                        label: Labels.sleep-timer-30m-label;
                        is-active: root.active-sleep-timer-index == 2;
                        clicked => { root.sleep-timer-preset-selected(2); }
                    }

                    SettingsModeButton {
                        label: Labels.sleep-timer-45m-label;
                        is-active: root.active-sleep-timer-index == 3;
                        clicked => { root.sleep-timer-preset-selected(3); }
                    }

                    SettingsModeButton {
                        label: Labels.sleep-timer-60m-label;
                        is-active: root.active-sleep-timer-index == 4;
                        clicked => { root.sleep-timer-preset-selected(4); }
                    }

                    SettingsModeButton {
                        label: Labels.sleep-timer-end-of-track-label;
                        is-active: root.active-sleep-timer-index == 5;
                        clicked => { root.sleep-timer-preset-selected(5); }
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: Theme.border;
            }

            VerticalLayout {
                spacing: 12px;

                HorizontalLayout {
                    alignment: space-between;

                    Text {
                        text: Labels.crossfade-label;
                        color: Theme.text;
                        font-size: 14px;
                        vertical-alignment: center;
                    }

                    Text {
                        text: root.crossfade-seconds == 0 ? "Off" : (root.crossfade-seconds + "s");
                        color: root.crossfade-seconds != 0 ? Theme.accent : Theme.secondary;
                        font-size: 13px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }

                Text {
                    text: Labels.crossfade-hint-label;
                    color: Theme.secondary;
                    font-size: 12px;
                }

                ThemedSlider {
                    minimum: 0.0;
                    maximum: 12.0;
                    value: root.crossfade-seconds;
                    hit-slack: 14px;
                    changed(val) => { root.crossfade-changed(round(val)); }
                }
            }

            Rectangle {
                height: 1px;
                background: Theme.border;
            }

            VerticalLayout {
                spacing: 12px;

                HorizontalLayout {
                    alignment: space-between;

                    Text {
                        text: Labels.stream-cache-label;
                        color: Theme.text;
                        font-size: 14px;
                        vertical-alignment: center;
                    }

                    Text {
                        text: root.stream-cache-limit-mb == 0 ? "Off" : (root.stream-cache-limit-mb >= 1024 ? ((root.stream-cache-limit-mb / 1024) + " GB") : (root.stream-cache-limit-mb + " MB"));
                        color: root.stream-cache-limit-mb != 0 ? Theme.accent : Theme.secondary;
                        font-size: 13px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }

                Text {
                    text: Labels.stream-cache-hint-label;
                    color: Theme.secondary;
                    font-size: 12px;
                }

                HorizontalLayout {
                    spacing: 8px;

                    SettingsModeButton {
                        label: "Off";
                        is-active: root.stream-cache-limit-mb == 0;
                        clicked => { root.stream-cache-limit-selected(0); }
                    }

                    SettingsModeButton {
                        label: "256 MB";
                        is-active: root.stream-cache-limit-mb == 256;
                        clicked => { root.stream-cache-limit-selected(256); }
                    }

                    SettingsModeButton {
                        label: "512 MB";
                        is-active: root.stream-cache-limit-mb == 512;
                        clicked => { root.stream-cache-limit-selected(512); }
                    }

                    SettingsModeButton {
                        label: "1 GB";
                        is-active: root.stream-cache-limit-mb == 1024;
                        clicked => { root.stream-cache-limit-selected(1024); }
                    }

                    SettingsModeButton {
                        label: "2 GB";
                        is-active: root.stream-cache-limit-mb == 2048;
                        clicked => { root.stream-cache-limit-selected(2048); }
                    }

                    SettingsModeButton {
                        label: "5 GB";
                        is-active: root.stream-cache-limit-mb == 5120;
                        clicked => { root.stream-cache-limit-selected(5120); }
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: Theme.border;
            }

            SettingsToggleRow {
                label: Labels.songs-only-label;
                checked: root.songs-only;
                toggled => { root.songs-only-toggled(); }
            }

            SettingsToggleRow {
                label: Labels.autoplay-label;
                checked: PlaybackUi.autoplay-enabled;
                toggled => { PlaybackUi.autoplay-toggled(); }
            }
        }
    }
}
