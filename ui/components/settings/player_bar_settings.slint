import { Labels } from "../../labels.slint";
import { PlayerBarUi, Theme } from "../../theme.slint";
import { ThemedSlider } from "../controls.slint";
import { SettingsModeButton, SettingsToggleRow } from "../settings_rows.slint";

export component PlayerBarSettings inherits VerticalLayout {
    in property <int> player-bar-mode: 0;
    in property <bool> player-bar-show-artwork: true;
    in property <bool> player-bar-show-like: true;
    in property <bool> player-bar-show-shuffle: true;
    in property <bool> player-bar-show-repeat: true;
    in property <bool> player-bar-show-skip-seconds: false;
    in property <bool> player-bar-show-queue: true;
    in property <bool> player-bar-show-volume: true;
    in property <bool> player-bar-show-timer: true;
    in property <bool> player-bar-show-speed: true;

    callback player-bar-mode-selected(int);
    callback player-bar-option-toggled(int);

    spacing: 10px;

    Text {
        text: Labels.section-player-bar-label;
        color: Theme.text;
        font-size: 16px;
        font-weight: 700;
    }

    Rectangle {
        border-radius: 8px;
        background: Theme.panel;

        VerticalLayout {
            padding: 16px;
            spacing: 12px;

            HorizontalLayout {
                spacing: 12px;

                SettingsModeButton {
                    label: Labels.player-bar-classic-label;
                    is-active: root.player-bar-mode == 0;
                    clicked => { root.player-bar-mode-selected(0); }
                }

                SettingsModeButton {
                    label: Labels.player-bar-floating-label;
                    is-active: root.player-bar-mode == 1;
                    clicked => { root.player-bar-mode-selected(1); }
                }
            }

            Rectangle {
                height: 1px;
                background: Theme.border;
            }

            VerticalLayout {
                spacing: 12px;

                HorizontalLayout {
                    alignment: space-between;

                    Text {
                        text: Labels.player-bar-width-label;
                        color: Theme.text;
                        font-size: 14px;
                        vertical-alignment: center;
                    }

                    Text {
                        text: PlayerBarUi.floating-width + " px";
                        color: Theme.accent;
                        font-size: 13px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }

                Text {
                    text: Labels.player-bar-width-hint-label;
                    color: Theme.secondary;
                    font-size: 12px;
                }

                ThemedSlider {
                    minimum: 800.0;
                    maximum: 1600.0;
                    value: PlayerBarUi.floating-width;
                    hit-slack: 14px;
                    // Live preview while dragging: the bar geometry and the px label follow the
                    // pointer. The persisted commit happens once, when the pointer is released.
                    changed(val) => { PlayerBarUi.floating-width = round(val); }
                    committed(val) => { PlayerBarUi.floating-width-changed(round(val)); }
                }
            }

            SettingsToggleRow {
                label: Labels.player-bar-artwork-label;
                checked: root.player-bar-show-artwork;
                toggled => { root.player-bar-option-toggled(0); }
            }

            SettingsToggleRow {
                label: Labels.player-bar-like-label;
                checked: root.player-bar-show-like;
                toggled => { root.player-bar-option-toggled(1); }
            }

            SettingsToggleRow {
                label: Labels.player-bar-shuffle-label;
                checked: root.player-bar-show-shuffle;
                toggled => { root.player-bar-option-toggled(2); }
            }

            SettingsToggleRow {
                label: Labels.player-bar-repeat-label;
                checked: root.player-bar-show-repeat;
                toggled => { root.player-bar-option-toggled(3); }
            }

            SettingsToggleRow {
                label: Labels.player-bar-skip-label;
                checked: root.player-bar-show-skip-seconds;
                toggled => { root.player-bar-option-toggled(4); }
            }

            SettingsToggleRow {
                label: Labels.player-bar-queue-label;
                checked: root.player-bar-show-queue;
                toggled => { root.player-bar-option-toggled(5); }
            }

            SettingsToggleRow {
                label: Labels.player-bar-volume-label;
                checked: root.player-bar-show-volume;
                toggled => { root.player-bar-option-toggled(6); }
            }

            SettingsToggleRow {
                label: Labels.sleep-timer-label;
                checked: root.player-bar-show-timer;
                toggled => { root.player-bar-option-toggled(7); }
            }

            SettingsToggleRow {
                label: Labels.playback-speed-label;
                checked: root.player-bar-show-speed;
                toggled => { root.player-bar-option-toggled(8); }
            }
        }
    }
}
