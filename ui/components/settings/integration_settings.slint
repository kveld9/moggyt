import { Labels } from "../../labels.slint";
import { Theme } from "../../theme.slint";
import { Integrations } from "../../integrations.slint";
import { SettingsToggleRow } from "../settings_rows.slint";

export component IntegrationSettings inherits VerticalLayout {
    spacing: 10px;

    Text {
        text: Labels.section-integrations-label;
        color: Theme.text;
        font-size: 16px;
        font-weight: 700;
    }

    Rectangle {
        border-radius: 8px;
        background: Theme.panel;

        VerticalLayout {
            padding: 16px;
            spacing: 8px;

            SettingsToggleRow {
                label: Labels.discord-presence-label;
                checked: Integrations.discord-presence-enabled;
                toggled => { Integrations.discord-presence-toggled(); }
            }

            Text {
                text: Labels.discord-presence-hint-label;
                color: Theme.secondary;
                font-size: 12px;
                wrap: word-wrap;
            }

            if Integrations.lastfm-available : VerticalLayout {
                spacing: 8px;

                Text {
                    text: Labels.lastfm-label;
                    color: Theme.text;
                    font-size: 14px;
                    font-weight: 700;
                }

                Text {
                    text: Integrations.lastfm-status;
                    color: Theme.secondary;
                    font-size: 12px;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    alignment: start;

                    Rectangle {
                        height: 32px;
                        border-radius: 8px;
                        background: lastfm-touch.pressed ? Theme.overlay : (lastfm-touch.has-hover ? Theme.hover : Theme.surface);
                        animate background { duration: 150ms; easing: ease-in-out; }
                        opacity: Integrations.lastfm-busy ? 0.6 : 1.0;

                        lastfm-touch := TouchArea {
                            enabled: !Integrations.lastfm-busy;
                            clicked => {
                                if !Integrations.lastfm-busy {
                                    if Integrations.lastfm-connected {
                                        Integrations.lastfm-disconnect();
                                    } else {
                                        Integrations.lastfm-connect();
                                    }
                                }
                            }
                        }

                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;

                            Text {
                                text: Integrations.lastfm-connected ? Labels.lastfm-disconnect-label : Labels.lastfm-connect-label;
                                color: Theme.text;
                                font-size: 12px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }
}
