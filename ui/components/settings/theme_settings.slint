import { Labels } from "../../labels.slint";
import { Theme } from "../../theme.slint";
import { SettingsModeButton } from "../settings_rows.slint";
import { AccentColorPicker } from "accent_picker.slint";

export component ThemeSettings inherits VerticalLayout {
    in property <int> active-theme-index: 0;
    in property <bool> accent-customized: false;
    in property <string> custom-theme-status-text: "";
    in property <[string]> custom-themes: [];
    in property <string> active-custom-theme: "";

    callback theme-selected(int);
    callback custom-theme-selected(string);
    callback accent-picked(color);
    callback accent-reset();

    spacing: 10px;

    Text {
        text: Labels.section-theme-label;
        color: Theme.text;
        font-size: 16px;
        font-weight: 700;
    }

    HorizontalLayout {
        spacing: 12px;

        SettingsModeButton {
            label: Labels.theme-white-label;
            is-active: root.active-theme-index == 0;
            clicked => { root.theme-selected(0); }
        }

        SettingsModeButton {
            label: Labels.theme-black-oled-label;
            is-active: root.active-theme-index == 1;
            clicked => { root.theme-selected(1); }
        }

        SettingsModeButton {
            label: Labels.theme-mono-label;
            is-active: root.active-theme-index == 2;
            clicked => { root.theme-selected(2); }
        }

        SettingsModeButton {
            label: Labels.theme-custom-label;
            is-active: root.active-theme-index == 3;
            clicked => { root.theme-selected(3); }
        }
    }

    if root.active-theme-index <= 2 : AccentColorPicker {
        accent: Theme.accent;
        is-customized: root.accent-customized;
        title-text: Labels.accent-color-label;
        reset-text: Labels.accent-reset-label;
        picked(color) => { root.accent-picked(color); }
        reset-clicked => { root.accent-reset(); }
    }

    if root.active-theme-index == 3 && root.custom-themes.length > 0 : HorizontalLayout {
        spacing: 8px;
        for theme-name in root.custom-themes : SettingsModeButton {
            label: theme-name;
            is-active: theme-name == root.active-custom-theme;
            clicked => { root.custom-theme-selected(theme-name); }
        }
    }

    if root.active-theme-index == 3 && root.custom-themes.length == 0 : Text {
        text: Labels.custom-theme-empty-hint-label;
        color: Theme.secondary;
        font-size: 12px;
        wrap: word-wrap;
    }

    if root.active-theme-index == 3 && root.custom-theme-status-text != "" : Text {
        text: root.custom-theme-status-text;
        color: Theme.secondary;
        font-size: 12px;
        wrap: word-wrap;
    }
}
