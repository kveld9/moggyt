import { Labels } from "../../labels.slint";
import { Theme } from "../../theme.slint";
import { SettingsModeButton } from "../settings_rows.slint";

export component ThemeSettings inherits VerticalLayout {
    in property <int> active-theme-index: 0;

    callback theme-selected(int);

    spacing: 10px;

    Text {
        text: Labels.section-theme-label;
        color: Theme.text;
        font-size: 16px;
        font-weight: 700;
    }

    HorizontalLayout {
        spacing: 12px;

        SettingsModeButton {
            label: Labels.theme-white-label;
            is-active: root.active-theme-index == 0;
            clicked => { root.theme-selected(0); }
        }

        SettingsModeButton {
            label: Labels.theme-black-oled-label;
            is-active: root.active-theme-index == 1;
            clicked => { root.theme-selected(1); }
        }

        SettingsModeButton {
            label: Labels.theme-mono-label;
            is-active: root.active-theme-index == 2;
            clicked => { root.theme-selected(2); }
        }
    }
}
