import { Labels } from "../../labels.slint";
import { Theme } from "../../theme.slint";
import { StyledInputField } from "../controls.slint";

export component SessionSettings inherits VerticalLayout {
    in property <bool> signed-in: false;
    in-out property <string> cookie-text: "";

    callback sign-in-submitted(string);
    callback sign-out();

    spacing: 10px;

    Text {
        text: Labels.section-session-label;
        color: Theme.text;
        font-size: 16px;
        font-weight: 700;
    }

    Rectangle {
        border-radius: 8px;
        background: Theme.panel;

        VerticalLayout {
            padding: 16px;
            spacing: 12px;

            if root.signed-in : HorizontalLayout {
                alignment: space-between;

                Text {
                    text: Labels.status-signed-in-label;
                    color: Theme.accent;
                    font-size: 14px;
                    font-weight: 600;
                    vertical-alignment: center;
                }

                Rectangle {
                    width: 90px;
                    height: 32px;
                    border-radius: 8px;
                    background: sign-out-touch.pressed ? Theme.overlay : (sign-out-touch.has-hover ? Theme.hover : Theme.surface);
                    animate background { duration: 150ms; easing: ease-in-out; }

                    sign-out-touch := TouchArea {
                        clicked => { root.sign-out(); }
                    }

                    Text {
                        text: Labels.sign-out-label;
                        color: Theme.text;
                        font-size: 12px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            if !root.signed-in : VerticalLayout {
                spacing: 10px;

                Text {
                    text: Labels.status-anonymous-label;
                    color: Theme.secondary;
                    font-size: 14px;
                }

                HorizontalLayout {
                    spacing: 8px;
                    height: 32px;

                    StyledInputField {
                        text <=> root.cookie-text;
                        placeholder-text: Labels.session-cookie-placeholder;
                        input-type: InputType.password;
                        accepted(t) => { root.sign-in-submitted(t); }
                    }

                    Rectangle {
                        width: 90px;
                        border-radius: 8px;
                        background: sign-in-touch.pressed ? Theme.overlay : (sign-in-touch.has-hover ? Theme.hover : Theme.accent);
                        animate background { duration: 150ms; easing: ease-in-out; }

                        sign-in-touch := TouchArea {
                            clicked => { root.sign-in-submitted(root.cookie-text); }
                        }

                        Text {
                            text: Labels.sign-in-label;
                            color: sign-in-touch.has-hover ? Theme.text : Theme.window;
                            font-size: 12px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
