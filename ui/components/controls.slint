import { Theme } from "../theme.slint";

export component ThemedSlider inherits Rectangle {
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in-out property <float> value: 0;
    in property <bool> enabled: true;
    /// Extra vertical hit band in pixels added above and below the visible track.
    in property <length> hit-slack: 0px;
    callback changed(float);

    min-height: 20px;
    vertical-stretch: 0;
    horizontal-stretch: 1;

    property <float> clamped-val: max(root.minimum, min(root.maximum, root.value));
    property <float> range: max(1, root.maximum - root.minimum);
    property <float> ratio: (root.clamped-val - root.minimum) / root.range;

    // Fixed thumb anchor: the knob grows toward 16px on interaction but stays centered
    // inside this anchor, so the anchor geometry never changes. Half of it is the inset
    // applied to the track at both ends.
    property <length> knob-anchor: 16px;
    property <length> knob-inset: root.knob-anchor / 2;
    // Knob center travel range: the track and the value mapping share this length.
    property <length> track-length: clamp(root.width - root.knob-anchor, 1px, root.width);

    // Track background: inset by the knob radius at both ends.
    Rectangle {
        x: root.knob-inset;
        width: root.track-length;
        y: (parent.height - 4px) / 2;
        height: 4px;
        border-radius: 2px;
        background: Theme.surface;
    }

    // Active fill: starts at the track start and ends at the knob center, so it is
    // zero width at the minimum value and the knob never overshoots it.
    Rectangle {
        x: root.knob-inset;
        width: clamp(thumb.x, 0px, root.track-length);
        y: (parent.height - 4px) / 2;
        height: 4px;
        border-radius: 2px;
        background: touch.has-hover ? Theme.accent : (touch.pressed ? Theme.accent : Theme.accent);
    }

    // Thumb: a round knob on a fixed-size anchor, so it grows from its center on interaction.
    thumb := Rectangle {
        property <length> knob-size: touch.has-hover || touch.pressed ? 16px : 12px;

        x: root.knob-inset + root.track-length * root.ratio;
        y: (parent.height - root.knob-anchor) / 2;
        width: root.knob-anchor;
        height: root.knob-anchor;

        Rectangle {
            x: (parent.width - parent.knob-size) / 2;
            y: (parent.height - parent.knob-size) / 2;
            width: parent.knob-size;
            height: parent.knob-size;
            border-radius: self.width / 2;
            background: Theme.text;
            animate width { duration: 150ms; easing: ease-in-out; }
            animate height { duration: 150ms; easing: ease-in-out; }
            animate y { duration: 150ms; easing: ease-in-out; }
        }
    }

    touch := TouchArea {
        x: 0;
        width: parent.width;
        y: -root.hit-slack;
        height: parent.height + 2 * root.hit-slack;
        enabled: root.enabled;
        property <bool> is-dragging: false;

        pointer-event(event) => {
            if (!root.enabled || event.button != PointerEventButton.left) {
                return;
            }
            if (event.kind == PointerEventKind.down) {
                self.is-dragging = true;
                let r = clamp((self.mouse-x - root.knob-inset) / root.track-length, 0.0, 1.0);
                root.value = root.minimum + r * root.range;
                root.changed(root.value);
            } else if (event.kind == PointerEventKind.up) {
                self.is-dragging = false;
            }
        }

        moved => {
            if (self.is-dragging && root.enabled) {
                let r = clamp((self.mouse-x - root.knob-inset) / root.track-length, 0.0, 1.0);
                root.value = root.minimum + r * root.range;
                root.changed(root.value);
            }
        }
    }
}

export component StyledInputField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder-text: "";
    in property <InputType> input-type: InputType.text;
    out property <bool> has-focus: input.has-focus;
    callback accepted(string);
    callback edited(string);

    border-radius: 8px;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.border;
    background: Theme.surface;
    animate border-color { duration: 150ms; easing: ease-in-out; }
    forward-focus: input;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        alignment: start;

        input := TextInput {
            horizontal-stretch: 1;
            text <=> root.text;
            input-type: root.input-type;
            color: Theme.text;
            vertical-alignment: center;
            accepted => { root.accepted(self.text); }
            edited => { root.edited(self.text); }
        }
    }

    if root.text == "" && !input.has-focus : Text {
        x: 10px;
        y: 0;
        width: parent.width - 20px;
        height: parent.height;
        text: root.placeholder-text;
        color: Theme.secondary;
        vertical-alignment: center;
    }
}

export component FilterChip inherits Rectangle {
    in property <string> text;
    in property <bool> is-active: false;
    callback clicked();

    height: 28px;
    border-radius: 14px;
    background: root.is-active ? (touch.pressed ? Theme.overlay : Theme.accent) : (touch.pressed ? Theme.overlay : (touch.has-hover ? Theme.hover : Theme.surface));
    animate background { duration: 150ms; easing: ease-in-out; }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        alignment: center;

        Text {
            text: root.text;
            color: root.is-active ? Theme.window : (touch.has-hover ? Theme.text : Theme.secondary);
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
}
