import { Theme } from "../theme.slint";
import { ThemedSlider } from "./controls.slint";
import { PlayerCenterControls } from "./player_controls.slint";
import { IconHeart, IconQueue, IconSpeaker } from "../icons.slint";

export component PlayerBar inherits Rectangle {
    in property <int> mode: 0;
    in property <bool> show-artwork: true;
    in property <bool> show-like: true;
    in property <bool> show-shuffle: true;
    in property <bool> show-repeat: true;
    in property <bool> show-skip-seconds: false;
    in property <bool> show-queue: true;
    in property <bool> show-volume: true;

    in property <string> active-track-title: "No track playing";
    in property <string> active-track-artist: "";
    in property <bool> is-playing: false;
    in property <int> volume: 100;
    in property <string> position-text: "0:00";
    in property <string> duration-text: "0:00";
    in property <image> cover;
    in property <bool> is-liked: false;
    in property <bool> is-shuffle: false;
    in property <int> repeat-mode: 0;
    in property <float> progress: 0.0;
    in property <int> position-secs: 0;
    in property <int> duration-secs: 0;
    in property <int> queue-count: 0;
    in property <string> queue-button-text: "Queue";

    callback toggle-play();
    callback prev-track();
    callback next-track();
    callback seek-by(int);
    callback seek-to(int);
    callback set-volume(int);
    callback toggle-like();
    callback toggle-shuffle();
    callback cycle-repeat();
    callback open-queue();

    border-radius: root.mode == 1 ? 20px : 0px;
    border-width: root.mode == 1 ? 1px : 0px;
    border-color: Theme.border;
    background: Theme.panel;
    drop-shadow-blur: root.mode == 1 ? 16px : 0px;
    drop-shadow-offset-y: root.mode == 1 ? 4px : 0px;
    drop-shadow-color: root.mode == 1 ? #00000066 : #00000000;

    if root.mode == 0 : Rectangle {
        y: 0;
        height: 1px;
        background: Theme.border;
    }

    // Slint layout rule (https://docs.slint.dev/latest/docs/slint/src/language/builtins/layouts):
    // Layouts default to `alignment: stretch`. When an explicit alignment (such as
    // `space-between`) is set, children are sized only to their preferred/minimum
    // sizes and remaining space is distributed into gaps, preventing children with
    // `horizontal-stretch: 1` from expanding. Omitting `alignment` restores default
    // stretch distribution so the center zone fills the space between fixed edge zones.
    HorizontalLayout {
        padding-left: root.mode == 1 ? 18px : 20px;
        padding-right: root.mode == 1 ? 18px : 20px;
        spacing: 16px;

        // LEFT ZONE: Artwork, Title + Artist, Like toggle
        HorizontalLayout {
            width: root.mode == 1 ? 220px : 260px;
            horizontal-stretch: 0;
            spacing: 12px;
            alignment: start;

            if root.show-artwork : Rectangle {
                width: 40px;
                height: 40px;
                border-radius: 8px;
                background: Theme.surface;
                clip: true;

                Image {
                    width: parent.width;
                    height: parent.height;
                    source: root.cover;
                    image-fit: ImageFit.cover;
                }
            }

            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 2px;

                Text {
                    text: root.active-track-title;
                    color: Theme.text;
                    font-size: 13px;
                    font-weight: 700;
                    overflow: elide;
                }

                if root.active-track-artist != "" : Text {
                    text: root.active-track-artist;
                    color: Theme.secondary;
                    font-size: 11px;
                    overflow: elide;
                }
            }

            if root.show-like : VerticalLayout {
                alignment: center;

                Rectangle {
                    width: 32px;
                    height: 32px;
                    border-radius: 16px;
                    background: like-touch.pressed ? Theme.overlay : (like-touch.has-hover ? Theme.hover : (root.is-liked ? Theme.surface : transparent));
                    animate background { duration: 150ms; easing: ease-in-out; }

                    like-touch := TouchArea {
                        clicked => { root.toggle-like(); }
                    }

                    IconHeart {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        tint: root.is-liked ? Theme.accent : (like-touch.has-hover ? Theme.text : Theme.secondary);
                        size: 16px;
                        is-filled: root.is-liked;
                    }
                }
            }
        }

        // CENTER ZONE: Reused center controls
        PlayerCenterControls {
            horizontal-stretch: 1;
            is-playing: root.is-playing;
            is-shuffle: root.is-shuffle;
            repeat-mode: root.repeat-mode;
            position-secs: root.position-secs;
            duration-secs: root.duration-secs;
            position-text: root.position-text;
            duration-text: root.duration-text;
            show-shuffle: root.show-shuffle;
            show-repeat: root.show-repeat;
            show-skip-seconds: root.show-skip-seconds;

            toggle-play => { root.toggle-play(); }
            prev-track => { root.prev-track(); }
            next-track => { root.next-track(); }
            seek-by(delta) => { root.seek-by(delta); }
            seek-to(secs) => { root.seek-to(secs); }
            toggle-shuffle => { root.toggle-shuffle(); }
            cycle-repeat => { root.cycle-repeat(); }
        }

        // RIGHT ZONE: Queue button, Volume Slider
        HorizontalLayout {
            width: 200px;
            horizontal-stretch: 0;
            alignment: end;
            spacing: 10px;

            if root.show-queue : VerticalLayout {
                alignment: center;

                Rectangle {
                    width: root.queue-count > 0 ? 44px : 32px;
                    height: 32px;
                    border-radius: 16px;
                    background: q-touch.pressed ? Theme.overlay : (q-touch.has-hover ? Theme.hover : transparent);
                    animate background { duration: 150ms; easing: ease-in-out; }

                    q-touch := TouchArea {
                        clicked => { root.open-queue(); }
                    }

                    HorizontalLayout {
                        alignment: center;
                        spacing: 4px;

                        VerticalLayout {
                            alignment: center;
                            IconQueue {
                                size: 16px;
                                tint: q-touch.has-hover ? Theme.accent : Theme.secondary;
                            }
                        }

                        if root.queue-count > 0 : Text {
                            text: "\{root.queue-count}";
                            color: q-touch.has-hover ? Theme.accent : Theme.secondary;
                            font-size: 11px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            if root.show-volume : HorizontalLayout {
                spacing: 8px;
                alignment: center;

                VerticalLayout {
                    alignment: center;
                    IconSpeaker {
                        size: 16px;
                        tint: Theme.secondary;
                    }
                }

                ThemedSlider {
                    width: 90px;
                    minimum: 0;
                    maximum: 100;
                    value: root.volume;
                    changed(val) => {
                        root.set-volume(round(val));
                    }
                }
            }
        }
    }
}
