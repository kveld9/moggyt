import { PlayerUi, Theme } from "../theme.slint";
import { ThemedSlider } from "./controls.slint";
import { PlayerCenterControls } from "./player_controls.slint";
import { IconHeart, IconQueue, IconSpeaker, IconSpeakerMuted } from "../icons.slint";

export component PlayerBar inherits Rectangle {
    in property <int> mode: 0;
    in property <bool> show-artwork: true;
    in property <bool> show-like: true;
    in property <bool> show-shuffle: true;
    in property <bool> show-repeat: true;
    in property <bool> show-skip-seconds: false;
    in property <bool> show-queue: true;
    in property <bool> show-volume: true;

    in property <string> active-track-title: "No track playing";
    in property <string> active-track-artist: "";
    in property <image> cover;
    in property <int> queue-count: 0;
    in property <string> queue-button-text: "Queue";
    in property <bool> is-queue-open: false;

    property <int> last-audible-volume: 100;

    callback toggle-queue-panel();

    border-radius: root.mode == 1 ? 20px : 0px;
    border-width: root.mode == 1 ? 1px : 0px;
    border-color: Theme.border;
    background: Theme.panel;
    drop-shadow-blur: root.mode == 1 ? 16px : 0px;
    drop-shadow-offset-y: root.mode == 1 ? 4px : 0px;
    drop-shadow-color: root.mode == 1 ? #00000066 : #00000000;

    if root.mode == 0 : Rectangle {
        y: 0;
        height: 1px;
        background: Theme.border;
    }

    // Slint layout rule (https://docs.slint.dev/latest/docs/slint/src/language/builtins/layouts):
    // Layouts default to `alignment: stretch`. When an explicit alignment (such as
    // `space-between`) is set, children are sized only to their preferred/minimum
    // sizes and remaining space is distributed into gaps, preventing children with
    // `horizontal-stretch: 1` from expanding. Omitting `alignment` restores default
    // stretch distribution so the center zone fills the space between fixed edge zones.
    HorizontalLayout {
        padding-left: root.mode == 1 ? 18px : 20px;
        padding-right: root.mode == 1 ? 18px : 20px;
        padding-top: root.mode == 1 ? 6px : 8px;
        padding-bottom: root.mode == 1 ? 6px : 8px;
        spacing: 16px;

        // LEFT ZONE: Artwork, Title + Artist, Like toggle
        HorizontalLayout {
            width: root.mode == 1 ? 220px : 260px;
            horizontal-stretch: 0;
            spacing: 10px;

            // Slint layout rule: a layout's `alignment` also places fixed-size children on
            // the cross axis, so a 40px thumbnail inside a 72px bar is centered by its own
            // wrapper instead of being pinned to the top edge by `alignment: start`.
            if root.show-artwork : VerticalLayout {
                alignment: center;

                Rectangle {
                    width: 40px;
                    height: 40px;
                    border-radius: 8px;
                    background: Theme.surface;
                    clip: true;

                    Image {
                        width: parent.width;
                        height: parent.height;
                        source: root.cover;
                        image-fit: ImageFit.cover;
                    }
                }
            }

            HorizontalLayout {
                horizontal-stretch: 1;
                spacing: 6px;
                alignment: center;

                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 2px;

                    Text {
                        text: root.active-track-title;
                        color: Theme.text;
                        font-size: 13px;
                        font-weight: 700;
                        overflow: elide;
                    }

                    if root.active-track-artist != "" : Text {
                        text: root.active-track-artist;
                        color: Theme.secondary;
                        font-size: 11px;
                        overflow: elide;
                    }
                }

                if root.show-like : VerticalLayout {
                    alignment: center;

                    Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: 14px;
                        background: like-touch.pressed ? Theme.overlay : (like-touch.has-hover ? Theme.hover : (PlayerUi.is-liked ? Theme.surface : transparent));
                        animate background { duration: 150ms; easing: ease-in-out; }

                        like-touch := TouchArea {
                            clicked => { PlayerUi.toggle-like(); }
                        }

                        IconHeart {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            tint: PlayerUi.is-liked ? Theme.accent : (like-touch.has-hover ? Theme.text : Theme.secondary);
                            size: 14px;
                            is-filled: PlayerUi.is-liked;
                        }
                    }
                }
            }
        }

        // CENTER ZONE: Reused center controls
        PlayerCenterControls {
            horizontal-stretch: 1;
            is-playing: PlayerUi.is-playing;
            is-shuffle: PlayerUi.is-shuffle;
            repeat-mode: PlayerUi.repeat-mode;
            position-secs: PlayerUi.position-secs;
            duration-secs: PlayerUi.duration-secs;
            position-text: PlayerUi.position-text;
            duration-text: PlayerUi.duration-text;
            show-shuffle: root.show-shuffle;
            show-repeat: root.show-repeat;
            show-skip-seconds: root.show-skip-seconds;

            toggle-play => { PlayerUi.toggle-play(); }
            prev-track => { PlayerUi.prev-track(); }
            next-track => { PlayerUi.next-track(); }
            seek-by(delta) => { PlayerUi.seek-by(delta); }
            seek-to(secs) => { PlayerUi.seek-to(secs); }
            toggle-shuffle => { PlayerUi.toggle-shuffle(); }
            cycle-repeat => { PlayerUi.cycle-repeat(); }
        }

        // RIGHT ZONE: Queue button, Volume Slider
        HorizontalLayout {
            width: root.mode == 1 ? 220px : 260px;
            horizontal-stretch: 0;
            alignment: end;
            spacing: 10px;

            if root.show-queue : VerticalLayout {
                alignment: center;

                Rectangle {
                    width: 32px;
                    height: 32px;
                    border-radius: 16px;
                    background: q-touch.pressed ? Theme.overlay : (q-touch.has-hover ? Theme.hover : transparent);
                    animate background { duration: 150ms; easing: ease-in-out; }

                    q-touch := TouchArea {
                        clicked => { root.toggle-queue-panel(); }
                    }

                    IconQueue {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        size: 16px;
                        tint: q-touch.has-hover || root.is-queue-open ? Theme.accent : Theme.secondary;
                    }
                }
            }

            if root.show-volume : HorizontalLayout {
                spacing: 8px;
                alignment: center;

                VerticalLayout {
                    alignment: center;

                    Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: 14px;
                        background: vol-touch.pressed ? Theme.overlay : (vol-touch.has-hover ? Theme.hover : transparent);
                        animate background { duration: 150ms; easing: ease-in-out; }

                        vol-touch := TouchArea {
                            clicked => {
                                if (PlayerUi.volume > 0) {
                                    root.last-audible-volume = PlayerUi.volume;
                                    PlayerUi.set-volume(0);
                                } else {
                                    PlayerUi.set-volume(root.last-audible-volume > 0 ? root.last-audible-volume : 50);
                                }
                            }
                        }

                        if PlayerUi.volume == 0 : IconSpeakerMuted {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            size: 16px;
                            tint: Theme.accent;
                        }

                        if PlayerUi.volume != 0 : IconSpeaker {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            size: 16px;
                            tint: Theme.secondary;
                        }
                    }
                }

                ThemedSlider {
                    width: 90px;
                    minimum: 0;
                    maximum: 100;
                    value: PlayerUi.volume;
                    hit-slack: 14px;
                    changed(val) => {
                        PlayerUi.set-volume(round(val));
                    }
                }
            }
        }
    }
}
