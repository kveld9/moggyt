import { Theme } from "../theme.slint";

export struct ToastData {
    text: string,
}

export global ToastsUi {
    in-out property <[ToastData]> items: [];
}

export component ToastsLayer inherits Rectangle {
    width: 100%;
    height: 100%;

    VerticalLayout {
        width: parent.width;
        height: parent.height;
        alignment: end;
        padding-bottom: 104px;
        padding-left: 16px;
        padding-right: 16px;
        spacing: 8px;

        for toast in ToastsUi.items : HorizontalLayout {
            alignment: center;

            Rectangle {
                width: min(380px, parent.width);
                height: 40px;
                border-radius: 10px;
                background: Theme.panel;
                border-width: 1px;
                border-color: Theme.border;
                drop-shadow-blur: 14px;
                drop-shadow-color: #00000066;
                drop-shadow-offset-y: 3px;

                Text {
                    x: 14px;
                    y: 0;
                    width: parent.width - 28px;
                    height: parent.height;
                    text: toast.text;
                    color: Theme.text;
                    font-size: 13px;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                    overflow: elide;
                }
            }
        }
    }
}
