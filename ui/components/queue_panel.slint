import { Labels } from "../labels.slint";
import { PlaybackUi, Theme, TrackRowData } from "../theme.slint";
import { TrackRow } from "./rows.slint";
import { ContextSurface } from "./context_menu.slint";
import { IconClose } from "../icons.slint";

export component QueuePanel inherits Rectangle {
    in property <[TrackRowData]> tracks: [];
    in property <int> selected-index: -1;
    callback track-selected(int);
    callback close-panel();

    background: Theme.panel;

    Rectangle {
        x: 0;
        y: 0;
        width: 1px;
        height: parent.height;
        background: Theme.border;
    }

    VerticalLayout {
        padding: 16px;
        spacing: 16px;

        HorizontalLayout {
            alignment: space-between;
            vertical-stretch: 0;

            Text {
                text: Labels.queue-title-label;
                color: Theme.text;
                font-size: 16px;
                font-weight: 700;
                vertical-alignment: center;
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                vertical-stretch: 0;

                if root.tracks.length > 0 : Rectangle {
                    min-width: 84px;
                    height: 28px;
                    border-radius: 14px;
                    background: clear-touch.pressed ? Theme.overlay : (clear-touch.has-hover ? Theme.hover : transparent);
                    animate background { duration: 150ms; easing: ease-in-out; }

                    clear-touch := TouchArea {
                        clicked => { PlaybackUi.queue-cleared(); }
                    }

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        alignment: center;

                        Text {
                            text: Labels.clear-queue-label;
                            color: Theme.accent;
                            font-size: 11px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }
                }

                Rectangle {
                    width: 28px;
                    height: 28px;
                    border-radius: 14px;
                    background: close-touch.pressed ? Theme.overlay : (close-touch.has-hover ? Theme.hover : transparent);
                    animate background { duration: 150ms; easing: ease-in-out; }

                    close-touch := TouchArea {
                        clicked => { root.close-panel(); }
                    }

                    IconClose {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        size: 16px;
                        tint: close-touch.has-hover ? Theme.text : Theme.secondary;
                    }
                }
            }
        }

        if root.tracks.length == 0 : VerticalLayout {
            vertical-stretch: 1;
            padding-top: 24px;
            alignment: center;

            Text {
                text: Labels.queue-empty-text;
                color: Theme.secondary;
                font-size: 14px;
                horizontal-alignment: center;
            }
        }

        if root.tracks.length > 0 : flick := Flickable {
            vertical-stretch: 1;

            VerticalLayout {
                spacing: 8px;
                alignment: start;

                for track in root.tracks : TrackRow {
                    title: track.title;
                    artist: track.artist;
                    album: track.album;
                    duration: track.duration;
                    kind: track.kind;
                    index: track.index;
                    surface: ContextSurface.queue;
                    cover: track.cover;
                    is-active: track.index == root.selected-index;
                    clicked => { root.track-selected(track.index); }
                }
            }
        }
    }
}
