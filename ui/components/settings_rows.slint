import { Theme } from "../theme.slint";

export component SettingsModeButton inherits Rectangle {
    in property <string> label: "";
    in property <bool> is-active: false;
    callback clicked();

    height: 40px;
    horizontal-stretch: 1;
    border-radius: 8px;
    background: root.is-active ? Theme.accent : (touch.pressed ? Theme.overlay : (touch.has-hover ? Theme.hover : Theme.surface));
    animate background { duration: 150ms; easing: ease-in-out; }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        alignment: center;

        Text {
            text: root.label;
            color: root.is-active ? Theme.window : Theme.text;
            font-size: 13px;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

export component SettingsToggleRow inherits Rectangle {
    in property <string> label: "";
    in property <string> description: "";
    in property <bool> checked: false;
    callback toggled();

    min-height: 44px;

    TouchArea {
        clicked => { root.toggled(); }
    }

    HorizontalLayout {
        alignment: space-between;

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 4px;

            Text {
                text: root.label;
                color: Theme.text;
                font-size: 13px;
            }

            if root.description != "" : Text {
                text: root.description;
                color: Theme.secondary;
                font-size: 12px;
                wrap: word-wrap;
            }
        }

        VerticalLayout {
            alignment: center;

            Rectangle {
                width: 40px;
                height: 22px;
                border-radius: 11px;
                background: root.checked ? Theme.accent : Theme.surface;
                animate background { duration: 150ms; easing: ease-in-out; }

                Rectangle {
                    width: 18px;
                    height: 18px;
                    border-radius: 9px;
                    background: root.checked ? Theme.window : Theme.secondary;
                    y: 2px;
                    x: root.checked ? 20px : 2px;
                    animate x { duration: 150ms; easing: ease-in-out; }
                }
            }
        }
    }
}
