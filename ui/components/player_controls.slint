import { Theme } from "../theme.slint";
import { Labels } from "../labels.slint";
import { ThemedSlider } from "./controls.slint";
import {
    IconNext, IconPause, IconPlay,
    IconPrev, IconRepeat, IconRepeatOne, IconShuffle,
} from "../icons.slint";

export component PlayerCenterControls inherits VerticalLayout {
    in property <bool> is-playing: false;
    in property <bool> is-shuffle: false;
    in property <int> repeat-mode: 0;
    in property <int> position-secs: 0;
    in property <int> duration-secs: 0;
    in property <string> position-text: "0:00";
    in property <string> duration-text: "0:00";
    in property <string> remaining-text: "";
    in property <bool> show-shuffle: true;
    in property <bool> show-repeat: true;
    in property <bool> show-skip-seconds: false;
    in property <bool> show-remaining-time: false;

    callback toggle-play();
    callback prev-track();
    callback next-track();
    callback seek-by(int);
    callback seek-to(int);
    callback toggle-shuffle();
    callback cycle-repeat();
    callback toggle-time-display();

    horizontal-stretch: 1;
    min-width: 240px;
    alignment: center;
    spacing: 4px;

    HorizontalLayout {
        spacing: 6px;
        alignment: center;

        if root.show-shuffle : VerticalLayout {
            alignment: center;

            Rectangle {
                width: 32px;
                height: 32px;
                border-radius: 16px;
                background: shuf-touch.pressed ? Theme.overlay : (root.is-shuffle ? Theme.surface : (shuf-touch.has-hover ? Theme.hover : transparent));
                animate background { duration: 150ms; easing: ease-in-out; }

                shuf-touch := TouchArea {
                    clicked => { root.toggle-shuffle(); }
                }

                Tooltip {
                    text: @markdown("\{Labels.shuffle-tooltip}");
                }

                IconShuffle {
                    tint: root.is-shuffle ? Theme.accent : (shuf-touch.has-hover ? Theme.text : Theme.secondary);
                    size: 16px;
                }
            }
        }

        VerticalLayout {
            alignment: center;

            Rectangle {
                width: 32px;
                height: 32px;
                border-radius: 16px;
                background: pt.pressed ? Theme.overlay : (pt.has-hover ? Theme.hover : transparent);
                animate background { duration: 150ms; easing: ease-in-out; }

                pt := TouchArea {
                    clicked => { root.prev-track(); }
                }

                Tooltip {
                    text: @markdown("\{Labels.previous-track-tooltip}");
                }

                IconPrev {
                    tint: pt.has-hover ? Theme.text : Theme.secondary;
                    size: 16px;
                }
            }
        }

        if root.show-skip-seconds : VerticalLayout {
            alignment: center;

            Rectangle {
                min-width: 32px;
                height: 26px;
                border-radius: 13px;
                background: s10m-touch.pressed ? Theme.overlay : (s10m-touch.has-hover ? Theme.hover : transparent);
                animate background { duration: 150ms; easing: ease-in-out; }

                s10m-touch := TouchArea {
                    clicked => { root.seek-by(-10); }
                }

                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    alignment: center;

                    Text {
                        text: "-10s";
                        color: s10m-touch.has-hover ? Theme.text : Theme.secondary;
                        font-size: 11px;
                        font-weight: 600;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                }
            }
        }

        VerticalLayout {
            alignment: center;

            Rectangle {
                width: 40px;
                height: 40px;
                border-radius: 20px;
                background: pp.pressed ? Theme.overlay : (pp.has-hover ? Theme.hover : Theme.accent);
                animate background { duration: 150ms; easing: ease-in-out; }

                pp := TouchArea {
                    clicked => { root.toggle-play(); }
                }

                Tooltip {
                    text: @markdown("\{root.is-playing ? Labels.pause-tooltip : Labels.play-tooltip}");
                }

                if root.is-playing : IconPause {
                    tint: pp.has-hover ? Theme.text : Theme.window;
                    size: 20px;
                }
                if !root.is-playing : IconPlay {
                    tint: pp.has-hover ? Theme.text : Theme.window;
                    size: 20px;
                }
            }
        }

        if root.show-skip-seconds : VerticalLayout {
            alignment: center;

            Rectangle {
                min-width: 32px;
                height: 26px;
                border-radius: 13px;
                background: s10p-touch.pressed ? Theme.overlay : (s10p-touch.has-hover ? Theme.hover : transparent);
                animate background { duration: 150ms; easing: ease-in-out; }

                s10p-touch := TouchArea {
                    clicked => { root.seek-by(10); }
                }

                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    alignment: center;

                    Text {
                        text: "+10s";
                        color: s10p-touch.has-hover ? Theme.text : Theme.secondary;
                        font-size: 11px;
                        font-weight: 600;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                }
            }
        }

        VerticalLayout {
            alignment: center;

            Rectangle {
                width: 32px;
                height: 32px;
                border-radius: 16px;
                background: nt.pressed ? Theme.overlay : (nt.has-hover ? Theme.hover : transparent);
                animate background { duration: 150ms; easing: ease-in-out; }

                nt := TouchArea {
                    clicked => { root.next-track(); }
                }

                Tooltip {
                    text: @markdown("\{Labels.next-track-tooltip}");
                }

                IconNext {
                    tint: nt.has-hover ? Theme.text : Theme.secondary;
                    size: 16px;
                }
            }
        }

        if root.show-repeat : VerticalLayout {
            alignment: center;

            Rectangle {
                width: 32px;
                height: 32px;
                border-radius: 16px;
                background: rep-touch.pressed ? Theme.overlay : (root.repeat-mode != 0 ? Theme.surface : (rep-touch.has-hover ? Theme.hover : transparent));
                animate background { duration: 150ms; easing: ease-in-out; }

                rep-touch := TouchArea {
                    clicked => { root.cycle-repeat(); }
                }

                Tooltip {
                    text: @markdown("\{Labels.repeat-tooltip}");
                }

                if root.repeat-mode == 2 : IconRepeatOne {
                    tint: Theme.accent;
                    size: 16px;
                }
                if root.repeat-mode != 2 : IconRepeat {
                    tint: root.repeat-mode != 0 ? Theme.accent : (rep-touch.has-hover ? Theme.text : Theme.secondary);
                    size: 16px;
                }
            }
        }
    }

    // Slint layout rule: avoid `alignment: center` on the progress layout;
    // default stretch alignment allows ThemedSlider (horizontal-stretch: 1) to expand
    // across all remaining space while timestamp labels remain pinned at the edges.
    HorizontalLayout {
        min-width: 180px;
        spacing: 8px;

        Text {
            text: root.position-text;
            color: Theme.secondary;
            font-size: 11px;
            vertical-alignment: center;
        }

        ThemedSlider {
            horizontal-stretch: 1;
            min-width: 120px;
            minimum: 0;
            maximum: max(1, root.duration-secs);
            value: root.duration-secs > 0 ? min(root.position-secs, root.duration-secs) : 0;
            enabled: root.duration-secs > 0;
            committed(val) => {
                root.seek-to(round(val));
            }
        }

        // Clickable duration label: toggles between the total duration and the time
        // remaining. Hover brightens the text and shows a subtle pill behind it.
        Rectangle {
            width: max(48px, duration-label.preferred-width + 8px);
            horizontal-stretch: 0;
            border-radius: 4px;
            background: duration-touch.has-hover ? Theme.hover : transparent;

            duration-touch := TouchArea {
                width: parent.width;
                height: parent.height;
                mouse-cursor: pointer;
                clicked => { root.toggle-time-display(); }
            }

            duration-label := Text {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                text: root.show-remaining-time && root.remaining-text != ""
                    ? root.remaining-text
                    : (root.duration-text != "" ? root.duration-text : "--:--");
                color: duration-touch.has-hover ? Theme.text : Theme.secondary;
                font-size: 11px;
                vertical-alignment: center;
            }
        }
    }
}
