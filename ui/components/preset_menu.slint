import { Theme } from "../theme.slint";

export global PresetMenuUi {
    in-out property <bool> is-open: false;
    in-out property <length> x: 0px;
    in-out property <length> y: 0px;
    in-out property <int> kind: 0;
    in-out property <int> active-index: 0;
    in-out property <string> heading: "";
    in-out property <string> status-text: "";
    in-out property <[string]> items: [];

    callback dismissed();
    callback preset-selected(int, int);
}

export component PresetMenuLayer inherits Rectangle {
    width: 100%;
    height: 100%;

    if PresetMenuUi.is-open : Rectangle {
        width: 100%;
        height: 100%;

        backdrop := TouchArea {
            pointer-event(event) => {
                if event.kind == PointerEventKind.down {
                    PresetMenuUi.dismissed();
                }
            }
        }

        panel := Rectangle {
            width: 190px;
            height: 52px + PresetMenuUi.items.length * 32px;
            x: min(max(PresetMenuUi.x + 16px - self.width / 2, 8px), parent.width - self.width - 8px);
            y: min(max(PresetMenuUi.y - self.height - 8px, 8px), parent.height - self.height - 8px);
            background: Theme.panel;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;

            VerticalLayout {
                padding: 8px;
                spacing: 2px;
                alignment: start;

                HorizontalLayout {
                    height: 24px;
                    spacing: 8px;

                    Text {
                        text: PresetMenuUi.heading;
                        color: Theme.text;
                        font-size: 13px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }

                    Text {
                        text: PresetMenuUi.status-text;
                        color: Theme.secondary;
                        font-size: 12px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }

                for label[idx] in PresetMenuUi.items : Rectangle {
                    height: 32px;
                    border-radius: 6px;
                    background: idx == PresetMenuUi.active-index
                        ? (preset-touch.pressed ? Theme.overlay : Theme.hover)
                        : (preset-touch.pressed ? Theme.overlay : (preset-touch.has-hover ? Theme.hover : transparent));
                    animate background { duration: 150ms; easing: ease-in-out; }

                    preset-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { PresetMenuUi.preset-selected(PresetMenuUi.kind, idx); }
                    }

                    Text {
                        x: 10px;
                        width: parent.width - 20px;
                        height: parent.height;
                        text: label;
                        color: idx == PresetMenuUi.active-index ? Theme.accent : Theme.text;
                        font-size: 13px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
        }
    }
}
